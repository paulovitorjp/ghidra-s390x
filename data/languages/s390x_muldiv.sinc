# s390x_muldiv.sinc — multiply/divide, single-register forms + shared macros.
# Part of the IBM z/Architecture (s390x) SLEIGH processor module.
#
# The even/odd pair-register forms (M, MFY, MR, MG, ML, MLR, MLG, MLGR,
# D, DR, DL, DLR, DLG, DLGR, DSG, DSGR, DSGF, DSGFR) are generated by
# tools/gen_muldiv.py into s390x_muldiv_gen.sinc (8 unrolled even-R1
# constructors + 1 opaque odd-R1 fallback each). This file holds the
# shared pcode macros and the single-register forms:
#   MH, MHY, MHI, MGH, MGHI, MS, MSY, MSR, MSFI,
#   MSG, MSGR, MSGF, MSGFR, MSGFI.
#
# VERIFICATION (do not weaken without re-verifying):
#   * Opcodes/formats from SA22-7832-14 Appendix A "Instructions Arranged
#     by Operation Code"; semantics from the Chapter 7 sections:
#     DIVIDE (7-290), DIVIDE LOGICAL (7-290/7-291), DIVIDE SINGLE (7-291),
#     MULTIPLY (7-345), MULTIPLY HALFWORD (7-346),
#     MULTIPLY HALFWORD IMMEDIATE (7-347), MULTIPLY LOGICAL (7-347),
#     MULTIPLY SINGLE (7-348), MULTIPLY SINGLE IMMEDIATE (7-349).
#   * Every byte pattern decoded with Capstone 5.0.7 (CS_ARCH_SYSZ);
#     see tools/validate_muldiv.py and tests/corpus_muldiv.json.
#   * Corrections vs. first draft: M/MR/MFYa multiplicand is R1+1[32:63]
#     (32-bit), NOT a 64-bit pair value (PoP 7-345); DSGF/DSGFR produce a
#     64-bit quotient/remainder from a 32-bit divisor (PoP 7-291); there
#     is no plain "MGR" instruction (only MSGR/MGRK) — the task list's
#     "MGR" is MSGR.
#
# SCOPE (deliberate omissions):
#   * MSC, MSGC, MSRKC, MSGRKC — conditional multiply (set CC, MI2
#     facility, M3 mask); belong with the conditional-select group.
#   * MGRK — RRF-a distinct-operands form; needs a new token.
#   All are decode-unimplemented, not mis-encoded.
#
# EXCEPTIONS (fixed-point-divide, PoP 7-290/7-291):
#   * The D-family raises a fixed-point-divide program exception when
#     the divisor is zero or the quotient does not fit the result
#     field. This is modeled explicitly via the trap_fixed_point_divide
#     user p-code op (callother) on the trapping path — the same idiom
#     as trap_compare_data in s390x_cond.sinc — never silently dropped.
#     On the trap path the operation is suppressed, so the macros feed
#     the callers the original dividend halves and the destination
#     registers are left unchanged.
#   * DL/DLR/DLG/DLGR get the check inside the udiv64/udiv128 macros
#     below, so every generated caller in s390x_muldiv_gen.sinc is
#     covered without touching that file.
#   * D/DR/DSG/DSGR/DSGF/DSGFR call sdiv32_exc / sdiv64_exc in the
#     generated file (tools/gen_muldiv.py emits the calls with the
#     callers' original register values as the trap-path feed-through).

# ---------------------------------------------------------------------------
# Shared macros.
# ---------------------------------------------------------------------------

# User p-code op for the fixed-point-divide exception (PoP: program
# exception, fixed-point-divide). Emitted on the divisor-zero and
# quotient-overflow paths so the trap is explicit in p-code; Ghidra
# renders it as a CALLOTHER to this userop.
define pcodeop trap_fixed_point_divide;

# Sign-extend the low 32 bits of 8-byte x into 64-bit d.
macro sx32(d, x) {
    d = (x ^ 0x80000000) - 0x80000000;
}

# Unsigned 128-bit multiply: (hi:lo) = a * b, all operands 64-bit
# unsigned patterns. Exact via 32-bit limbs; partial sums are bounded by
# the true high word, so no 64-bit wraparound occurs mid-computation.
macro mul128u(hi, lo, a, b) {
    local alo:8; local ahi:8; local blo:8; local bhi:8;
    local p0:8; local p1:8; local p2:8; local p3:8; local mid:8;
    alo = a & 0xffffffff;
    ahi = (a >> 32) & 0xffffffff;
    blo = b & 0xffffffff;
    bhi = (b >> 32) & 0xffffffff;
    p0 = alo * blo;
    p1 = alo * bhi;
    p2 = ahi * blo;
    p3 = ahi * bhi;
    mid = (p1 & 0xffffffff) + (p2 & 0xffffffff) + (p0 >> 32);
    lo = (p0 & 0xffffffff) | ((mid & 0xffffffff) << 32);
    hi = p3 + (p1 >> 32) + (p2 >> 32) + (mid >> 32);
}

# Unsigned 64-bit dividend / divisor -> 64-bit quotient/remainder.
# Restoring division; exact. A zero divisor raises the modeled
# fixed-point-divide exception (trap path below) instead of producing
# p-code's silent divide-by-zero result. A 64-bit quotient always fits,
# so no overflow check is needed here.
macro udiv64(q, r, lod, d) {
    local i:8; local bit:8; local t:8;
    local rs:8; local ds:8; local topbit:8;
    topbit = 0x80000000;
    topbit = topbit << 32;
    # Fixed-point-divide exception (PoP 7-290): divisor of zero, or the
    # 64-bit quotient does not fit the 32-bit DL/DLR quotient field,
    # i.e. (lod >> 32) >= d.  Test divisor zero first.
    if (d == 0) goto <udiv64_trap>;
    if ((lod >> 32) >= d) goto <udiv64_trap>;
    r = 0;
    q = 0;
    i = 64;
    <udiv64_loop>
    i = i - 1;
    bit = (lod >> i) & 1;
    # Compare 2*r+bit against d without 65-bit overflow: t is the bit
    # shifted out of r; if t==1 the shifted value exceeds any 64-bit d.
    t = (r >> 63) & 1;
    r = (r << 1) | bit;
    rs = r ^ topbit;
    ds = d ^ topbit;
    if (t == 1) goto <udiv64_sub>;
    if (rs < ds) goto <udiv64_nosub>;
    <udiv64_sub>
    r = r - d;
    q = q | (1 << i);
    <udiv64_nosub>
    if (i != 0) goto <udiv64_loop>;
    goto <udiv64_done>;
    <udiv64_trap>
    # Fixed-point-divide exception (cf. trap_compare_data): explicit
    # trap.  The operation is suppressed, so the DL/DLR callers' low
    # halves are restored to the original dividend halves: q feeds the
    # odd register (dvd low half), r the even register (dvd high half).
    trap_fixed_point_divide();
    q = lod & 0xffffffff;
    r = lod >> 32;
    <udiv64_done>
}

# Unsigned 128-bit dividend (hi:lo) / 64-bit divisor -> 64-bit
# quotient/remainder. Same algorithm as udiv64.
# Fixed-point-divide exception (PoP 7-290) is modeled: a zero divisor,
# or a quotient that does not fit in 64 bits (hi >= d, since
# (hi:lo)/d >= 2^64 iff hi >= d), takes the trap path below.
# NOTE: for i>=64, "1 << i" is a 64-bit shift by >= the width, which
# pcode defines as 0 (OpBehaviorIntLeft) — so no quotient bits are set
# above bit 63 on the non-trapping path.
macro udiv128(q, r, hi, lo, d) {
    local i:8; local bit:8; local t:8;
    local rs:8; local ds:8; local topbit:8;
    topbit = 0x80000000;
    topbit = topbit << 32;
    if (d == 0) goto <udiv128_trap>;
    if (hi >= d) goto <udiv128_trap>;
    r = 0;
    q = 0;
    i = 128;
    <udiv128_loop>
    i = i - 1;
    if (i < 64) goto <udiv128_lobit>;
    bit = (hi >> (i - 64)) & 1;
    goto <udiv128_havebit>;
    <udiv128_lobit>
    bit = (lo >> i) & 1;
    <udiv128_havebit>
    t = (r >> 63) & 1;
    r = (r << 1) | bit;
    rs = r ^ topbit;
    ds = d ^ topbit;
    if (t == 1) goto <udiv128_sub>;
    # XOR-topbit unsigned-order trick needs a SIGNED comparison here
    # (d is a full 64-bit value, unlike udiv64's 32-bit d).
    if (rs s< ds) goto <udiv128_nosub>;
    <udiv128_sub>
    r = r - d;
    q = q | (1 << i);
    <udiv128_nosub>
    if (i != 0) goto <udiv128_loop>;
    goto <udiv128_done>;
    <udiv128_trap>
    # Fixed-point-divide exception (cf. trap_compare_data): explicit
    # trap.  The operation is suppressed, so the DLG/DLGR callers see
    # their registers unchanged: q feeds r1 (original lo), r feeds r0
    # (original hi).
    trap_fixed_point_divide();
    q = lo;
    r = hi;
    <udiv128_done>
}

# Signed 64-bit dividend / 32-bit divisor -> 32-bit quotient/remainder
# (D, DR: dvd is the 64-bit pair value, dvs the sign-extended divisor).
# Fixed-point-divide exception (PoP 7-290): divisor of zero, or the
# quotient not fitting in a signed 32-bit field (detected by the
# sign-extension round-trip: sx32(q) != q). Drop-in replacement for the
# native `q = dvd s/ dvs; r = dvd s% dvs;` sequences (`/`/`%` are
# UNSIGNED in SLEIGH; signed division needs `s/`/`s%`). qp/rp feed the
# callers' original destination values back on the trap path (the
# operation is suppressed, so registers are preserved).
macro sdiv32_exc(q, r, dvd, dvs, qp, rp) {
    local qf:8;
    if (dvs == 0) goto <sdiv32_trap>;
    # 64-bit overflow check BEFORE the division: INT64_MIN / -1 overflows.
    if (dvd != 0x8000000000000000) goto <sdiv32_div>;
    if (dvs == 0xffffffffffffffff) goto <sdiv32_trap>;
    <sdiv32_div>
    # NOTE: SLEIGH `/` and `%` are UNSIGNED (INT_DIV/INT_REM); signed
    # division needs `s/` and `s%` (INT_SDIV/INT_SREM).
    q = dvd s/ dvs;
    r = dvd s% dvs;
    # Quotient must fit in a signed 32-bit field. sx32's xor-trick only
    # sign-extends correctly when bits 32+ are zero, so mask to the low
    # 32 bits first; without the mask a quotient like 2^32 would
    # round-trip and miss the trap.
    qf = q & 0xffffffff;
    sx32(qf, qf);
    if (qf != q) goto <sdiv32_trap>;
    goto <sdiv32_done>;
    <sdiv32_trap>
    # Fixed-point-divide exception (cf. trap_compare_data): explicit
    # trap; operation suppressed, so the callers' registers are left
    # unchanged by feeding qp/rp (their original values) back.
    trap_fixed_point_divide();
    q = qp;
    r = rp;
    <sdiv32_done>
}

# Signed 64-bit dividend / 64-bit divisor -> 64-bit quotient/remainder
# (DSG, DSGR, DSGF, DSGFR; dvs is the full 64-bit or sign-extended
# 32-bit divisor). Fixed-point-divide exception (PoP 7-290/7-291):
# divisor of zero, or the single overflow case dvd == -2^63 with
# dvs == -1 (quotient would be +2^63). Drop-in replacement for the
# native `s/` `s%` sequences (`/`/`%` are UNSIGNED in SLEIGH). qp/rp
# feed the callers' original destination values back on the trap path
# (operation suppressed).
macro sdiv64_exc(q, r, dvd, dvs, qp, rp) {
    if (dvs == 0) goto <sdiv64_trap>;
    # Overflow check BEFORE the division: the single overflow case is
    # dvd == INT64_MIN and dvs == -1 (quotient would be +2^63, not
    # expressible as a 64-bit signed integer; PoP 7-291). INT64_MIN / 1
    # is fine (quotient is INT64_MIN) and must NOT trap.
    if (dvd != 0x8000000000000000) goto <sdiv64_div>;
    if (dvs == 0xffffffffffffffff) goto <sdiv64_trap>;
    <sdiv64_div>
    # NOTE: SLEIGH `/` and `%` are UNSIGNED (INT_DIV/INT_REM); signed
    # division needs `s/` and `s%` (INT_SDIV/INT_SREM).
    q = dvd s/ dvs;
    r = dvd s% dvs;
    goto <sdiv64_done>;
    <sdiv64_trap>
    # Fixed-point-divide exception (cf. trap_compare_data): explicit
    # trap; operation suppressed, so the callers' registers are left
    # unchanged by feeding qp/rp (their original values) back.
    trap_fixed_point_divide();
    q = qp;
    r = rp;
    <sdiv64_done>
}

# ---------------------------------------------------------------------------
# MULTIPLY HALFWORD (MH, MHY, MHI): R1[32:63] = R1[32:63] * (16-bit).
# R1 bits 0-31 unchanged. CC unchanged. (PoP 7-346/7-347.)
# ---------------------------------------------------------------------------

:MH "MH " RXa_R1 "," RXa_D2 "(" RXa_X2 "," RXa_B2 ")" is RXa_OP=0x4C & RXa_R1 & RXa_X2 & RXa_B2 & RXa_D2
{
    local ea:8;
    local mc:8; local mp:8; local p:8;
    local w:2;
    ea_D12(ea, RXa_B2, RXa_X2, RXa_D2);
    w = *:2 ea;
    mp = sext(w);
    mc = RXa_R1 & 0xffffffff;
    sx32(mc, mc);
    p = mc * mp;
    RXa_R1 = (RXa_R1 & (0xFFFFFFFF << 32)) | (p & 0xffffffff);
}

:MHY "MHY " RXYa_R1 "," RXYa_DL2 "(" RXYa_X2 "," RXYa_B2 ")" is RXYa_OP=0xE3 & RXYa_R1 & RXYa_X2 & RXYa_B2 & RXYa_DL2 & RXYa_DH2 & RXYa_OP2=0x7C
{
    local ea:8;
    local mc:8; local mp:8; local p:8;
    local w:2;
    ea_D20(ea, RXYa_B2, RXYa_X2, RXYa_DH2, RXYa_DL2);
    w = *:2 ea;
    mp = sext(w);
    mc = RXYa_R1 & 0xffffffff;
    sx32(mc, mc);
    p = mc * mp;
    RXYa_R1 = (RXYa_R1 & (0xFFFFFFFF << 32)) | (p & 0xffffffff);
}

:MHI "MHI " RIa_R1 "," RIa_I2 is RIa_OP=0xA7 & RIa_R1 & RIa_OPCD=0xC & RIa_I2
{
    local mc:8; local mp:8; local p:8;
    local iw:2;
    iw = RIa_I2;
    mp = sext(iw);
    mc = RIa_R1 & 0xffffffff;
    sx32(mc, mc);
    p = mc * mp;
    RIa_R1 = (RIa_R1 & (0xFFFFFFFF << 32)) | (p & 0xffffffff);
}

# ---------------------------------------------------------------------------
# MULTIPLY HALFWORD (MGH, MGHI): R1 = R1 * (16-bit). CC unchanged.
# (PoP 7-346/7-347.)
# ---------------------------------------------------------------------------

:MGH "MGH " RXYa_R1 "," RXYa_DL2 "(" RXYa_X2 "," RXYa_B2 ")" is RXYa_OP=0xE3 & RXYa_R1 & RXYa_X2 & RXYa_B2 & RXYa_DL2 & RXYa_DH2 & RXYa_OP2=0x3C
{
    local ea:8;
    local mp:8;
    local w:2;
    ea_D20(ea, RXYa_B2, RXYa_X2, RXYa_DH2, RXYa_DL2);
    w = *:2 ea;
    mp = sext(w);
    RXYa_R1 = RXYa_R1 * mp;
}

:MGHI "MGHI " RIa_R1 "," RIa_I2 is RIa_OP=0xA7 & RIa_R1 & RIa_OPCD=0xD & RIa_I2
{
    local mp:8;
    local iw:2;
    iw = RIa_I2;
    mp = sext(iw);
    RIa_R1 = RIa_R1 * mp;
}

# ---------------------------------------------------------------------------
# MULTIPLY SINGLE, 32-bit result (MS, MSY, MSR, MSFI):
# R1[32:63] = low 32 bits of (R1[32:63] * multiplier). Bits 0-31 unchanged.
# CC unchanged. (PoP 7-348/7-349.)
# ---------------------------------------------------------------------------

:MS "MS " RXa_R1 "," RXa_D2 "(" RXa_X2 "," RXa_B2 ")" is RXa_OP=0x71 & RXa_R1 & RXa_X2 & RXa_B2 & RXa_D2
{
    local ea:8;
    local mc:8; local mp:8; local p:8;
    local w:4;
    ea_D12(ea, RXa_B2, RXa_X2, RXa_D2);
    w = *:4 ea;
    mp = sext(w);
    mc = RXa_R1 & 0xffffffff;
    sx32(mc, mc);
    p = mc * mp;
    RXa_R1 = (RXa_R1 & (0xFFFFFFFF << 32)) | (p & 0xffffffff);
}

:MSY "MSY " RXYa_R1 "," RXYa_DL2 "(" RXYa_X2 "," RXYa_B2 ")" is RXYa_OP=0xE3 & RXYa_R1 & RXYa_X2 & RXYa_B2 & RXYa_DL2 & RXYa_DH2 & RXYa_OP2=0x51
{
    local ea:8;
    local mc:8; local mp:8; local p:8;
    local w:4;
    ea_D20(ea, RXYa_B2, RXYa_X2, RXYa_DH2, RXYa_DL2);
    w = *:4 ea;
    mp = sext(w);
    mc = RXYa_R1 & 0xffffffff;
    sx32(mc, mc);
    p = mc * mp;
    RXYa_R1 = (RXYa_R1 & (0xFFFFFFFF << 32)) | (p & 0xffffffff);
}

:MSR "MSR " RRE_R1 "," RRE_R2 is RRE_OP=0xB252 & RRE_R1 & RRE_R2
{
    local mc:8; local mp:8; local p:8;
    mp = RRE_R2 & 0xffffffff;
    sx32(mp, mp);
    mc = RRE_R1 & 0xffffffff;
    sx32(mc, mc);
    p = mc * mp;
    RRE_R1 = (RRE_R1 & (0xFFFFFFFF << 32)) | (p & 0xffffffff);
}

:MSFI "MSFI " RILa_R1 "," RILa_I2 is RILa_OP=0xC2 & RILa_R1 & RILa_OPCD=0x1 & RILa_I2
{
    local mc:8; local mp:8; local p:8;
    local iw:4;
    iw = RILa_I2;
    mp = sext(iw);
    mc = RILa_R1 & 0xffffffff;
    sx32(mc, mc);
    p = mc * mp;
    RILa_R1 = (RILa_R1 & (0xFFFFFFFF << 32)) | (p & 0xffffffff);
}

# ---------------------------------------------------------------------------
# MULTIPLY SINGLE, 64-bit result (MSG, MSGR, MSGF, MSGFR, MSGFI):
# R1 = low 64 bits of (R1 * multiplier). CC unchanged. (PoP 7-348/7-349.)
# ---------------------------------------------------------------------------

:MSG "MSG " RXYa_R1 "," RXYa_DL2 "(" RXYa_X2 "," RXYa_B2 ")" is RXYa_OP=0xE3 & RXYa_R1 & RXYa_X2 & RXYa_B2 & RXYa_DL2 & RXYa_DH2 & RXYa_OP2=0x0C
{
    local ea:8;
    ea_D20(ea, RXYa_B2, RXYa_X2, RXYa_DH2, RXYa_DL2);
    RXYa_R1 = RXYa_R1 * (*:8 ea);
}

:MSGR "MSGR " RRE_R1 "," RRE_R2 is RRE_OP=0xB90C & RRE_R1 & RRE_R2
{
    RRE_R1 = RRE_R1 * RRE_R2;
}

:MSGF "MSGF " RXYa_R1 "," RXYa_DL2 "(" RXYa_X2 "," RXYa_B2 ")" is RXYa_OP=0xE3 & RXYa_R1 & RXYa_X2 & RXYa_B2 & RXYa_DL2 & RXYa_DH2 & RXYa_OP2=0x1C
{
    local ea:8;
    local mp:8;
    local w:4;
    ea_D20(ea, RXYa_B2, RXYa_X2, RXYa_DH2, RXYa_DL2);
    w = *:4 ea;
    mp = sext(w);
    RXYa_R1 = RXYa_R1 * mp;
}

:MSGFR "MSGFR " RRE_R1 "," RRE_R2 is RRE_OP=0xB91C & RRE_R1 & RRE_R2
{
    local mp:8;
    mp = RRE_R2 & 0xffffffff;
    sx32(mp, mp);
    RRE_R1 = RRE_R1 * mp;
}

:MSGFI "MSGFI " RILa_R1 "," RILa_I2 is RILa_OP=0xC2 & RILa_R1 & RILa_OPCD=0x0 & RILa_I2
{
    local mp:8;
    local iw:4;
    iw = RILa_I2;
    mp = sext(iw);
    RILa_R1 = RILa_R1 * mp;
}
