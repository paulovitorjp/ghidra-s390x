# s390x_arith.sinc — arithmetic / logical / shift / rotate / compare / TM
# constructors for the IBM z/Architecture (s390x) SLEIGH processor module.
#
# Phase 2 work. Intended to be @included by (or merged into)
# data/languages/s390x.slaspec AFTER its "Phase 2" marker. Follows
# CONVENTIONS.md exactly (UPPERCASE fields, lowercase registers,
# ea_D12/ea_D20 macros, cc register).
#
# VERIFICATION (do not weaken without re-verifying):
#   * Every opcode/format below was taken from IBM z/Architecture Principles
#     of Operation SA22-7832-14, Appendix B "Instructions Arranged by
#     Operation Code", and cross-checked against the per-instruction format
#     diagrams and "Resulting Condition Code" text in Chapter 7.
#   * Every byte pattern was additionally decoded with Capstone 5.0.7
#     (CS_ARCH_SYSZ); 69/69 vectors decode to the expected mnemonic with the
#     expected length (see /tmp/pop/validate_vectors.py).
#   * Corrections found during verification (i.e. why you must not trust
#     memory): NG/OG/XG are E3 80/81/82 (NOT E3 14/16/17); NGR/OGR/XGR are
#     B9 80/81/82 (NOT B9 14/16/17); CHI/CGHI are A7 E/F (NOT A7 D/C);
#     CHY is E3 79 (NOT E3 75); MS is 0x71 RX-a (no EB 51 collision with TMY);
#     32-bit shifts exist as RS-a (88-8B: SRL/SLL/SRA/SLA) AND as RSY-a
#     K-variants (EB DC/DD/DE/DF, distinct-operands facility, R1=dest/R3=src).
#
# DISPLAYLIMIT (cosmetic only — decode and pcode use the full fields):
#   RXY/RSY/SIY constructors print only the low 12 displacement bits
#   ($(DL2)); the high 8 bits ($(DH2)) are omitted from the listing text.
#   B2=0/X2=0 print as the pseudo-register name "zero".
# (RIa token is defined once in s390x_loadstore.sinc; do not redefine it here.)

define token SIYd(48)
    SIYd_OP = (40,47)
    SIYd_I2 = (32,39)
    SIYd_B1 = (28,31)
    SIYd_DL1 = (16,27)
    SIYd_DH1 = (8,15)
    SIYd_OP2 = (0,7)
;
attach variables [ SIYd_B1 ] [ zero r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 ];

# ---------------------------------------------------------------------------
# Condition-code helper macros.
# The 'cc' register is a byte varnode holding the condition code as a
# plain 0-3 value (no bit packing). All arithmetic macros take 8-byte
# low-order bits hold the operand/result; sa/sb/sr are 0/1 sign bits.
# ---------------------------------------------------------------------------

macro cc_set(ncc) {
    cc = ncc;
}

# Shared tail for ADD/SUBTRACT: ov (0/1), sr = result sign (0/1),
# r = result varnode (zero-test on the full varnode).
macro cc_ov_tail(r, sr, ov) {
    local ncc:1;
        if (ov != 1) goto <if_1_else>;
 ncc = 3; 
    goto <if_1_end>;
    <if_1_else>

                if (r != 0) goto <if_2_else>;
 ncc = 0; 
        goto <if_2_end>;
        <if_2_else>

                        if (sr != 1) goto <if_3_else>;
 ncc = 1; 
            goto <if_3_end>;
            <if_3_else>
 ncc = 2; 
            <if_3_end>
        
        <if_2_end>
    
    <if_1_end>
    cc_set(ncc);
}

# Signed ADD: overflow iff the operand signs agree and the result sign differs.
macro cc_add32(r, sa, sb) {
    local sr:8;
    local ov:1;
    sr = (r >> 31) & 1;
    ov = 0;
        if (sa != sb) goto <if_4_end>;

                if (sr == sa) goto <if_5_end>;
 ov = 1; 
        <if_5_end>
    
    <if_4_end>
    cc_ov_tail(r, sr, ov);
}

macro cc_add64(r, sa, sb) {
    local sr:8;
    local ov:1;
    sr = (r >> 63) & 1;
    ov = 0;
        if (sa != sb) goto <if_6_end>;

                if (sr == sa) goto <if_7_end>;
 ov = 1; 
        <if_7_end>
    
    <if_6_end>
    cc_ov_tail(r, sr, ov);
}

# Signed SUBTRACT: overflow iff the operand signs differ and the result sign
# differs from the first operand's sign.
macro cc_sub32(r, sa, sb) {
    local sr:8;
    local ov:1;
    sr = (r >> 31) & 1;
    ov = 0;
        if (sa == sb) goto <if_8_end>;

                if (sr == sa) goto <if_9_end>;
 ov = 1; 
        <if_9_end>
    
    <if_8_end>
    cc_ov_tail(r, sr, ov);
}

macro cc_sub64(r, sa, sb) {
    local sr:8;
    local ov:1;
    sr = (r >> 63) & 1;
    ov = 0;
        if (sa == sb) goto <if_10_end>;

                if (sr == sa) goto <if_11_end>;
 ov = 1; 
        <if_11_end>
    
    <if_10_end>
    cc_ov_tail(r, sr, ov);
}

# AND/OR/XOR (register and SS forms): 0 = result zero, 1 = result not zero.
macro cc_logic(r) {
    local ncc:1;
        if (r != 0) goto <if_12_else>;
 ncc = 0; 
    goto <if_12_end>;
    <if_12_else>
 ncc = 1; 
    <if_12_end>
    cc_set(ncc);
}

# Signed COMPARE: 0 = equal, 1 = first low, 2 = first high. Callers mask a/b
# to the operand width first so the unsigned '<' below is valid when signs
# are equal.
macro cc_scmp32(a, b) {
    local sa:8;
    local sb:8;
    local ncc:1;
    sa = (a >> 31) & 1;
    sb = (b >> 31) & 1;
        if (a != b) goto <if_13_else>;
 ncc = 0; 
    goto <if_13_end>;
    <if_13_else>

                if (sa != sb) goto <if_14_else>;

                        if (!(a < b)) goto <if_15_else>;
 ncc = 1; 
            goto <if_15_end>;
            <if_15_else>
 ncc = 2; 
            <if_15_end>
        
        goto <if_14_end>;
        <if_14_else>

                        if (sa != 1) goto <if_16_else>;
 ncc = 1; 
            goto <if_16_end>;
            <if_16_else>
 ncc = 2; 
            <if_16_end>
        
        <if_14_end>
    
    <if_13_end>
    cc_set(ncc);
}

macro cc_scmp64(a, b) {
    local sa:8;
    local sb:8;
    local ncc:1;
    sa = (a >> 63) & 1;
    sb = (b >> 63) & 1;
        if (a != b) goto <if_17_else>;
 ncc = 0; 
    goto <if_17_end>;
    <if_17_else>

                if (sa != sb) goto <if_18_else>;

                        if (!(a < b)) goto <if_19_else>;
 ncc = 1; 
            goto <if_19_end>;
            <if_19_else>
 ncc = 2; 
            <if_19_end>
        
        goto <if_18_end>;
        <if_18_else>

                        if (sa != 1) goto <if_20_else>;
 ncc = 1; 
            goto <if_20_end>;
            <if_20_else>
 ncc = 2; 
            <if_20_end>
        
        <if_18_end>
    
    <if_17_end>
    cc_set(ncc);
}

# Unsigned COMPARE: 0 = equal, 1 = first low, 2 = first high.
macro cc_ucmp(a, b) {
    local ncc:1;
        if (a != b) goto <if_21_else>;
 ncc = 0; 
    goto <if_21_end>;
    <if_21_else>

                if (!(a < b)) goto <if_22_else>;
 ncc = 1; 
        goto <if_22_end>;
        <if_22_else>
 ncc = 2; 
        <if_22_end>
    
    <if_21_end>
    cc_set(ncc);
}

# TEST UNDER MASK: 0 = selected bits all zero (or mask zero),
# 1 = mixed, 3 = selected bits all one.
macro cc_tm(r, mask) {
    local ncc:1;
        if (r != 0) goto <if_23_else>;
 ncc = 0; 
    goto <if_23_end>;
    <if_23_else>

                if (r != mask) goto <if_24_else>;
 ncc = 3; 
        goto <if_24_end>;
        <if_24_else>
 ncc = 1; 
        <if_24_end>
    
    <if_23_end>
    cc_set(ncc);
}

# TEST UNDER MASK HIGH/LOW, 16-bit field variant (PoP 7-460/7-461): the
# mixed case distinguishes the leftmost bit of the tested 16-bit field
# (field's MSB = leftmost bit of the register field under test):
# 0 = selected bits all zero (or mask zero),
# 1 = mixed, leftmost bit of the field is zero,
# 2 = mixed, leftmost bit of the field is one,
# 3 = selected bits all one.
# Do NOT use for the byte forms (TM/TMY): those have no CC=2.
macro cc_tm16(field, r, mask) {
    local ncc:1;
    if (r != 0) goto <tm16_else>;
 ncc = 0;
    goto <tm16_end>;
    <tm16_else>
    if (r != mask) goto <tm16_mixed>;
 ncc = 3;
    goto <tm16_end>;
    <tm16_mixed>
    if ((field & 0x8000) != 0) goto <tm16_leftone>;
 ncc = 1;
    goto <tm16_end>;
    <tm16_leftone>
 ncc = 2;
    <tm16_end>
    cc_set(ncc);
}

# ===========================================================================
# ADD, 32-bit. Result -> bits 32-63 of R1; bits 0-31 of R1 unchanged.
# CC: 0 = zero, 1 = <0, 2 = >0, 3 = overflow (PoP 7-26).
# ===========================================================================

:AR "AR " RR_R1 "," RR_R2 is RR_OP=0x1A & RR_R1 & RR_R2
{
    local a:8;
    local b:8;
    local r:8;
    a = RR_R1 & 0xffffffff;
    b = RR_R2 & 0xffffffff;
    r = (a + b) & 0xffffffff;
    RR_R1 = (RR_R1 & (0xFFFFFFFF << 32)) | r;
    cc_add32(r, (a >> 31) & 1, (b >> 31) & 1);
}

:A "A " RXa_R1 "," RXa_D2 "(" RXa_X2 "," RXa_B2 ")" is RXa_OP=0x5A & RXa_R1 & RXa_X2 & RXa_B2 & RXa_D2
{
    local ea:8;
    local m32:4;
    local a:8;
    local b:8;
    local r:8;
    ea_D12(ea, RXa_B2, RXa_X2, RXa_D2);
    m32 = *:4 ea;
    a = RXa_R1 & 0xffffffff;
    b = zext(m32);
    r = (a + b) & 0xffffffff;
    RXa_R1 = (RXa_R1 & (0xFFFFFFFF << 32)) | r;
    cc_add32(r, (a >> 31) & 1, (b >> 31) & 1);
}

:AH "AH " RXa_R1 "," RXa_D2 "(" RXa_X2 "," RXa_B2 ")" is RXa_OP=0x4A & RXa_R1 & RXa_X2 & RXa_B2 & RXa_D2
{
    local ea:8;
    local m16:2;
    local a:8;
    local b:8;
    local r:8;
    ea_D12(ea, RXa_B2, RXa_X2, RXa_D2);
    m16 = *:2 ea;
    a = RXa_R1 & 0xffffffff;
    b = sext(m16);
    r = (a + b) & 0xffffffff;
    RXa_R1 = (RXa_R1 & (0xFFFFFFFF << 32)) | r;
    cc_add32(r, (a >> 31) & 1, (b >> 31) & 1);
}

:AHY "AHY " RXYa_R1 "," RXYa_DL2 "(" RXYa_X2 "," RXYa_B2 ")" is RXYa_OP=0xE3 & RXYa_R1 & RXYa_X2 & RXYa_B2 & RXYa_DL2 & RXYa_DH2 & RXYa_OP2=0x7A
{
    local ea:8;
    local m16:2;
    local a:8;
    local b:8;
    local r:8;
    ea_D20(ea, RXYa_B2, RXYa_X2, RXYa_DH2, RXYa_DL2);
    m16 = *:2 ea;
    a = RXYa_R1 & 0xffffffff;
    b = sext(m16);
    r = (a + b) & 0xffffffff;
    RXYa_R1 = (RXYa_R1 & (0xFFFFFFFF << 32)) | r;
    cc_add32(r, (a >> 31) & 1, (b >> 31) & 1);
}

:AHI "AHI " RIa_R1 "," RIa_I2 is RIa_OP=0xA7 & RIa_R1 & RIa_OPCD=0xA & RIa_I2
{
    local a:8;
    local b:8;
    local r:8;
    a = RIa_R1 & 0xffffffff;
    local _ext_ria_i2:2;
    _ext_ria_i2 = RIa_I2;
    b = sext(_ext_ria_i2);
    r = (a + b) & 0xffffffff;
    RIa_R1 = (RIa_R1 & (0xFFFFFFFF << 32)) | r;
    cc_add32(r, (a >> 31) & 1, (b >> 31) & 1);
}

:AFI "AFI " RILa_R1 "," RILa_I2 is RILa_OP=0xC2 & RILa_R1 & RILa_OPCD=0x9 & RILa_I2
{
    local a:8;
    local b:8;
    local r:8;
    a = RILa_R1 & 0xffffffff;
    local _ext_rila_i2:4;
    _ext_rila_i2 = RILa_I2;
    b = sext(_ext_rila_i2);
    r = (a + b) & 0xffffffff;
    RILa_R1 = (RILa_R1 & (0xFFFFFFFF << 32)) | r;
    cc_add32(r, (a >> 31) & 1, (b >> 31) & 1);
}

# ===========================================================================
# ADD, 64-bit. Full-register result. CC as above (PoP 7-26).
# ===========================================================================

:AGR "AGR " RRE_R1 "," RRE_R2 is RRE_OP=0xB908 & RRE_R1 & RRE_R2
{
    local a:8;
    local b:8;
    local r:8;
    a = RRE_R1;
    b = RRE_R2;
    r = a + b;
    RRE_R1 = r;
    cc_add64(r, (a >> 63) & 1, (b >> 63) & 1);
}

:AG "AG " RXYa_R1 "," RXYa_DL2 "(" RXYa_X2 "," RXYa_B2 ")" is RXYa_OP=0xE3 & RXYa_R1 & RXYa_X2 & RXYa_B2 & RXYa_DL2 & RXYa_DH2 & RXYa_OP2=0x08
{
    local ea:8;
    local m64:8;
    local a:8;
    local b:8;
    local r:8;
    ea_D20(ea, RXYa_B2, RXYa_X2, RXYa_DH2, RXYa_DL2);
    m64 = *:8 ea;
    a = RXYa_R1;
    b = m64;
    r = a + b;
    RXYa_R1 = r;
    cc_add64(r, (a >> 63) & 1, (b >> 63) & 1);
}

:AGHI "AGHI " RIa_R1 "," RIa_I2 is RIa_OP=0xA7 & RIa_R1 & RIa_OPCD=0xB & RIa_I2
{
    local a:8;
    local b:8;
    local r:8;
    a = RIa_R1;
    local _ext_ria_i2:2;
    _ext_ria_i2 = RIa_I2;
    b = sext(_ext_ria_i2);
    r = a + b;
    RIa_R1 = r;
    cc_add64(r, (a >> 63) & 1, (b >> 63) & 1);
}

:AGFI "AGFI " RILa_R1 "," RILa_I2 is RILa_OP=0xC2 & RILa_R1 & RILa_OPCD=0x8 & RILa_I2
{
    local a:8;
    local b:8;
    local r:8;
    a = RILa_R1;
    local _ext_rila_i2:4;
    _ext_rila_i2 = RILa_I2;
    b = sext(_ext_rila_i2);
    r = a + b;
    RILa_R1 = r;
    cc_add64(r, (a >> 63) & 1, (b >> 63) & 1);
}

# ===========================================================================
# SUBTRACT, 32-bit and 64-bit. CC: 0 = zero, 1 = <0, 2 = >0, 3 = overflow
# (PoP 7-453/7-454).
# ===========================================================================

:SR "SR " RR_R1 "," RR_R2 is RR_OP=0x1B & RR_R1 & RR_R2
{
    local a:8;
    local b:8;
    local r:8;
    a = RR_R1 & 0xffffffff;
    b = RR_R2 & 0xffffffff;
    r = (a - b) & 0xffffffff;
    RR_R1 = (RR_R1 & (0xFFFFFFFF << 32)) | r;
    cc_sub32(r, (a >> 31) & 1, (b >> 31) & 1);
}

:S "S " RXa_R1 "," RXa_D2 "(" RXa_X2 "," RXa_B2 ")" is RXa_OP=0x5B & RXa_R1 & RXa_X2 & RXa_B2 & RXa_D2
{
    local ea:8;
    local m32:4;
    local a:8;
    local b:8;
    local r:8;
    ea_D12(ea, RXa_B2, RXa_X2, RXa_D2);
    m32 = *:4 ea;
    a = RXa_R1 & 0xffffffff;
    b = zext(m32);
    r = (a - b) & 0xffffffff;
    RXa_R1 = (RXa_R1 & (0xFFFFFFFF << 32)) | r;
    cc_sub32(r, (a >> 31) & 1, (b >> 31) & 1);
}

:SH "SH " RXa_R1 "," RXa_D2 "(" RXa_X2 "," RXa_B2 ")" is RXa_OP=0x4B & RXa_R1 & RXa_X2 & RXa_B2 & RXa_D2
{
    local ea:8;
    local m16:2;
    local a:8;
    local b:8;
    local r:8;
    ea_D12(ea, RXa_B2, RXa_X2, RXa_D2);
    m16 = *:2 ea;
    a = RXa_R1 & 0xffffffff;
    b = sext(m16);
    r = (a - b) & 0xffffffff;
    RXa_R1 = (RXa_R1 & (0xFFFFFFFF << 32)) | r;
    cc_sub32(r, (a >> 31) & 1, (b >> 31) & 1);
}

:SHY "SHY " RXYa_R1 "," RXYa_DL2 "(" RXYa_X2 "," RXYa_B2 ")" is RXYa_OP=0xE3 & RXYa_R1 & RXYa_X2 & RXYa_B2 & RXYa_DL2 & RXYa_DH2 & RXYa_OP2=0x7B
{
    local ea:8;
    local m16:2;
    local a:8;
    local b:8;
    local r:8;
    ea_D20(ea, RXYa_B2, RXYa_X2, RXYa_DH2, RXYa_DL2);
    m16 = *:2 ea;
    a = RXYa_R1 & 0xffffffff;
    b = sext(m16);
    r = (a - b) & 0xffffffff;
    RXYa_R1 = (RXYa_R1 & (0xFFFFFFFF << 32)) | r;
    cc_sub32(r, (a >> 31) & 1, (b >> 31) & 1);
}

:SGR "SGR " RRE_R1 "," RRE_R2 is RRE_OP=0xB909 & RRE_R1 & RRE_R2
{
    local a:8;
    local b:8;
    local r:8;
    a = RRE_R1;
    b = RRE_R2;
    r = a - b;
    RRE_R1 = r;
    cc_sub64(r, (a >> 63) & 1, (b >> 63) & 1);
}

:SG "SG " RXYa_R1 "," RXYa_DL2 "(" RXYa_X2 "," RXYa_B2 ")" is RXYa_OP=0xE3 & RXYa_R1 & RXYa_X2 & RXYa_B2 & RXYa_DL2 & RXYa_DH2 & RXYa_OP2=0x09
{
    local ea:8;
    local m64:8;
    local a:8;
    local b:8;
    local r:8;
    ea_D20(ea, RXYa_B2, RXYa_X2, RXYa_DH2, RXYa_DL2);
    m64 = *:8 ea;
    a = RXYa_R1;
    b = m64;
    r = a - b;
    RXYa_R1 = r;
    cc_sub64(r, (a >> 63) & 1, (b >> 63) & 1);
}

# ===========================================================================
# AND. CC: 0 = result zero, 1 = result not zero (PoP 7-33).
# ===========================================================================

:NR "NR " RR_R1 "," RR_R2 is RR_OP=0x14 & RR_R1 & RR_R2
{
    local r:8;
    r = (RR_R1 & RR_R2) & 0xffffffff;
    RR_R1 = (RR_R1 & (0xFFFFFFFF << 32)) | r;
    cc_logic(r);
}

:N "N " RXa_R1 "," RXa_D2 "(" RXa_X2 "," RXa_B2 ")" is RXa_OP=0x54 & RXa_R1 & RXa_X2 & RXa_B2 & RXa_D2
{
    local ea:8;
    local m32:4;
    local r:8;
    ea_D12(ea, RXa_B2, RXa_X2, RXa_D2);
    m32 = *:4 ea;
    r = (RXa_R1 & zext(m32)) & 0xffffffff;
    RXa_R1 = (RXa_R1 & (0xFFFFFFFF << 32)) | r;
    cc_logic(r);
}

:NY "NY " RXYa_R1 "," RXYa_DL2 "(" RXYa_X2 "," RXYa_B2 ")" is RXYa_OP=0xE3 & RXYa_R1 & RXYa_X2 & RXYa_B2 & RXYa_DL2 & RXYa_DH2 & RXYa_OP2=0x54
{
    local ea:8;
    local m32:4;
    local r:8;
    ea_D20(ea, RXYa_B2, RXYa_X2, RXYa_DH2, RXYa_DL2);
    m32 = *:4 ea;
    r = (RXYa_R1 & zext(m32)) & 0xffffffff;
    RXYa_R1 = (RXYa_R1 & (0xFFFFFFFF << 32)) | r;
    cc_logic(r);
}

:NGR "NGR " RRE_R1 "," RRE_R2 is RRE_OP=0xB980 & RRE_R1 & RRE_R2
{
    RRE_R1 = RRE_R1 & RRE_R2;
    cc_logic(RRE_R1);
}

:NG "NG " RXYa_R1 "," RXYa_DL2 "(" RXYa_X2 "," RXYa_B2 ")" is RXYa_OP=0xE3 & RXYa_R1 & RXYa_X2 & RXYa_B2 & RXYa_DL2 & RXYa_DH2 & RXYa_OP2=0x80
{
    local ea:8;
    local m64:8;
    ea_D20(ea, RXYa_B2, RXYa_X2, RXYa_DH2, RXYa_DL2);
    m64 = *:8 ea;
    RXYa_R1 = RXYa_R1 & m64;
    cc_logic(RXYa_R1);
}

:NI "NI " SI_D1 "(" SI_B1 ")" "," SI_I2 is SI_OP=0x94 & SI_I2 & SI_B1 & SI_D1
{
    local ea:8;
    local m1:1;
    local r:1;
    ea_D12(ea, SI_B1, zero, SI_D1);
    m1 = *:1 ea;
    r = m1 & SI_I2;
    *:1 ea = r;    cc_logic(r);
}

:NC "NC " SSa_D1 "(" SSa_L "," SSa_B1 ")" "," SSa_D2 "(" SSa_B2 ")" is SSa_OP=0xD4 & SSa_L & SSa_B1 & SSa_D1 & SSa_B2 & SSa_D2
{
    local ea1:8;
    local ea2:8;
    local len:8;
    local a:1;
    local b:1;
    local r:1;
    local allzero:1;
    local ncc:1;
    ea_D12(ea1, SSa_B1, zero, SSa_D1);
    ea_D12(ea2, SSa_B2, zero, SSa_D2);
    local _ext1_ssa_l:1; _ext1_ssa_l = SSa_L;
    len = zext(_ext1_ssa_l) + 1;
    allzero = 1;
        <loop_1_start>
    if (len == 0) goto <loop_1_end>;

    a = *:1 (ea1);
    b = *:1 (ea2);
    r = a & b;
    *:1 ea1 = r;
        if (r == 0) goto <if_25_end>;
 allzero = 0; 
    <if_25_end>
    ea1 = ea1 + 1;
    ea2 = ea2 + 1;
