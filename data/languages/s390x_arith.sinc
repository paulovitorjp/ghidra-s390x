# ===========================================================================
# ROTATE LEFT SINGLE LOGICAL (PoP 7-426). R3 = source, R1 = destination.
# CC unchanged.
# ===========================================================================

:RLL "RLL " RSYa_R1 "," RSYa_R3 "," RSYa_DL2 "(" RSYa_B2 ")" is RSYa_OP=0xEB & RSYa_R1 & RSYa_R3 & RSYa_B2 & RSYa_DL2 & RSYa_DH2 & RSYa_OP2=0x1D
{
    local sh:8;
    local amt:8;
    local a:8;
    local r:8;
    ea_D20(sh, RSYa_B2, zero, RSYa_DH2, RSYa_DL2);
    amt = (sh & 63) & 31;
    a = RSYa_R3 & 0xffffffff;
        if (amt != 0) goto <if_65_else>;

        r = a;
    
    goto <if_65_end>;
    <if_65_else>

        r = ((a << amt) | (a >> (32 - amt))) & 0xffffffff;
    
    <if_65_end>
    RSYa_R1 = (RSYa_R1 & (0xFFFFFFFF << 32)) | r;
}

:RLLG "RLLG " RSYa_R1 "," RSYa_R3 "," RSYa_DL2 "(" RSYa_B2 ")" is RSYa_OP=0xEB & RSYa_R1 & RSYa_R3 & RSYa_B2 & RSYa_DL2 & RSYa_DH2 & RSYa_OP2=0x1C
{
    local sh:8;
    local amt:8;
    local a:8;
    ea_D20(sh, RSYa_B2, zero, RSYa_DH2, RSYa_DL2);
    amt = sh & 63;
    a = RSYa_R3;
        if (amt != 0) goto <if_66_else>;

        RSYa_R1 = a;
    
    goto <if_66_end>;
    <if_66_else>

        RSYa_R1 = (a << amt) | (a >> (64 - amt));
    
    <if_66_end>
}

# ===========================================================================
# COMPARE signed. CC: 0 = equal, 1 = first low, 2 = first high (PoP 7-141).
