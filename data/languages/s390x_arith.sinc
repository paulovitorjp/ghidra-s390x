    local r:8;
    ea_D12(sh, RSa_B2, zero, RSa_D2);
    amt = sh & 63;
    a = RSa_R1 & 0xffffffff;
    r = (a << amt) & 0xffffffff;
    RSa_R1 = (RSa_R1 & (0xFFFFFFFF << 32)) | r;
}

