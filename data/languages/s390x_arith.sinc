:CLC "CLC " SSa_D1 "(" SSa_L "," SSa_B1 ")" "," SSa_D2 "(" SSa_B2 ")" is SSa_OP=0xD5 & SSa_L & SSa_B1 & SSa_D1 & SSa_B2 & SSa_D2
{
    local ea1:8;
    local ea2:8;
    local len:8;
    local a:1;
    local b:1;
    local ncc:1;
    ea_D12(ea1, SSa_B1, zero, SSa_D1);
    ea_D12(ea2, SSa_B2, zero, SSa_D2);
    local _ext6_ssa_l:1; _ext6_ssa_l = SSa_L;
    len = zext(_ext6_ssa_l) + 1;
    ncc = 0;
        <loop_4_start>
    if (len == 0) goto <loop_4_end>;

    a = *:1 (ea1);
    b = *:1 (ea2);
        if (a == b) goto <if_67_else>;

                if (!(a < b)) goto <if_68_else>;
 ncc = 1; 
        goto <if_68_end>;
        <if_68_else>
 ncc = 2; 
        <if_68_end>
        len = 0;
    
    goto <if_67_end>;
    <if_67_else>

        ea1 = ea1 + 1;
        ea2 = ea2 + 1;
        len = len - 1;
    
    <if_67_end>

    goto <loop_4_start>;
    <loop_4_end>
    cc_set(ncc);
}

# ===========================================================================
# TEST UNDER MASK (PoP 7-459). CC: 0 = selected bits all zero (or mask
# zero), 1 = mixed, 2 unused, 3 = selected bits all one.
# ===========================================================================

# TEST UNDER MASK HIGH/LOW (PoP 7-460/7-461): RI-format, opcode 0xA7.
# M3 selects the 16-bit field of R1 under test (verified against LLVM/
# Capstone SYSZ decode): 0=TMLH (bits 32-47), 1=TMLL (bits 48-63),
# 2=TMHH (bits 0-15), 3=TMHL (bits 16-31). Found missing by the
# differential fuzzer.
define token RIM(32)
    RIM_OP = (24,31)
    RIM_R1 = (20,23)
    RIM_M3 = (16,19)
    RIM_I2 = (0,15)
;
attach variables [ RIM_R1 ] [ r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 ];

:TMHH "TMHH " RIM_R1 "," RIM_I2 is RIM_OP=0xA7 & RIM_R1 & RIM_M3=0x2 & RIM_I2
{
    local f:8;
    local mask:8;
    local r:8;
    f = (RIM_R1 >> 48) & 0xffff;
    mask = RIM_I2 & 0xffff;
    r = f & mask;
    cc_tm16(f, r, mask);
}

:TMHL "TMHL " RIM_R1 "," RIM_I2 is RIM_OP=0xA7 & RIM_R1 & RIM_M3=0x3 & RIM_I2
{
    local f:8;
    local mask:8;
    local r:8;
    f = (RIM_R1 >> 32) & 0xffff;
    mask = RIM_I2 & 0xffff;
    r = f & mask;
    cc_tm16(f, r, mask);
}

:TMLH "TMLH " RIM_R1 "," RIM_I2 is RIM_OP=0xA7 & RIM_R1 & RIM_M3=0x0 & RIM_I2
{
    local f:8;
    local mask:8;
    local r:8;
    f = (RIM_R1 >> 16) & 0xffff;
    mask = RIM_I2 & 0xffff;
    r = f & mask;
    cc_tm16(f, r, mask);
}

:TMLL "TMLL " RIM_R1 "," RIM_I2 is RIM_OP=0xA7 & RIM_R1 & RIM_M3=0x1 & RIM_I2
{
    local f:8;
    local mask:8;
    local r:8;
    f = RIM_R1 & 0xffff;
    mask = RIM_I2 & 0xffff;
    r = f & mask;
    cc_tm16(f, r, mask);
}

:TM "TM " SI_D1 "(" SI_B1 ")" "," SI_I2 is SI_OP=0x91 & SI_I2 & SI_B1 & SI_D1
{
    local ea:8;
    local m1:1;
    local m:8;
    local mask:8;
    local r:8;
    ea_D12(ea, SI_B1, zero, SI_D1);
    m1 = *:1 ea;
    m = zext(m1);
    local _ext_si_i2:1;
    _ext_si_i2 = SI_I2;
    mask = zext(_ext_si_i2);
    r = m & mask;
    cc_tm(r, mask);
}

:TMY "TMY " SIYd_DL1 "(" SIYd_B1 ")" "," SIYd_I2 is SIYd_OP=0xEB & SIYd_I2 & SIYd_B1 & SIYd_DL1 & SIYd_DH1 & SIYd_OP2=0x51
{
    local ea:8;
    local m1:1;
    local m:8;
    local mask:8;
    local r:8;
    ea_D20(ea, SIYd_B1, zero, SIYd_DH1, SIYd_DL1);
    m1 = *:1 ea;
    m = zext(m1);
    local _ext_siyd_i2:1;
    _ext_siyd_i2 = SIYd_I2;
    mask = zext(_ext_siyd_i2);
    r = m & mask;
    cc_tm(r, mask);
}
