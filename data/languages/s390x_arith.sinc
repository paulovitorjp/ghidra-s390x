# ===========================================================================
# SHIFTS, 32-bit, RS-a. Bits 12-15 are ignored by hardware (left
# unconstrained). Result -> bits 32-63 of R1; bits 0-31 unchanged.
# CC: SLL/SRL unchanged; SLA 0/1/2/3; SRA 0/1/2 (PoP 7-438..7-442).
# ===========================================================================

:SLL "SLL " RSa_R1 "," RSa_D2 "(" RSa_B2 ")" is RSa_OP=0x89 & RSa_R1 & RSa_B2 & RSa_D2
{
    local sh:8;
