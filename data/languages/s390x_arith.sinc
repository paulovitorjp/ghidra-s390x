:CR "CR " RR_R1 "," RR_R2 is RR_OP=0x19 & RR_R1 & RR_R2
{
    local a:8;
    local b:8;
    a = RR_R1 & 0xffffffff;
    b = RR_R2 & 0xffffffff;
    cc_scmp32(a, b);
}

:C "C " RXa_R1 "," RXa_D2 "(" RXa_X2 "," RXa_B2 ")" is RXa_OP=0x59 & RXa_R1 & RXa_X2 & RXa_B2 & RXa_D2
