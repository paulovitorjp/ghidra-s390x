# =============================================================================
# s390x_gaps.sinc — complete-set gap fillers (51 mnemonics).
#
# Generated by tools/gen_gaps.py — do not hand-edit. Re-run the generator to
# change; hand-written sections live as Python strings in the generator.
#
# All opcodes, formats, and semantics verified against IBM z/Architecture
# Principles of Operation SA22-7832-14 (15th edition, April 2025). See the
# generator header for the opcode/format list.
#
# Inclusion: @included AFTER s390x_decimal.sinc in s390x.slaspec. Reuses:
#   tokens RR/RRE/RXa/RXYa/RSb/RSYa/RSYb/RIa/RILa/RILb (core),
#   RXs/RXl (s390x_fp.sinc), macros ea_D12/ea_D20/rel_RI32 (core),
#   RILb_Target (s390x_branch.sinc), cc_set/cc_add64/cc_sub64/cc_scmp64/
#   cc_ucmp/cc_logic (s390x_arith.sinc), registers r0-r15, f0h-f15h,
#   f0-f15, zero, cc.
#
# Conventions (inherited from the core spec):
#   - IBM bit numbering in comments is MSB=0; SLEIGH fields are LSB=0.
#   - Token fields are zero-extended into pcode expressions.
#   - Size discipline: :1 = 1 byte, :8 = 8 bytes. Cross with zext()
#     explicitly; SLEIGH rejects mixed-size operators.
#   - 32-bit register results preserve the high 32 bits of R1, matching the
#     existing arithmetic constructors.
#   - SLEIGH's `<` is signed; unsigned 64-bit compares use the sign-flip
#     trick (x ^ 0x8000000000000000) which maps unsigned order to signed.
# =============================================================================


# ---------------------------------------------------------------------------
# ADD/SUBTRACT LOGICAL condition-code helpers (PoP 7-28, 7-455).
# ---------------------------------------------------------------------------

# ADD LOGICAL, 32-bit: r/a are :8 holding masked 32-bit values (bit63=0,
# so signed `<` == unsigned `<`). Carry = wraparound = (r < a) unsigned.
macro cc_addlog32(r, a) {
    local ncc:1;
    ncc = 0;
    if (r >= a) goto <ccal32_nc>;
    ncc = 2;
<ccal32_nc>
    if (r == 0) goto <ccal32_done>;
    ncc = ncc | 1;
<ccal32_done>
    cc_set(ncc);
}

# ADD LOGICAL, 64-bit: full 64-bit operands; unsigned compare via sign-flip.
macro cc_addlog64(r, a) {
    local ncc:1;
    local rs:8;
    local as:8;
    rs = r ^ 0x8000000000000000;
    as = a ^ 0x8000000000000000;
    ncc = 0;
    if (rs >= as) goto <ccal64_nc>;
    ncc = 2;
<ccal64_nc>
    if (r == 0) goto <ccal64_done>;
    ncc = ncc | 1;
<ccal64_done>
    cc_set(ncc);
}

# SUBTRACT LOGICAL, 32-bit: carry = no borrow = (a >= b) unsigned.
macro cc_sublog32(r, a, b) {
    local ncc:1;
    ncc = 0;
    if (a < b) goto <ccsl32_nz>;
    ncc = 2;
<ccsl32_nz>
    if (r == 0) goto <ccsl32_done>;
    ncc = ncc | 1;
<ccsl32_done>
    cc_set(ncc);
}

# SUBTRACT LOGICAL, 64-bit: carry = (a >= b) unsigned via sign-flip.
macro cc_sublog64(r, a, b) {
    local ncc:1;
    local as:8;
    local bs:8;
    as = a ^ 0x8000000000000000;
    bs = b ^ 0x8000000000000000;
    ncc = 0;
    if (as < bs) goto <ccsl64_nz>;
    ncc = 2;
<ccsl64_nz>
    if (r == 0) goto <ccsl64_done>;
    ncc = ncc | 1;
<ccsl64_done>
    cc_set(ncc);
}

# LOAD AND TEST CC for a signed value: 0=zero, 1=negative, 2=positive.
# v is :8; signbit is 31 or 63.
macro cc_lttest(v, signbit) {
    local ncc:1;
    ncc = 0;
    if (v == 0) goto <cclt_done>;
    ncc = 2;
    if (((v >> signbit) & 1) == 0) goto <cclt_done>;
    ncc = 1;
<cclt_done>
    cc_set(ncc);
}


# ===========================================================================
# RR format: LPR/LNR/LTR/LCR/ALR/SLR (opcodes verified: PoP LOAD
# POSITIVE/NEGATIVE, LOAD AND TEST, LOAD COMPLEMENT, ADD/SUBTRACT LOGICAL).
# 32-bit semantics: result in bits 32-63 (SLEIGH low 32), high 32 preserved.
# ===========================================================================

# LPR: LOAD POSITIVE (32). R1[32:63] = abs(R2[32:63]).
# Overflow iff R2[32:63]==0x80000000 (result unchanged 0x80000000, CC=3).
# CC: 0=zero, 2=positive, 3=overflow (PoP 7-308).
:LPR "LPR " RR_R1 "," RR_R2 is RR_OP=0x10 & RR_R1 & RR_R2
{
    local a:8;
    local r:8;
    local ov:1;
    local ncc:1;
    a = RR_R2 & 0xffffffff;
    ov = (a == 0x80000000);
    r = a;
    if ((a & 0x80000000) == 0) goto <lpr_done>;
    r = (0 - a) & 0xffffffff;
<lpr_done>
    RR_R1 = (RR_R1 & 0xffffffff00000000) | r;
    ncc = 2;
    if (r == 0) goto <lpr_cc>;
    if (ov == 0) goto <lpr_cc>;
    ncc = 3;
    goto <lpr_cc>;
<lpr_cc>
    # ncc=2 (positive) unless r==0 or overflow; fix zero case:
    if (r != 0) goto <lpr_set>;
    ncc = 0;
    if (ov == 0) goto <lpr_set>;
    ncc = 3;
<lpr_set>
    cc_set(ncc);
}

# LNR: LOAD NEGATIVE (32). R1[32:63] = -abs(R2[32:63]).
# CC: 0=zero, 1=negative (PoP 7-309). No overflow possible.
:LNR "LNR " RR_R1 "," RR_R2 is RR_OP=0x11 & RR_R1 & RR_R2
{
    local a:8;
    local r:8;
    a = RR_R2 & 0xffffffff;
    r = a;
    if ((a & 0x80000000) != 0) goto <lnr_done>;
    r = (0 - a) & 0xffffffff;
<lnr_done>
    RR_R1 = (RR_R1 & 0xffffffff00000000) | r;
    cc_lttest(r, 31);
}

# LTR: LOAD AND TEST (32). R1[32:63] = R2[32:63].
# CC: 0=zero, 1=negative, 2=positive (PoP 7-310).
:LTR "LTR " RR_R1 "," RR_R2 is RR_OP=0x12 & RR_R1 & RR_R2
{
    local a:8;
    a = RR_R2 & 0xffffffff;
    RR_R1 = (RR_R1 & 0xffffffff00000000) | a;
    cc_lttest(a, 31);
}

# LCR: LOAD COMPLEMENT (32). R1[32:63] = -R2[32:63] (two's complement).
# Overflow iff R2[32:63]==0x80000000 (result unchanged, CC=3).
# CC: 0=zero, 1=negative, 2=positive, 3=overflow (PoP 7-174).
:LCR "LCR " RR_R1 "," RR_R2 is RR_OP=0x13 & RR_R1 & RR_R2
{
    local a:8;
    local r:8;
    local ov:1;
    a = RR_R2 & 0xffffffff;
    ov = (a == 0x80000000);
    r = (0 - a) & 0xffffffff;
    RR_R1 = (RR_R1 & 0xffffffff00000000) | r;
    if (ov == 0) goto <lcr_nov>;
    cc_set(3);
    goto <lcr_done>;
<lcr_nov>
    cc_lttest(r, 31);
<lcr_done>
}

# ALR: ADD LOGICAL (32). R1[32:63] = R1[32:63] + R2[32:63] (unsigned).
# CC: 0=zero,no carry; 1=nonzero,no carry; 2=zero,carry; 3=nonzero,carry.
:ALR "ALR " RR_R1 "," RR_R2 is RR_OP=0x1E & RR_R1 & RR_R2
{
    local a:8;
    local b:8;
    local r:8;
    a = RR_R1 & 0xffffffff;
    b = RR_R2 & 0xffffffff;
    r = (a + b) & 0xffffffff;
    RR_R1 = (RR_R1 & 0xffffffff00000000) | r;
    cc_addlog32(r, a);
}

# SLR: SUBTRACT LOGICAL (32). R1[32:63] = R1[32:63] - R2[32:63] (unsigned).
# CC encoding identical to ADD LOGICAL, carry = NOT borrow.
:SLR "SLR " RR_R1 "," RR_R2 is RR_OP=0x1F & RR_R1 & RR_R2
{
    local a:8;
    local b:8;
    local r:8;
    a = RR_R1 & 0xffffffff;
    b = RR_R2 & 0xffffffff;
    r = (a - b) & 0xffffffff;
    RR_R1 = (RR_R1 & 0xffffffff00000000) | r;
    cc_sublog32(r, a, b);
}

