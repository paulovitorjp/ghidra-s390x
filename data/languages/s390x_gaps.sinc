# ===========================================================================
# RSYa: STMY (EB/90), unrolled by (R1,R3). PoP 7-451: bits 32-63
# (SLEIGH low 32) of R1..R3 (wrapping 15->0) stored as successive
# 4-byte fields at EA. CC unchanged.
# Display prints R1/R3 as plain numbers (like gen_lmstm.py);
# tests/sleigh_diff.py maps them back to r-names for 'stmy'.
# ===========================================================================

:STMY_0_0 "STMY " "0" "," "0" "," RSYa_DL2 "(" RSYa_B2 ")" is RSYa_OP=0xEB & RSYa_R1=0 & RSYa_R3=0 & RSYa_B2 & RSYa_DL2 & RSYa_DH2 & RSYa_OP2=0x90
{
    local ea:8; local w:4;
    ea_D20(ea, RSYa_B2, zero, RSYa_DH2, RSYa_DL2);
    w = r0:4; *:4 ea = w;
}

:STMY_0_1 "STMY " "0" "," "1" "," RSYa_DL2 "(" RSYa_B2 ")" is RSYa_OP=0xEB & RSYa_R1=0 & RSYa_R3=1 & RSYa_B2 & RSYa_DL2 & RSYa_DH2 & RSYa_OP2=0x90
{
    local ea:8; local w:4;
    ea_D20(ea, RSYa_B2, zero, RSYa_DH2, RSYa_DL2);
    w = r0:4; *:4 ea = w;
    ea = ea + 4;
    w = r1:4; *:4 ea = w;
}

