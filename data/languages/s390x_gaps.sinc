# LNGR: LOAD NEGATIVE (64). R1 = -abs(R2). CC: 0=zero, 1=negative.
:LNGR "LNGR " RRE_R1 "," RRE_R2 is RRE_OP=0xB901 & RRE_R1 & RRE_R2
{
