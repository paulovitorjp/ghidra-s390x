    local n1:8; local n2:8; local pad:1; local pt:8;
    local i:8; local b:1;
    n1 = r3 & 0xffffff;
    n2 = r7 & 0xffffff;
    pt = (r7 >> 24) & 0xff;
    pad = pt[0,8];
    if (n1 != n2) goto <mvcl_2_6_c1>;
    cc = 0;
    goto <mvcl_2_6_ov>;
<mvcl_2_6_c1>
    if (n1 >= n2) goto <mvcl_2_6_c2>;
    cc = 1;
    goto <mvcl_2_6_ov>;
<mvcl_2_6_c2>
    cc = 2;
<mvcl_2_6_ov>
    if (r2 <= r6) goto <mvcl_2_6_go>;
    if (r2 >= (r6 + n2)) goto <mvcl_2_6_go>;
    cc = 3;
    goto <mvcl_2_6_end>;
<mvcl_2_6_go>
    i = 0;
<mvcl_2_6_l>
    if (i == n1) goto <mvcl_2_6_done>;
    if (i >= n2) goto <mvcl_2_6_pad>;
    b = *:1 (r6 + i);
    goto <mvcl_2_6_st>;
<mvcl_2_6_pad>
    b = pad;
<mvcl_2_6_st>
    *:1 (r2 + i) = b;
    i = i + 1;
    goto <mvcl_2_6_l>;
<mvcl_2_6_done>
    r2 = r2 + n1;
    r3 = r3 - n1;
    if (n1 >= n2) goto <mvcl_2_6_u2>;
    r6 = r6 + n1;
    r7 = r7 - n1;
    goto <mvcl_2_6_end>;
<mvcl_2_6_u2>
    r6 = r6 + n2;
    r7 = r7 - n2;
<mvcl_2_6_end>
}

