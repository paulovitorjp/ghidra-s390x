# ===========================================================================
# RXa: CVB (4F), unrolled by R1. PoP 7-266: 8-byte signed packed ->
# signed 32-bit in low half of R1 (high half unchanged). CC unchanged.
# TODO: decimal-overflow fixed-point-divide exception; data exception
# on invalid digits/signs.
# ===========================================================================

:CVB_0 "CVB r0," RXa_D2 "(" RXa_X2 "," RXa_B2 ")" is RXa_OP=0x4F & RXa_R1=0 & RXa_X2 & RXa_B2 & RXa_D2
{
    local ea:8;
    local mag:8; local v:8;
    local b:1; local s:1; local neg:1; local d:1;
    local k:8;
    ea_D12(ea, RXa_B2, RXa_X2, RXa_D2);
    mag = 0;
    k = 14;
<cvb_0_p>
    dec_digit(ea, 8, k, d);
    mag = mag * 10 + zext(d);
    if (k == 0) goto <cvb_0_sgn>;
    k = k - 1;
    goto <cvb_0_p>;
<cvb_0_sgn>
    b = *:1 (ea + 7);
    s = b & 0xf;
    neg = (s == 0xd) | (s == 0xb);
    if (neg == 0) goto <cvb_0_pos>;
    v = 0 - mag;
    goto <cvb_0_w>;
<cvb_0_pos>
    v = mag;
<cvb_0_w>
    r0 = (r0 & 0xffffffff00000000) | (v & 0xffffffff);
}

