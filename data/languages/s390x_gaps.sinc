# LCGR: LOAD COMPLEMENT (64). R1 = -R2. Overflow iff R2==min (CC=3).
# CC: 0=zero, 1=negative, 2=positive, 3=overflow.
:LCGR "LCGR " RRE_R1 "," RRE_R2 is RRE_OP=0xB903 & RRE_R1 & RRE_R2
{
    local a:8;
