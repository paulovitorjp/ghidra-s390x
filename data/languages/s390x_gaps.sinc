<mvcl_0_0_st>
    *:1 (r0 + i) = b;
    i = i + 1;
    goto <mvcl_0_0_l>;
<mvcl_0_0_done>
    r0 = r0 + n1;
    r1 = r1 - n1;
    if (n1 >= n2) goto <mvcl_0_0_u2>;
    r0 = r0 + n1;
    r1 = r1 - n1;
    goto <mvcl_0_0_end>;
<mvcl_0_0_u2>
    r0 = r0 + n2;
    r1 = r1 - n2;
<mvcl_0_0_end>
