# ALGR: ADD LOGICAL (64). R1 = R1 + R2 (unsigned). CC via cc_addlog64.
:ALGR "ALGR " RRE_R1 "," RRE_R2 is RRE_OP=0xB90A & RRE_R1 & RRE_R2
