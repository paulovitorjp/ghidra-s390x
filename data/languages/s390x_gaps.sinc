# (SLEIGH bits 32-47). CC from the 16 ANDed bits.
:NIHL "NIHL " RIa_R1 "," RIa_I2 is RIa_OP=0xA5 & RIa_R1 & RIa_OPCD=0x5 & RIa_I2
