    a = RRE_R2;
    ov = (a == 0x8000000000000000);
    r = a;
    if ((a & 0x8000000000000000) == 0) goto <lpgr_done>;
    r = 0 - a;
<lpgr_done>
    RRE_R1 = r;
    ncc = 2;
    if (r != 0) goto <lpgr_nz>;
    ncc = 0;
<lpgr_nz>
    if (ov == 0) goto <lpgr_set>;
    ncc = 3;
<lpgr_set>
