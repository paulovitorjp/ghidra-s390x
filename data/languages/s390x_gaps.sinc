# ===========================================================================
# RXa: CVD (4E), unrolled by R1. PoP 7-267: signed low 32 bits of R1 ->
# 8-byte packed decimal (15 digits + sign). CC unchanged.
# ===========================================================================

:CVD_0 "CVD r0," RXa_D2 "(" RXa_X2 "," RXa_B2 ")" is RXa_OP=0x4E & RXa_R1=0 & RXa_X2 & RXa_B2 & RXa_D2
{
    local ea:8;
    local rv:8; local v32:8; local mag:8;
    local neg:1; local sgn:1;
    local i:8; local t:8; local t8:8; local d1:1;
    ea_D12(ea, RXa_B2, RXa_X2, RXa_D2);
    rv = r0;
    v32 = rv & 0xffffffff;
    neg = (v32 >= 0x80000000);
    mag = v32;
    if (neg == 0) goto <cvd_0_go>;
    mag = (0 - mag) & 0xffffffff;
<cvd_0_go>
    sgn = 0xc | neg;
    t = mag; i = 0;
<cvd_0_s>
    if (i == 15) goto <cvd_0_end>;
    t8 = t - 10 * (t / 10);
    d1 = t8[0,8];
    dec_stdig(ea, 8, i, d1, sgn);
    t = t / 10;
    i = i + 1;
    goto <cvd_0_s>;
<cvd_0_end>
}

