# LPGR: LOAD POSITIVE (64). R1 = abs(R2). Overflow iff R2==0x8000000000000000.
# CC: 0=zero, 2=positive, 3=overflow.
:LPGR "LPGR " RRE_R1 "," RRE_R2 is RRE_OP=0xB900 & RRE_R1 & RRE_R2
{
    local a:8;
    local r:8;
