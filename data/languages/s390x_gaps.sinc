# IIHH: INSERT IMMEDIATE high-high (A5/0). Insert I2 into IBM bits 0-15
# (SLEIGH high 16). CC unchanged.
:IIHH "IIHH " RIa_R1 "," RIa_I2 is RIa_OP=0xA5 & RIa_R1 & RIa_OPCD=0x0 & RIa_I2
{
    local i2:8;
    i2 = RIa_I2 & 0xffff;
    RIa_R1 = (RIa_R1 & 0x0000ffffffffffff) | (i2 << 48);
}

# NILH: AND IMMEDIATE low-high (A5/6). AND I2 into IBM bits 32-47
# (SLEIGH bits 16-31). CC from the 16 ANDed bits: 0=zero, 1=not zero.
:NILH "NILH " RIa_R1 "," RIa_I2 is RIa_OP=0xA5 & RIa_R1 & RIa_OPCD=0x6 & RIa_I2
{
    local i2:8;
    local r:8;
    i2 = RIa_I2 & 0xffff;
    r = ((RIa_R1 >> 16) & 0xffff) & i2;
    RIa_R1 = (RIa_R1 & 0xffffffff0000ffff) | (r << 16);
    cc_logic(r);
}

