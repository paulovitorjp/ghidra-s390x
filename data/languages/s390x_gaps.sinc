    i2 = RIa_I2 & 0xffff;
    r = ((RIa_R1 >> 32) & 0xffff) & i2;
    RIa_R1 = (RIa_R1 & 0xffff0000ffffffff) | (r << 32);
    cc_logic(r);
}

# OIHH: OR IMMEDIATE high-high (A5/8). OR I2 into IBM bits 0-15
# (SLEIGH high 16). CC from the 16 ORed bits: 0=zero, 1=not zero.
:OIHH "OIHH " RIa_R1 "," RIa_I2 is RIa_OP=0xA5 & RIa_R1 & RIa_OPCD=0x8 & RIa_I2
{
    local i2:8;
    local r:8;
    i2 = RIa_I2 & 0xffff;
    r = ((RIa_R1 >> 48) & 0xffff) | i2;
    RIa_R1 = (RIa_R1 & 0x0000ffffffffffff) | (r << 48);
    cc_logic(r);
}

# OIHL: OR IMMEDIATE high-low (A5/9). OR I2 into IBM bits 16-31
# (SLEIGH bits 32-47). CC from the 16 ORed bits.
:OIHL "OIHL " RIa_R1 "," RIa_I2 is RIa_OP=0xA5 & RIa_R1 & RIa_OPCD=0x9 & RIa_I2
{
    local i2:8;
    local r:8;
    i2 = RIa_I2 & 0xffff;
    r = ((RIa_R1 >> 32) & 0xffff) | i2;
    RIa_R1 = (RIa_R1 & 0xffff0000ffffffff) | (r << 32);
    cc_logic(r);
}

# OILH: OR IMMEDIATE low-high (A5/A). OR I2 into IBM bits 32-47
# (SLEIGH bits 16-31). CC from the 16 ORed bits.
:OILH "OILH " RIa_R1 "," RIa_I2 is RIa_OP=0xA5 & RIa_R1 & RIa_OPCD=0xA & RIa_I2
{
    local i2:8;
    local r:8;
    i2 = RIa_I2 & 0xffff;
    r = ((RIa_R1 >> 16) & 0xffff) | i2;
    RIa_R1 = (RIa_R1 & 0xffffffff0000ffff) | (r << 16);
    cc_logic(r);
}

# LLIHH: LOAD LOGICAL IMMEDIATE high-high (A5/C). I2 -> IBM bits 0-15 (SLEIGH
# high 16); remaining bits zeroed. CC unchanged.
:LLIHH "LLIHH " RIa_R1 "," RIa_I2 is RIa_OP=0xA5 & RIa_R1 & RIa_OPCD=0xC & RIa_I2
{
    local i2:8;
    i2 = RIa_I2 & 0xffff;
    RIa_R1 = i2 << 48;
}

# LLIHL: LOAD LOGICAL IMMEDIATE high-low (A5/D). I2 -> IBM bits 16-31 (SLEIGH
# bits 32-47); remaining bits zeroed. CC unchanged.
:LLIHL "LLIHL " RIa_R1 "," RIa_I2 is RIa_OP=0xA5 & RIa_R1 & RIa_OPCD=0xD & RIa_I2
{
    local i2:8;
    i2 = RIa_I2 & 0xffff;
    RIa_R1 = i2 << 32;
}

# LLILH: LOAD LOGICAL IMMEDIATE low-high (A5/E). I2 -> IBM bits 32-47 (SLEIGH
# bits 16-31); remaining bits zeroed. CC unchanged.
:LLILH "LLILH " RIa_R1 "," RIa_I2 is RIa_OP=0xA5 & RIa_R1 & RIa_OPCD=0xE & RIa_I2
{
    local i2:8;
    i2 = RIa_I2 & 0xffff;
    RIa_R1 = i2 << 16;
}

# LLILL: LOAD LOGICAL IMMEDIATE low-low (A5/F). I2 -> IBM bits 48-63 (SLEIGH
# low 16); remaining bits zeroed. CC unchanged.
:LLILL "LLILL " RIa_R1 "," RIa_I2 is RIa_OP=0xA5 & RIa_R1 & RIa_OPCD=0xF & RIa_I2
{
    local i2:8;
    i2 = RIa_I2 & 0xffff;
    RIa_R1 = i2;
}

# IIHF: INSERT IMMEDIATE high-full (C0/8). Insert I2 into IBM bits 0-31
# (SLEIGH high 32). CC unchanged.
:IIHF "IIHF " RILa_R1 "," RILa_I2 is RILa_OP=0xC0 & RILa_R1 & RILa_OPCD=0x8 & RILa_I2
{
    local i2:8;
    i2 = RILa_I2 & 0xffffffff;
    RILa_R1 = (RILa_R1 & 0x00000000ffffffff) | (i2 << 32);
}

# IILF: INSERT IMMEDIATE low-full (C0/9). Insert I2 into IBM bits 32-63
# (SLEIGH low 32). CC unchanged.
:IILF "IILF " RILa_R1 "," RILa_I2 is RILa_OP=0xC0 & RILa_R1 & RILa_OPCD=0x9 & RILa_I2
{
    local i2:8;
    i2 = RILa_I2 & 0xffffffff;
    RILa_R1 = (RILa_R1 & 0xffffffff00000000) | i2;
}

# NIHF: AND IMMEDIATE high-full (C0/A). AND I2 into IBM bits 0-31
# (SLEIGH high 32). CC from the 32 ANDed bits.
:NIHF "NIHF " RILa_R1 "," RILa_I2 is RILa_OP=0xC0 & RILa_R1 & RILa_OPCD=0xA & RILa_I2
{
    local i2:8;
    local r:8;
    i2 = RILa_I2 & 0xffffffff;
    r = ((RILa_R1 >> 32) & 0xffffffff) & i2;
    RILa_R1 = (RILa_R1 & 0x00000000ffffffff) | (r << 32);
    cc_logic(r);
}

# OILF: OR IMMEDIATE low-full (C0/D). OR I2 into IBM bits 32-63
# (SLEIGH low 32). CC from the 32 ORed bits.
:OILF "OILF " RILa_R1 "," RILa_I2 is RILa_OP=0xC0 & RILa_R1 & RILa_OPCD=0xD & RILa_I2
{
    local i2:8;
    local r:8;
    i2 = RILa_I2 & 0xffffffff;
    r = (RILa_R1 & 0xffffffff) | i2;
    RILa_R1 = (RILa_R1 & 0xffffffff00000000) | r;
    cc_logic(r);
}


# ===========================================================================
# RXYa format (E3): second bytes verified against PoP Figure B-3 and the
# chapter-7 section figures. Display follows the core convention (DL2 only;
# all corpus vectors have DH2=0).
# ===========================================================================

# LTG: LOAD AND TEST (64). R1 = *(64-bit mem). CC: 0/1/2 signed (PoP 7-310).
:LTG "LTG " RXYa_R1 "," RXYa_DL2 "(" RXYa_X2 "," RXYa_B2 ")" is RXYa_OP=0xE3 & RXYa_R1 & RXYa_X2 & RXYa_B2 & RXYa_DL2 & RXYa_DH2 & RXYa_OP2=0x02
{
    local ea:8;
    local a:8;
    ea_D20(ea, RXYa_B2, RXYa_X2, RXYa_DH2, RXYa_DL2);
    a = *:8 ea;
    RXYa_R1 = a;
    cc_lttest(a, 63);
}

# ALG: ADD LOGICAL (64). R1 = R1 + *(64-bit mem) (unsigned).
:ALG "ALG " RXYa_R1 "," RXYa_DL2 "(" RXYa_X2 "," RXYa_B2 ")" is RXYa_OP=0xE3 & RXYa_R1 & RXYa_X2 & RXYa_B2 & RXYa_DL2 & RXYa_DH2 & RXYa_OP2=0x0A
{
    local ea:8;
    local a:8;
    local b:8;
    local r:8;
    ea_D20(ea, RXYa_B2, RXYa_X2, RXYa_DH2, RXYa_DL2);
    b = *:8 ea;
    a = RXYa_R1;
    r = a + b;
    RXYa_R1 = r;
    cc_addlog64(r, a);
}

# SLG: SUBTRACT LOGICAL (64). R1 = R1 - *(64-bit mem) (unsigned).
:SLG "SLG " RXYa_R1 "," RXYa_DL2 "(" RXYa_X2 "," RXYa_B2 ")" is RXYa_OP=0xE3 & RXYa_R1 & RXYa_X2 & RXYa_B2 & RXYa_DL2 & RXYa_DH2 & RXYa_OP2=0x0B
{
    local ea:8;
    local a:8;
    local b:8;
    local r:8;
    ea_D20(ea, RXYa_B2, RXYa_X2, RXYa_DH2, RXYa_DL2);
    b = *:8 ea;
    a = RXYa_R1;
    r = a - b;
    RXYa_R1 = r;
    cc_sublog64(r, a, b);
}

# LT: LOAD AND TEST (32). R1[32:63] = *(32-bit mem); high 32 preserved.
# CC: 0/1/2 from signed 32-bit value (PoP 7-310).
:LT "LT " RXYa_R1 "," RXYa_DL2 "(" RXYa_X2 "," RXYa_B2 ")" is RXYa_OP=0xE3 & RXYa_R1 & RXYa_X2 & RXYa_B2 & RXYa_DL2 & RXYa_DH2 & RXYa_OP2=0x12
{
    local ea:8;
    local m32:4;
    local a:8;
    ea_D20(ea, RXYa_B2, RXYa_X2, RXYa_DH2, RXYa_DL2);
    m32 = *:4 ea;
    a = zext(m32);
    RXYa_R1 = (RXYa_R1 & 0xffffffff00000000) | a;
    cc_lttest(a, 31);
}

# AGF: ADD (64<-32). R1 = R1 + sign_extend(*(32-bit mem)) (signed).
:AGF "AGF " RXYa_R1 "," RXYa_DL2 "(" RXYa_X2 "," RXYa_B2 ")" is RXYa_OP=0xE3 & RXYa_R1 & RXYa_X2 & RXYa_B2 & RXYa_DL2 & RXYa_DH2 & RXYa_OP2=0x18
{
    local ea:8;
    local m32:4;
    local a:8;
    local b:8;
    local r:8;
    ea_D20(ea, RXYa_B2, RXYa_X2, RXYa_DH2, RXYa_DL2);
    m32 = *:4 ea;
    b = zext(m32);
    if ((b & 0x80000000) == 0) goto <agf_pos>;
    b = b | 0xffffffff00000000;
<agf_pos>
    a = RXYa_R1;
    r = a + b;
    RXYa_R1 = r;
    cc_add64(r, (a >> 63) & 1, (b >> 63) & 1);
}

# SGF: SUBTRACT (64<-32). R1 = R1 - sign_extend(*(32-bit mem)) (signed).
:SGF "SGF " RXYa_R1 "," RXYa_DL2 "(" RXYa_X2 "," RXYa_B2 ")" is RXYa_OP=0xE3 & RXYa_R1 & RXYa_X2 & RXYa_B2 & RXYa_DL2 & RXYa_DH2 & RXYa_OP2=0x19
{
    local ea:8;
    local m32:4;
    local a:8;
    local b:8;
    local r:8;
    ea_D20(ea, RXYa_B2, RXYa_X2, RXYa_DH2, RXYa_DL2);
    m32 = *:4 ea;
    b = zext(m32);
    if ((b & 0x80000000) == 0) goto <sgf_pos>;
    b = b | 0xffffffff00000000;
<sgf_pos>
    a = RXYa_R1;
    r = a - b;
    RXYa_R1 = r;
    cc_sub64(r, (a >> 63) & 1, (b >> 63) & 1);
}

# ALGF: ADD LOGICAL (64<-32). R1 = R1 + zero_extend(*(32-bit mem)).
:ALGF "ALGF " RXYa_R1 "," RXYa_DL2 "(" RXYa_X2 "," RXYa_B2 ")" is RXYa_OP=0xE3 & RXYa_R1 & RXYa_X2 & RXYa_B2 & RXYa_DL2 & RXYa_DH2 & RXYa_OP2=0x1A
{
    local ea:8;
    local m32:4;
    local a:8;
    local b:8;
    local r:8;
    ea_D20(ea, RXYa_B2, RXYa_X2, RXYa_DH2, RXYa_DL2);
    m32 = *:4 ea;
    b = zext(m32);
    a = RXYa_R1;
    r = a + b;
    RXYa_R1 = r;
    cc_addlog64(r, a);
}

# SLGF: SUBTRACT LOGICAL (64<-32). R1 = R1 - zero_extend(*(32-bit mem)).
:SLGF "SLGF " RXYa_R1 "," RXYa_DL2 "(" RXYa_X2 "," RXYa_B2 ")" is RXYa_OP=0xE3 & RXYa_R1 & RXYa_X2 & RXYa_B2 & RXYa_DL2 & RXYa_DH2 & RXYa_OP2=0x1B
{
    local ea:8;
    local m32:4;
    local a:8;
    local b:8;
    local r:8;
    ea_D20(ea, RXYa_B2, RXYa_X2, RXYa_DH2, RXYa_DL2);
    m32 = *:4 ea;
    b = zext(m32);
    a = RXYa_R1;
    r = a - b;
    RXYa_R1 = r;
    cc_sublog64(r, a, b);
}

# CGF: COMPARE (64<-32). Signed compare R1 vs sign_extend(*(32-bit mem)).
# CC: 0=equal, 1=first low, 2=first high.
:CGF "CGF " RXYa_R1 "," RXYa_DL2 "(" RXYa_X2 "," RXYa_B2 ")" is RXYa_OP=0xE3 & RXYa_R1 & RXYa_X2 & RXYa_B2 & RXYa_DL2 & RXYa_DH2 & RXYa_OP2=0x30
{
    local ea:8;
    local m32:4;
    local b:8;
    ea_D20(ea, RXYa_B2, RXYa_X2, RXYa_DH2, RXYa_DL2);
    m32 = *:4 ea;
    b = zext(m32);
    if ((b & 0x80000000) == 0) goto <cgf_pos>;
    b = b | 0xffffffff00000000;
<cgf_pos>
    cc_scmp64(RXYa_R1, b);
}

# CLGF: COMPARE LOGICAL (64<-32). Unsigned R1 vs zero_extend(*(32-bit)).
:CLGF "CLGF " RXYa_R1 "," RXYa_DL2 "(" RXYa_X2 "," RXYa_B2 ")" is RXYa_OP=0xE3 & RXYa_R1 & RXYa_X2 & RXYa_B2 & RXYa_DL2 & RXYa_DH2 & RXYa_OP2=0x31
{
    local ea:8;
    local m32:4;
    local b:8;
    ea_D20(ea, RXYa_B2, RXYa_X2, RXYa_DH2, RXYa_DL2);
    m32 = *:4 ea;
    b = zext(m32);
    cc_ucmp(RXYa_R1, b);
}

# LTGF: LOAD AND TEST (64<-32). R1 = sign_extend(*(32-bit mem)).
# CC: 0/1/2 from signed 64-bit result (PoP 7-310).
:LTGF "LTGF " RXYa_R1 "," RXYa_DL2 "(" RXYa_X2 "," RXYa_B2 ")" is RXYa_OP=0xE3 & RXYa_R1 & RXYa_X2 & RXYa_B2 & RXYa_DL2 & RXYa_DH2 & RXYa_OP2=0x32
{
    local ea:8;
    local m32:4;
    local b:8;
    ea_D20(ea, RXYa_B2, RXYa_X2, RXYa_DH2, RXYa_DL2);
    m32 = *:4 ea;
    b = zext(m32);
    if ((b & 0x80000000) == 0) goto <ltgf_pos>;
    b = b | 0xffffffff00000000;
<ltgf_pos>
    RXYa_R1 = b;
    cc_lttest(b, 63);
}

# LGF: LOAD (64<-32). R1 = sign_extend(*(32-bit mem)). CC unchanged.
:LGF "LGF " RXYa_R1 "," RXYa_DL2 "(" RXYa_X2 "," RXYa_B2 ")" is RXYa_OP=0xE3 & RXYa_R1 & RXYa_X2 & RXYa_B2 & RXYa_DL2 & RXYa_DH2 & RXYa_OP2=0x14
{
    local ea:8;
    local m32:4;
    local b:8;
    ea_D20(ea, RXYa_B2, RXYa_X2, RXYa_DH2, RXYa_DL2);
    m32 = *:4 ea;
    b = zext(m32);
    if ((b & 0x80000000) == 0) goto <lgf_pos>;
    b = b | 0xffffffff00000000;
<lgf_pos>
    RXYa_R1 = b;
}

# LLGF: LOAD LOGICAL (64<-32). R1 = zero_extend(*(32-bit mem)). CC unchanged.
:LLGF "LLGF " RXYa_R1 "," RXYa_DL2 "(" RXYa_X2 "," RXYa_B2 ")" is RXYa_OP=0xE3 & RXYa_R1 & RXYa_X2 & RXYa_B2 & RXYa_DL2 & RXYa_DH2 & RXYa_OP2=0x16
{
    local ea:8;
    local m32:4;
    ea_D20(ea, RXYa_B2, RXYa_X2, RXYa_DH2, RXYa_DL2);
    m32 = *:4 ea;
    RXYa_R1 = zext(m32);
}

# LLGC: LOAD LOGICAL CHARACTER (E3/90). R1 = zero_extend(*(8-bit mem)).
# CC unchanged (PoP 7-318).
:LLGC "LLGC " RXYa_R1 "," RXYa_DL2 "(" RXYa_X2 "," RXYa_B2 ")" is RXYa_OP=0xE3 & RXYa_R1 & RXYa_X2 & RXYa_B2 & RXYa_DL2 & RXYa_DH2 & RXYa_OP2=0x90
{
    local ea:8;
    local m8:1;
    ea_D20(ea, RXYa_B2, RXYa_X2, RXYa_DH2, RXYa_DL2);
    m8 = *:1 ea;
    RXYa_R1 = zext(m8);
}

# LLGH: LOAD LOGICAL HALFWORD (E3/91). R1 = zero_extend(*(16-bit mem)).
# CC unchanged.
:LLGH "LLGH " RXYa_R1 "," RXYa_DL2 "(" RXYa_X2 "," RXYa_B2 ")" is RXYa_OP=0xE3 & RXYa_R1 & RXYa_X2 & RXYa_B2 & RXYa_DL2 & RXYa_DH2 & RXYa_OP2=0x91
{
    local ea:8;
    local m16:2;
    ea_D20(ea, RXYa_B2, RXYa_X2, RXYa_DH2, RXYa_DL2);
    m16 = *:2 ea;
    RXYa_R1 = zext(m16);
}


# ===========================================================================
# RILb: STRL (STORE RELATIVE LONG, C4/0F). 32-bit store to PC-relative
# address (PoP 7-450). Uses RILb_Target (from s390x_branch.sinc) so the
# display prints the absolute target like Capstone.
# ===========================================================================

:STRL "STRL " RILb_R1 "," RILb_Target is RILb_OP=0xC4 & RILb_R1 & RILb_OPCD=0xF & RILb_RI2 & RILb_Target
{
    local ea:8;
    local w:4;
    rel_RI32(ea, RILb_RI2);
    w = RILb_R1:4;
    *:4 ea = w;
}


# ===========================================================================
# RSb/RSYb: CLM (BD) / CLMY (EB/21), unrolled by 4-bit mask.
# PoP 7-172: mask bit i (MSB-first) selects IBM R1 byte 32+8*i; the
# selected bytes form a contiguous field compared left-to-right against
# storage at EA. CC: 0=equal, 1=first low, 2=first high.
# ===========================================================================

:CLM_0 "CLM " RSb_R1 "," "0" "," RSb_D2 "(" RSb_B2 ")" is RSb_OP=0xBD & RSb_R1 & RSb_M3=0 & RSb_B2 & RSb_D2
{
    local ea:8;
    local dummy:1;
    ea_D12(ea, RSb_B2, zero, RSb_D2);
    dummy = *:1 ea;
    cc_set(0);
}

:CLM_1 "CLM " RSb_R1 "," "1" "," RSb_D2 "(" RSb_B2 ")" is RSb_OP=0xBD & RSb_R1 & RSb_M3=1 & RSb_B2 & RSb_D2
{
    local ea:8;
    local cv1:8;
    local cv2:8;
    ea_D12(ea, RSb_B2, zero, RSb_D2);
    cv1 = (RSb_R1 & 0xff);
    cv2 = zext(*:1 ea);
    cc_ucmp(cv1, cv2);
}

:CLM_2 "CLM " RSb_R1 "," "2" "," RSb_D2 "(" RSb_B2 ")" is RSb_OP=0xBD & RSb_R1 & RSb_M3=2 & RSb_B2 & RSb_D2
{
    local ea:8;
    local cv1:8;
    local cv2:8;
    ea_D12(ea, RSb_B2, zero, RSb_D2);
    cv1 = ((RSb_R1 >> 8) & 0xff);
    cv2 = zext(*:1 ea);
    cc_ucmp(cv1, cv2);
}

:CLM_3 "CLM " RSb_R1 "," "3" "," RSb_D2 "(" RSb_B2 ")" is RSb_OP=0xBD & RSb_R1 & RSb_M3=3 & RSb_B2 & RSb_D2
{
    local ea:8;
    local cv1:8;
    local cv2:8;
    ea_D12(ea, RSb_B2, zero, RSb_D2);
    cv1 = (((RSb_R1 >> 8) & 0xff) << 8) | (RSb_R1 & 0xff);
    cv2 = (zext(*:1 ea) << 8) | zext(*:1 (ea + 1));
    cc_ucmp(cv1, cv2);
}

:CLM_4 "CLM " RSb_R1 "," "4" "," RSb_D2 "(" RSb_B2 ")" is RSb_OP=0xBD & RSb_R1 & RSb_M3=4 & RSb_B2 & RSb_D2
{
    local ea:8;
    local cv1:8;
    local cv2:8;
    ea_D12(ea, RSb_B2, zero, RSb_D2);
    cv1 = ((RSb_R1 >> 16) & 0xff);
    cv2 = zext(*:1 ea);
    cc_ucmp(cv1, cv2);
}

:CLM_5 "CLM " RSb_R1 "," "5" "," RSb_D2 "(" RSb_B2 ")" is RSb_OP=0xBD & RSb_R1 & RSb_M3=5 & RSb_B2 & RSb_D2
{
    local ea:8;
    local cv1:8;
    local cv2:8;
    ea_D12(ea, RSb_B2, zero, RSb_D2);
    cv1 = (((RSb_R1 >> 16) & 0xff) << 8) | (RSb_R1 & 0xff);
    cv2 = (zext(*:1 ea) << 8) | zext(*:1 (ea + 1));
    cc_ucmp(cv1, cv2);
}

:CLM_6 "CLM " RSb_R1 "," "6" "," RSb_D2 "(" RSb_B2 ")" is RSb_OP=0xBD & RSb_R1 & RSb_M3=6 & RSb_B2 & RSb_D2
{
    local ea:8;
    local cv1:8;
    local cv2:8;
    ea_D12(ea, RSb_B2, zero, RSb_D2);
    cv1 = (((RSb_R1 >> 16) & 0xff) << 8) | ((RSb_R1 >> 8) & 0xff);
    cv2 = (zext(*:1 ea) << 8) | zext(*:1 (ea + 1));
    cc_ucmp(cv1, cv2);
}

:CLM_7 "CLM " RSb_R1 "," "7" "," RSb_D2 "(" RSb_B2 ")" is RSb_OP=0xBD & RSb_R1 & RSb_M3=7 & RSb_B2 & RSb_D2
{
    local ea:8;
    local cv1:8;
    local cv2:8;
    ea_D12(ea, RSb_B2, zero, RSb_D2);
    cv1 = (((RSb_R1 >> 16) & 0xff) << 16) | (((RSb_R1 >> 8) & 0xff) << 8) | (RSb_R1 & 0xff);
    cv2 = (zext(*:1 ea) << 16) | (zext(*:1 (ea + 1)) << 8) | zext(*:1 (ea + 2));
    cc_ucmp(cv1, cv2);
}

:CLM_8 "CLM " RSb_R1 "," "8" "," RSb_D2 "(" RSb_B2 ")" is RSb_OP=0xBD & RSb_R1 & RSb_M3=8 & RSb_B2 & RSb_D2
{
    local ea:8;
    local cv1:8;
    local cv2:8;
    ea_D12(ea, RSb_B2, zero, RSb_D2);
    cv1 = ((RSb_R1 >> 24) & 0xff);
    cv2 = zext(*:1 ea);
    cc_ucmp(cv1, cv2);
}

:CLM_9 "CLM " RSb_R1 "," "9" "," RSb_D2 "(" RSb_B2 ")" is RSb_OP=0xBD & RSb_R1 & RSb_M3=9 & RSb_B2 & RSb_D2
{
    local ea:8;
    local cv1:8;
