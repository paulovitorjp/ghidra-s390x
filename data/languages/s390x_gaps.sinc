# LTGR: LOAD AND TEST (64). R1 = R2. CC: 0=zero, 1=negative, 2=positive.
:LTGR "LTGR " RRE_R1 "," RRE_R2 is RRE_OP=0xB902 & RRE_R1 & RRE_R2
{
