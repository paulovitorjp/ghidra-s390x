# ===========================================================================
# LOAD HALFWORD IMMEDIATE ON CONDITION (RIE-g). PoP 7-315.
# LOCHI EC42: sign-extended I2 -> bits 32-63 of R1 (low 32).
# LOCGHI EC46: sign-extended I2 -> bits 0-63 of R1 (all 64).
# LOCHHI EC4E: sign-extended I2 -> bits 0-31 of R1 (high 32).
# CC unchanged. (There is no LOCFHI; LOCHHI is the high-half form.)
# ===========================================================================
# LOCHI: sign-extended I2 into low 32 bits.
:LOCHIO "LOCHIO " RIEg_R1 "," RIEg_I2 is RIEg_OP=0xEC & RIEg_R1 & RIEg_M3=1 & RIEg_I2 & RIEg_IGN & RIEg_OP2=0x42
{
    local _ext_rieg_i2:2;
    local w:4;
    local _c_m:1;
    local _c_ccval:1;
    local _c_bit:1;
    _ext_rieg_i2 = RIEg_I2;
    w = sext(_ext_rieg_i2);
    _c_m = 1;
    _c_ccval = cc;
    _c_bit = 8 >> _c_ccval;
    if ((_c_m & _c_bit) != 0) goto <c_do>;
    goto <c_done>;
<c_do>
    RIEg_R1 = (RIEg_R1 & (0xFFFFFFFF << 32)) | zext(w);
<c_done>
}

:LOCHIH "LOCHIH " RIEg_R1 "," RIEg_I2 is RIEg_OP=0xEC & RIEg_R1 & RIEg_M3=2 & RIEg_I2 & RIEg_IGN & RIEg_OP2=0x42
{
    local _ext_rieg_i2:2;
    local w:4;
    local _c_m:1;
    local _c_ccval:1;
    local _c_bit:1;
    _ext_rieg_i2 = RIEg_I2;
    w = sext(_ext_rieg_i2);
