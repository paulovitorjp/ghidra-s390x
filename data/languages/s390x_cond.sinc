# ===========================================================================
# s390x_cond.sinc — conditional integer tails: load/store-on-condition,
# SELECT, compare-and-trap, load-and-trap, MVCIN, MVPG, LFPC.
#
# Reference: IBM z/Architecture Principles of Operation SA22-7832-14.
# Bit-numbering convention (CONVENTIONS.md): PoP Figure 5-1 numbers bits
# with bit 0 = MSB; SLEIGH numbers bit 0 = LSB, so every PoP range (s,e) on
# an N-bit token is written here as (N-1-e, N-1-s).
#
# Condition-code mask convention (PoP 7-315, 7-326): the M3/M4 field is a
# 4-bit mask; CC values 0/1/2/3 correspond to mask bits 8/4/2/1. The
# existing 'cc' byte register holds the CC as a plain 0-3 value, so
#   ccval = cc;  bit = 8 >> ccval;  matched = (mask & bit) != 0
# (same idiom as s390x_branch.sinc).
#
# CORRECTION to the original task text: for load/store-on-condition, M3=0
# does NOT mean unconditional. PoP 7-326: M3=0 matches no CC value, so the
# instruction is a NOP (destination unchanged); M3=15 matches every CC
# value, so the move/store is unconditional. Implemented as stated in PoP.
#
# Display conventions: one constructor per (mnemonic, mask) encoding — two
# constructors must never share an encoding (SLEIGH disassembly takes the
# first match, and the differential harness requires a unique decode).
# Where Capstone folds a mask to a suffix, the constructor uses Capstone's
# spelling so the Capstone-generated corpus matches directly. IBM
# Appendix J synonyms with no Capstone counterpart (LOCRP, LOCRM, LOCRNZ,
# LOCRZ, LOCRNM, LOCRNP and the SELECT equivalents) are NOT separate
# constructors; the base-mnemonic+mask form covers those encodings.
# Compare-style vs arithmetic-style: Capstone folds load-on-condition
# masks 3/5/6/9/10/12 as NLE/NHE/LH/NLH/HE/LE (IBM J-1 defines no
# extended mnemonic for those masks); both spellings from the union are
# implemented. For compare-and-trap mask 6/10/12 Capstone uses LH/HE/LE
# where IBM J-1 uses NE/NL/NH — Capstone's spelling is implemented since
# the corpus is Capstone-generated.
#
# Compare-and-trap / load-and-trap: the data exception (DXC FF) is modeled
# explicitly via the trap_compare_data user p-code op (callother) on the
# mask-match path — never silently dropped. The comparison itself sets CC
# (0=equal, 1=low, 2=high) like the corresponding COMPARE instruction.
#
# SELECT (SELR/SELGR/SELFHR): Capstone 5.0.7 does not decode these at all;
# implemented from PoP with IBM J-1 extended mnemonics; corpus vectors are
# decode-only (expected_len, no Capstone mnemonic).
#
# MVPG (B254, RRE) is privileged (special-operation exception, DAT,
# storage keys) and is decode-only, like the existing TRAP2/TRAP4 stubs.
# ===========================================================================

# User p-code op for the compare-and-trap / load-and-trap data exception
# (PoP: compare-and-trap-instruction data exception, DXC FF). Emitted on
# the mask-match path so the trap is explicit in p-code; Ghidra renders it
# as a CALLOTHER to this userop.
define pcodeop trap_compare_data;

# RRF-a: 4 bytes. OP(0-15), R3(16-19), M4(20-23), R1(24-27), R2(28-31).
# Used by SELECT. M4 stays numeric (condition mask).
define token RRFa(32)
    RRFa_OP = (16,31)
    RRFa_R3 = (12,15)
    RRFa_M4 = (8,11)
    RRFa_R1 = (4,7)
    RRFa_R2 = (0,3)
;
attach variables [ RRFa_R3 ] [ r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 ];
attach variables [ RRFa_R1 ] [ r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 ];
attach variables [ RRFa_R2 ] [ r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 ];

# RIE-a: 6 bytes. OP(0-7), R1(8-11), ignored(12-15), I2(16-31),
# M3(32-35), ignored(36-39), OP2(40-47). Used by CIT/CGIT/CLFIT/CLGIT.
define token RIEa(48)
    RIEa_OP = (40,47)
    RIEa_R1 = (36,39)
    RIEa_IGN1 = (32,35)
    RIEa_I2 = (16,31)
    RIEa_M3 = (12,15)
    RIEa_IGN2 = (8,11)
    RIEa_OP2 = (0,7)
;
attach variables [ RIEa_R1 ] [ r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 ];

# RIE-g: 6 bytes. OP(0-7), R1(8-11), M3(12-15), I2(16-31),
# ignored(32-39), OP2(40-47). Used by LOCHI/LOCGHI/LOCHHI.
define token RIEg(48)
    RIEg_OP = (40,47)
    RIEg_R1 = (36,39)
    RIEg_M3 = (32,35)
    RIEg_I2 = (16,31)
    RIEg_IGN = (8,15)
    RIEg_OP2 = (0,7)
;
attach variables [ RIEg_R1 ] [ r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 ];

# ===========================================================================
# LOAD ON CONDITION, register forms (RRF-c). PoP 7-315.
# LOCR B9F2 (32<-32, low half), LOCGR B9E2 (64<-64), LOCFHR B9E0 (32<-32,
# high half). CC unchanged. M3=0: NOP; M3=15: unconditional (PoP 7-326).
# ===========================================================================
# LOCR: low 32 bits.
:LOCRO "LOCRO " RRFc_R1 "," RRFc_R2 is RRFc_OP=0xB9F2 & RRFc_M3=1 & RRFc_R1 & RRFc_R2
{
    local _c_m:1;
    local _c_ccval:1;
    local _c_bit:1;
    _c_m = 1;
    _c_ccval = cc;
    _c_bit = 8 >> _c_ccval;
    if ((_c_m & _c_bit) != 0) goto <c_do>;
    goto <c_done>;
<c_do>
    RRFc_R1 = (RRFc_R1 & (0xFFFFFFFF << 32)) | (RRFc_R2 & 0xFFFFFFFF);
<c_done>
}

