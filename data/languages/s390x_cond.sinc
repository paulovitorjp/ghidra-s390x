# ===========================================================================
# COMPARE AND TRAP, register forms (RRF-c). PoP 7-169.
# CRT B972 (signed 32), CLRT B973 (unsigned 32), CGRT B960 (signed 64),
# CLGRT B961 (unsigned 64). Comparison sets CC (0=equal,1=low,2=high); if
# the M3 bit for that result is one, the compare-and-trap data exception
# (DXC FF) is recognized — modeled explicitly via trap_compare_data().
# M3 bit 3 is reserved; only bits 0-2 participate in the trap test.
# ===========================================================================
# CRT: cc_scmp32, 32-bit operands.
:CRTH "CRTH " RRFc_R1 "," RRFc_R2 is RRFc_OP=0xB972 & RRFc_M3=2 & RRFc_R1 & RRFc_R2
{
    local a:8;
    local b:8;
    local _t_ccval:1;
    local _t_bit:1;
    a = RRFc_R1 & 0xffffffff;
    b = RRFc_R2 & 0xffffffff;
    cc_scmp32(a, b);
    _t_ccval = cc;
    _t_bit = 4 >> _t_ccval;
    if ((2 & _t_bit) != 0) goto <trap_fire>;
    goto <trap_done>;
<trap_fire>
    trap_compare_data();
<trap_done>
}

