# ===========================================================================
# LOAD AND TRAP (RXY-a). PoP 7-309. The second operand is placed unchanged
# at the first-operand location; if all zeros are placed there, a
# compare-and-trap-instruction data exception is recognized (DXC FF) —
# modeled explicitly via trap_compare_data(). CC unchanged.
# LAT E39F: 32-bit -> bits 32-63 of R1 (low half), bits 0-31 unchanged.
# LGAT E385: 64-bit -> all of R1.
# LLGFAT E39D: 32-bit -> bits 32-63 of R1, zeros in bits 0-31.
# LLGTAT E39C: bits 1-31 of the word -> bits 33-63 of R1, zeros in 0-32.
# LFHAT E3C8: 32-bit -> bits 0-31 of R1 (high half), bits 32-63 unchanged.
# ===========================================================================
:LAT "LAT " RXYa_R1 "," RXYa_DL2 "(" RXYa_X2 "," RXYa_B2 ")" is RXYa_OP=0xE3 & RXYa_R1 & RXYa_X2 & RXYa_B2 & RXYa_DL2 & RXYa_DH2 & RXYa_OP2=0x9F
{
    local ea:8;
    local w:4;
    ea_D20(ea, RXYa_B2, RXYa_X2, RXYa_DH2, RXYa_DL2);
    w = *:4 ea;
    RXYa_R1 = (RXYa_R1 & (0xFFFFFFFF << 32)) | zext(w);
    if ((w) == 0) goto <lat_trap>;
    goto <lat_done>;
<lat_trap>
    trap_compare_data();
<lat_done>
}

:LGAT "LGAT " RXYa_R1 "," RXYa_DL2 "(" RXYa_X2 "," RXYa_B2 ")" is RXYa_OP=0xE3 & RXYa_R1 & RXYa_X2 & RXYa_B2 & RXYa_DL2 & RXYa_DH2 & RXYa_OP2=0x85
{
    local ea:8;
    ea_D20(ea, RXYa_B2, RXYa_X2, RXYa_DH2, RXYa_DL2);
    RXYa_R1 = *:8 ea;
    if ((RXYa_R1) == 0) goto <lat_trap>;
    goto <lat_done>;
<lat_trap>
    trap_compare_data();
<lat_done>
}

:LLGFAT "LLGFAT " RXYa_R1 "," RXYa_DL2 "(" RXYa_X2 "," RXYa_B2 ")" is RXYa_OP=0xE3 & RXYa_R1 & RXYa_X2 & RXYa_B2 & RXYa_DL2 & RXYa_DH2 & RXYa_OP2=0x9D
{
    local ea:8;
    local w:4;
    ea_D20(ea, RXYa_B2, RXYa_X2, RXYa_DH2, RXYa_DL2);
    w = *:4 ea;
    RXYa_R1 = zext(w);
    if ((w) == 0) goto <lat_trap>;
    goto <lat_done>;
<lat_trap>
    trap_compare_data();
<lat_done>
}

:LLGTAT "LLGTAT " RXYa_R1 "," RXYa_DL2 "(" RXYa_X2 "," RXYa_B2 ")" is RXYa_OP=0xE3 & RXYa_R1 & RXYa_X2 & RXYa_B2 & RXYa_DL2 & RXYa_DH2 & RXYa_OP2=0x9C
{
    local ea:8;
    local w:4;
    ea_D20(ea, RXYa_B2, RXYa_X2, RXYa_DH2, RXYa_DL2);
    w = *:4 ea;
    RXYa_R1 = zext(w) & 0x7fffffff;
    if ((w & 0x7fffffff) == 0) goto <lat_trap>;
    goto <lat_done>;
<lat_trap>
    trap_compare_data();
<lat_done>
}

:LFHAT "LFHAT " RXYa_R1 "," RXYa_DL2 "(" RXYa_X2 "," RXYa_B2 ")" is RXYa_OP=0xE3 & RXYa_R1 & RXYa_X2 & RXYa_B2 & RXYa_DL2 & RXYa_DH2 & RXYa_OP2=0xC8
{
    local ea:8;
    local w:4;
    ea_D20(ea, RXYa_B2, RXYa_X2, RXYa_DH2, RXYa_DL2);
    w = *:4 ea;
    RXYa_R1 = (RXYa_R1 & 0xFFFFFFFF) | (zext(w) << 32);
    if ((w) == 0) goto <lat_trap>;
    goto <lat_done>;
<lat_trap>
    trap_compare_data();
<lat_done>
}

# ===========================================================================
# MOVE INVERSE (MVCIN), SS-a, opcode E8. PoP 7-330: the second operand is
# placed at the first-operand location with the left-to-right order
# inverted (byte-reversed copy of L+1 bytes). The result is obtained as if
# the second operand were processed right to left and the first operand
# left to right. Overlapping by more than one byte => unpredictable.
# CC unchanged. Loop follows the NC (s390x_arith.sinc) counted-loop idiom.
# Harness note: display prints the raw L field (length-1); the harness
# adds 1 for the 'mvcin' mnemonic (SS_LEN_MNEMS), like mvc/xc/nc/oc/clc.
# ===========================================================================
:MVCIN "MVCIN " SSa_D1 "(" SSa_L "," SSa_B1 ")," SSa_D2 "(" SSa_B2 ")" is SSa_OP=0xE8 & SSa_L & SSa_B1 & SSa_D1 & SSa_B2 & SSa_D2
{
    local ea1:8;
    local ea2:8;
    local len:8;
    local b:1;
    local _ext_mvcin_l:1;
    ea_D12(ea1, SSa_B1, zero, SSa_D1);
    ea_D12(ea2, SSa_B2, zero, SSa_D2);
    _ext_mvcin_l = SSa_L;
    # Second operand processed right-to-left: start at its last byte.
    ea2 = ea2 + zext(_ext_mvcin_l);
    len = zext(_ext_mvcin_l) + 1;
    <mcv_loop>
    if (len == 0) goto <mcv_done>;
    b = *:1 (ea2);
    *:1 ea1 = b;
    ea1 = ea1 + 1;
    ea2 = ea2 - 1;
    len = len - 1;
    goto <mcv_loop>;
    <mcv_done>
}

# ===========================================================================
# MOVE PAGE (MVPG), RRE, opcode B254 — decode-only. PoP 10-x: privileged
# (special-operation exception in problem state; DAT and storage-key
# controlled) 4 KiB page copy. Cannot be modeled honestly in p-code.
# ===========================================================================
:MVPG "MVPG " RRE_R1 "," RRE_R2 is RRE_OP=0xB254 & RRE_R1 & RRE_R2
{
}

# ===========================================================================
# LOAD FPC (LFPC), S format, opcode B29D. PoP 9-31: the 4-byte second
# operand in storage is placed into the FPC (floating-point-control)
# register. CC unchanged. (LFAS, the signaling variant, is not covered.)
# ===========================================================================
:LFPC "LFPC " S_D2 "(" S_B2 ")" is S_OP=0xB29D & S_B2 & S_D2
{
    local ea:8;
    ea_D12(ea, S_B2, zero, S_D2);
    fpc = *:4 ea;
}

