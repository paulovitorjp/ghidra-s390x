# ===========================================================================
# LOAD/STORE ON CONDITION, storage forms (RSY-b, 20-bit displacement).
# PoP 7-315 (load), 7-452 (store). Display order follows Capstone/HLASM:
# the mask is the LAST operand: LOC R1,D2(B2),M3 / STOC R1,D2(B2),M3.
# ===========================================================================
# LOC: 32-bit, low half (load).
:LOCO "LOCO " RSYb_R1 "," RSYb_DL2 "(" RSYb_B2 ")" is RSYb_OP=0xEB & RSYb_R1 & RSYb_M3=1 & RSYb_B2 & RSYb_DL2 & RSYb_DH2 & RSYb_OP2=0xF2
{
    local ea:8;
    local w:4;
    local _c_m:1;
    local _c_ccval:1;
    local _c_bit:1;
    ea_D20(ea, RSYb_B2, zero, RSYb_DH2, RSYb_DL2);
    _c_m = 1;
    _c_ccval = cc;
    _c_bit = 8 >> _c_ccval;
    if ((_c_m & _c_bit) != 0) goto <c_do>;
    goto <c_done>;
<c_do>
    w = *:4 ea;
    RSYb_R1 = (RSYb_R1 & (0xFFFFFFFF << 32)) | zext(w);
<c_done>
}

