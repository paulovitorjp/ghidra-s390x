# ===========================================================================
# COMPARE (LOGICAL) IMMEDIATE AND TRAP (RIE-a). PoP 7-169.
# CIT EC72 (signed 32; I2 sign-extended), CGIT EC70 (signed 64; I2
# sign-extended), CLFIT EC73 (unsigned 32; I2 zero-extended), CLGIT EC71
# (unsigned 64; I2 zero-extended). CC set from the comparison; the
# compare-and-trap data exception is modeled via trap_compare_data().
# ===========================================================================
# CIT: cc_scmp32, I2 sext-extended.
:CITH "CITH " RIEa_R1 "," RIEa_I2 is RIEa_OP=0xEC & RIEa_R1 & RIEa_IGN1 & RIEa_I2 & RIEa_M3=2 & RIEa_IGN2 & RIEa_OP2=0x72
{
    local a:8;
    local b:8;
    local _ext_riea_i2:2;
    local _t_ccval:1;
    local _t_bit:1;
    _ext_riea_i2 = RIEa_I2;
    a = RIEa_R1 & 0xffffffff;
    b = sext(_ext_riea_i2) & 0xffffffff;
    cc_scmp32(a, b);
    _t_ccval = cc;
    _t_bit = 4 >> _t_ccval;
    if ((2 & _t_bit) != 0) goto <trap_fire>;
    goto <trap_done>;
<trap_fire>
    trap_compare_data();
<trap_done>
}

