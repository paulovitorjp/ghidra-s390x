# ===========================================================================
# SELECT (RRF-a). PoP 7-401. R1 = M4-matched ? R2 : R3. CC unchanged.
# SELR B9F0 (32-bit, low halves), SELGR B9E3 (64-bit), SELFHR B9C0
# (32-bit, high halves). Extended mnemonics from IBM Appendix J (the
# arithmetic set O/H/L/NE/E/NL/NH/NO); Capstone 5.0.7 cannot decode these
# instructions, so the corpus vectors are decode-only.
# ===========================================================================
# SELR: 32-bit, low halves.
:SELRO "SELRO " RRFa_R1 "," RRFa_R2 "," RRFa_R3 is RRFa_OP=0xB9F0 & RRFa_R3 & RRFa_M4=1 & RRFa_R1 & RRFa_R2
{
    local _s_ccval:1;
    local _s_bit:1;
    _s_ccval = cc;
    _s_bit = 8 >> _s_ccval;
    if ((1 & _s_bit) != 0) goto <sel_r2>;
    RRFa_R1 = (RRFa_R1 & (0xFFFFFFFF << 32)) | (RRFa_R3 & 0xFFFFFFFF);
    goto <sel_done>;
<sel_r2>
    RRFa_R1 = (RRFa_R1 & (0xFFFFFFFF << 32)) | (RRFa_R2 & 0xFFFFFFFF);
<sel_done>
}

