<sel_r2>
    RRFa_R1 = RRFa_R2;
<sel_done>
}

# SELFHR: 32-bit, high halves.
:SELFHRO "SELFHRO " RRFa_R1 "," RRFa_R2 "," RRFa_R3 is RRFa_OP=0xB9C0 & RRFa_R3 & RRFa_M4=1 & RRFa_R1 & RRFa_R2
{
    local _s_ccval:1;
    local _s_bit:1;
    _s_ccval = cc;
    _s_bit = 8 >> _s_ccval;
    if ((1 & _s_bit) != 0) goto <sel_r2>;
    RRFa_R1 = (RRFa_R1 & 0xFFFFFFFF) | (RRFa_R3 & (0xFFFFFFFF << 32));
    goto <sel_done>;
<sel_r2>
    RRFa_R1 = (RRFa_R1 & 0xFFFFFFFF) | (RRFa_R2 & (0xFFFFFFFF << 32));
<sel_done>
}

