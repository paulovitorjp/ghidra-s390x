# ===========================================================================
# COMPARE LOGICAL AND TRAP, storage forms (RSY-b). PoP 7-169.
# CLT EB23 (unsigned 32), CLGT EB2B (unsigned 64). HLASM/Capstone order:
# the mask is the SECOND operand: CLT R1,M3,D2(B2).
# ===========================================================================
# CLT: unsigned 32-bit compare against storage operand.
:CLTH "CLTH " RSYb_R1 "," RSYb_DL2 "(" RSYb_B2 ")" is RSYb_OP=0xEB & RSYb_R1 & RSYb_M3=2 & RSYb_B2 & RSYb_DL2 & RSYb_DH2 & RSYb_OP2=0x23
{
    local ea:8;
    local a:8;
    local b:8;
    local _t_ccval:1;
    local _t_bit:1;
    ea_D20(ea, RSYb_B2, zero, RSYb_DH2, RSYb_DL2);
    a = RSYb_R1 & 0xffffffff;
    b = zext(*:4 ea);
    cc_ucmp(a, b);
    _t_ccval = cc;
    _t_bit = 4 >> _t_ccval;
    if ((2 & _t_bit) != 0) goto <trap_fire>;
    goto <trap_done>;
<trap_fire>
    trap_compare_data();
<trap_done>
}

