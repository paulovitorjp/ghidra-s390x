<?xml version="1.0" encoding="UTF-8"?>
<!-- s390x.cspec - SIMPLIFIED default calling convention for the Linux s390x
     ABI (ELF Application Binary Interface s390x Supplement, IBM).
     Phase 1 scope: integer/pointer arguments only.
     Assumptions (to be refined in a later phase):
       * Integer/pointer args 1-5 arrive in r2..r6; further args on the stack.
       * Integer/pointer return value in r2.
       * r14 is the link/return-address register (BALR/BRASL target register
         by convention); Phase 2 constructors should emit explicit
         "return r14" semantics.
       * r15 is the stack pointer and is preserved.
       * Callee-saved (unaffected): r6-r13, f8-f15. (r6 doubles as the 5th
         argument register; the callee must still restore it.)
       * Stack-passed arguments start at offset 160 from the stack pointer
         (the 160-byte register save area mandated by the ABI).
       * OMITTED in this simple proto: floating-point args (f0,f2,f4,f6),
         vector args (v24-v31), vector return (v24), _Float16/_Decimal and
         struct-return conventions. Add as separate prototypes if needed.
     Data sizes follow LP64: long and pointers are 8 bytes; long double is
     the 16-byte IBM extended format; wchar_t is 4 bytes. -->
<compiler_spec>

  <data_organization>
    <absolute_max_alignment value="16"/>
    <machine_alignment value="8"/>
    <default_alignment value="1"/>
    <default_pointer_alignment value="8"/>
    <pointer_size value="8"/>
    <wchar_size value="4"/>
    <short_size value="2"/>
    <integer_size value="4"/>
    <long_size value="8"/>
    <long_long_size value="8"/>
    <float_size value="4"/>
    <double_size value="8"/>
    <long_double_size value="16"/>
    <size_alignment_map>
      <entry size="1" alignment="1"/>
      <entry size="2" alignment="2"/>
      <entry size="4" alignment="4"/>
      <entry size="8" alignment="8"/>
      <entry size="16" alignment="8"/>
    </size_alignment_map>
  </data_organization>

  <stackpointer register="r15" space="ram"/>

  <returnaddress>
    <register name="r14"/>
  </returnaddress>

  <global>
    <range space="ram"/>
  </global>

  <default_proto>
    <prototype name="default" extrapop="unknown" stackshift="0">
      <input>
        <pentry minsize="1" maxsize="8">
          <register name="r2"/>
        </pentry>
        <pentry minsize="1" maxsize="8">
          <register name="r3"/>
        </pentry>
        <pentry minsize="1" maxsize="8">
          <register name="r4"/>
        </pentry>
        <pentry minsize="1" maxsize="8">
          <register name="r5"/>
        </pentry>
        <pentry minsize="1" maxsize="8">
          <register name="r6"/>
        </pentry>
        <pentry minsize="1" maxsize="800" align="8">
          <addr offset="160" space="stack"/>
        </pentry>
      </input>
      <output>
        <pentry minsize="1" maxsize="8">
          <register name="r2"/>
        </pentry>
      </output>
      <unaffected>
        <register name="r6"/>
        <register name="r7"/>
        <register name="r8"/>
        <register name="r9"/>
        <register name="r10"/>
        <register name="r11"/>
        <register name="r12"/>
        <register name="r13"/>
        <register name="f8"/>
        <register name="f9"/>
        <register name="f10"/>
        <register name="f11"/>
        <register name="f12"/>
        <register name="f13"/>
        <register name="f14"/>
        <register name="f15"/>
        <register name="r15"/>
      </unaffected>
    </prototype>
  </default_proto>

</compiler_spec>
