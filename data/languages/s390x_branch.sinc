# s390x_branch.sinc — Branch / control-flow instruction constructors (Phase 2a)
#
# This file is textually included into s390x.slaspec at merge time
# (append below its "Phase 2" marker or @include it). It shares the
# define-section tokens, registers, attachments, and macros of
# s390x.slaspec; the extra tokens/macros it needs are defined here.
#
# References: IBM z/Architecture Principles of Operation SA22-7832-14
# (15th ed., Apr 2025). EVERY opcode below was verified against the
# PoP's instruction summaries (Ch. 7 / 10) and opcode tables
# (App. A); the public mirror https://kib.kiev.ua/x86docs/Z/Z/SA22-7832-14.pdf
# was used. Cross-checked against Capstone 5.0.7 (CS_ARCH_SYSZ).
#
# Conventions: see CONVENTIONS.md. Constructor names are lowercase;
# every constructor carries an explicit [...] display section in HLASM
# operand order.
#
# IMPORTANT ASSUMPTIONS (for the merge/sleighc phase to confirm):
#  1. Overlapping constructors (base mnemonic vs. fixed-mask extended
#     mnemonics, e.g. :bcr vs. :br) rely on SLEIGH's most-specific-
#     pattern-wins disambiguation (the x86 NOP/XCHG precedent). As a
#     belt-and-braces measure, the more specific constructors are listed
#     FIRST within each family, so first-match-wins would also resolve
#     correctly. BRC/BRCL use 16/10 disjoint mask-specific constructors
#     (plus the generic :brcl fallback for masks without an extended
#     mnemonic) so no base-vs-extended overlap remains there.
#  2. Base/index fields with value 0 attach to the 'zero' pseudo-
#     register (Phase 1 convention), so e.g. `lpsw 0(zero)` displays when
#     B1=0. Cosmetic only; pcode semantics are correct.
#  3. `return;` (bare, unknown target) for PROGRAM RETURN and comment-
#     only `{ }` blocks for opaque stubs (SVC/TRAP/DIAGNOSE/EX) need a
#     real sleighc pass to confirm they are accepted.
#  4. Relative-branch targets display as the raw signed halfword offset
#     (e.g. `brc 15,-4`); the true absolute target lives in the pcode
#     (goto/call), which is what Ghidra's analysis consumes.

# ---------------------------------------------------------------------------
# Extra tokens
# ---------------------------------------------------------------------------

# RRb: RR-format variant with a mask (M1) in place of R1. Used by
# BRANCH ON CONDITION. (The PoP lists BCR's format as plain "RR"; the
# 'b' suffix marks the mask variant, per the <FORMAT><variant> convention.)
define token RRb(16)
    RRb_OP = (8,15)
    RRb_M1 = (4,7)
    RRb_R2 = (0,3)
    RRb_R2n = (0,3)
;
attach variables [ RRb_R2 ] [ r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 ];
# RRb_R2n intentionally unattached: numeric shadow of the R2 field for
# pattern constraints (the R2-FIELD-zero rule and the return-idiom split
# must test the field value, not the register contents).

# RIb: 4-byte RI format, R1 variant (BRANCH RELATIVE AND SAVE).
# PoP Figure 5-1: OP(0-7), R1(8-11), OP2(12-15), RI2(16-31, signed).
define token RIb(32)
    RIb_OP = (24,31)
    RIb_R1 = (20,23)
    RIb_OP2 = (16,19)
    RIb_RI2 = (0,15) signed
;
attach variables [ RIb_R1 ] [ r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 ];

# RIc: 4-byte RI format, mask variant (BRANCH RELATIVE ON CONDITION).
define token RIc(32)
    RIc_OP = (24,31)
    RIc_M1 = (20,23)
    RIc_OP2 = (16,19)
    RIc_RI2 = (0,15) signed
;

# I: 2-byte format of SUPERVISOR CALL (the PoP's format name is "I"):
# OP(0-7), I(8-15) interruption-code byte.
define token I(16)
    I_OP = (8,15)
    I_I = (0,7)
;

# ---------------------------------------------------------------------------
# Extra macros
# ---------------------------------------------------------------------------

# PC-relative target for 16-bit halfword-counted offsets (RI-b/c RI2):
# target = inst_start + 2 * sign_extend_16(RI).
# (PoP 7-47: the signed halfword count "is added to the address of the
# instruction".)
macro rel_RI16(dest, RI) {
    # Sign-extend 16-bit RI to 64 bits: (x ^ 0x8000) - 0x8000
    dest = RI;
    dest = (dest ^ 0x8000) - 0x8000;
    dest = inst_start + dest * 2;
}

# Conditional branch to a caller-computed target TGT (a varnode): taken
# iff the mask bit selected by the current condition code is 1.
# Mask bit for CC=i has value 8>>i (PoP 7-47); the 'cc' byte register
# holds the condition code as a plain 0-3 value (see s390x.slaspec).

# Conditional branch to the address in register R: as branch_cond, plus
# the RR-format rule that R=0 performs no branch (PoP 7-41: "when the R2
# field ... contains zero, the branch instruction is equivalent to a
# no-operation"). R=0 arrives as the 'zero' pseudo-register via the
# Phase 1 field attachments, so the != 0 test is a plain value compare.

# ---------------------------------------------------------------------------
# BRANCH ON CONDITION family (RRb token, opcode 0x07; PoP 7-41)
# Extended mnemonics are the PoP Appendix J recommended set.
# ---------------------------------------------------------------------------

:nopr "nopr " RRb_R2 is RRb_OP=0x07 & RRb_M1=0x0 & RRb_R2
{
    # BCR with mask 0 never branches; falls through. (PoP J-1.)
}

:bor "bor " RRb_R2 is RRb_OP=0x07 & RRb_M1=0x1 & RRb_R2 & RRb_R2n
{
    # BCR mask=1: branch to the address in R2 iff the mask bit for the
    # current condition code is 1 (mask bit for CC=i is 8>>i, PoP 7-47) AND
    # the R2 field is nonzero (R2=0 is an architectural no-op, PoP 7-41
    # note 3). RRb_R2n is the numeric shadow of the R2 field, so the != 0
    # test is on the field value, not the register contents. The 'cc'
    # register holds the condition code as a plain 0-3 value.
    local _b_m:1;
    local _b_ccval:1;
    local _b_bit:1;
    local _b_r2n:1;
    _b_m = 0x1;
    _b_ccval = cc;
    _b_bit = 8 >> _b_ccval;
    _b_r2n = RRb_R2n;
    if (((_b_m & _b_bit) != 0) && (_b_r2n != 0)) goto RRb_R2;
}

:bhr "bhr " RRb_R2 is RRb_OP=0x07 & RRb_M1=0x2 & RRb_R2 & RRb_R2n
{
    # BCR mask=2: branch to the address in R2 iff the mask bit for the
    # current condition code is 1 (mask bit for CC=i is 8>>i, PoP 7-47) AND
    # the R2 field is nonzero (R2=0 is an architectural no-op, PoP 7-41
    # note 3). RRb_R2n is the numeric shadow of the R2 field, so the != 0
    # test is on the field value, not the register contents. The 'cc'
    # register holds the condition code as a plain 0-3 value.
    local _b_m:1;
    local _b_ccval:1;
    local _b_bit:1;
    local _b_r2n:1;
    _b_m = 0x2;
    _b_ccval = cc;
    _b_bit = 8 >> _b_ccval;
    _b_r2n = RRb_R2n;
    if (((_b_m & _b_bit) != 0) && (_b_r2n != 0)) goto RRb_R2;
}

