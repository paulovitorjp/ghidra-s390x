# ---------------------------------------------------------------------------
# Subroutine-linkage branches. The link (updated instruction address,
# i.e. inst_next) is stored first; the branch is always taken for the
# relative/RX forms. pcode uses 'call' so the decompiler builds the
# call graph. (PoP 7-36/7-37/7-47; in 64-bit mode the link is the full
# 64-bit updated instruction address.)
# ---------------------------------------------------------------------------

:bras "bras " RIb_R1 "," RIb_Target is RIb_OP=0xA7 & RIb_R1 & RIb_OP2=0x5 & RIb_Target
{
    # PoP 7-47: the link is stored even when RIb_R1 designates r0, and the
    # branch is always taken.
    RIb_R1 = inst_next;
    call RIb_Target;
}

:brasl "brasl " RILb_R1 "," RILb_Target is RILb_OP=0xC0 & RILb_R1 & RILb_OPCD=0x5 & RILb_Target
{
    # As BRAS, with the 32-bit relative offset (PoP 7-47).
    RILb_R1 = inst_next;
    call RILb_Target;
}

:basr "basr " RR_R1 "," RR_R2 is RR_OP=0x0D & RR_R1 & RR_R2
{
    # PoP 7-37: link always stored; when RR_R2=0 no branch occurs.
    RR_R1 = inst_next;
    if (RR_R2 == 0) goto <call_skip_1>;
    call RR_R2;
    <call_skip_1>
}

:balr "balr " RR_R1 "," RR_R2 is RR_OP=0x05 & RR_R1 & RR_R2
{
    # PoP 7-36: as BASR (compatibility instruction; prefer BASR/BRASL).
    RR_R1 = inst_next;
    if (RR_R2 == 0) goto <call_skip_2>;
    call RR_R2;
    <call_skip_2>
}

:bal "bal " RXa_R1 "," RXa_D2 "(" RXa_X2 "," RXa_B2 ")" is RXa_OP=0x45 & RXa_R1 & RXa_X2 & RXa_B2 & RXa_D2
{
    # PoP 7-36: the branch address (EA) is computed BEFORE RXa_R1 is changed.
    # In 64-bit mode the link is the full updated instruction address;
    # the legacy 24/31-bit link layout does not apply.
    local ea:8;
    ea_D12(ea, RXa_B2, RXa_X2, RXa_D2);
    RXa_R1 = inst_next;
    call [ea];
}

:bas "bas " RXa_R1 "," RXa_D2 "(" RXa_X2 "," RXa_B2 ")" is RXa_OP=0x4D & RXa_R1 & RXa_X2 & RXa_B2 & RXa_D2
{
    # PoP 7-37: as BAL, without the legacy link-format baggage.
    local ea:8;
    ea_D12(ea, RXa_B2, RXa_X2, RXa_D2);
    RXa_R1 = inst_next;
    call [ea];
}

:bakr "bakr " RRE_R1 "," RRE_R2 is RRE_OP=0xB240 & RRE_IGN & RRE_R1 & RRE_R2
{
    # TODO: BAKR pushes a branch-state entry (PSW, registers, return
    # address) onto the linkage stack (PoP 10-11); the stack manipulation
    # is not modeled. RRE_R1 only selects return-address formation for the
    # stacked entry, so no link register is written here. When RRE_R2=0 no
    # branch occurs.
    if (RRE_R2 == 0) goto <call_skip_3>;
    call RRE_R2;
    <call_skip_3>
}

:pr "pr" is E_OP=0x01 & E_OP2=0x01
{
    # TODO(verify): PROGRAM RETURN unstacks the linkage stack (PoP 10-112);
    # the return target is not statically known. Pcode empty: control flow
    # target cannot be expressed.
}

# ---------------------------------------------------------------------------
# Supervisor call / traps: opaque by design (targets are OS- and
# machine-dependent). They fall through; no control-flow pcode is emitted.
# ---------------------------------------------------------------------------

:svc "svc " I_I is I_OP=0x0A & I_I
{
    # SUPERVISOR CALL (PoP 7-457): raises a supervisor-call interruption;
    # the I_I field becomes the low byte of the interruption code. The
    # handler, its effects, and whether it returns are OS-dependent
    # (Linux/s390x uses SVC 0 as its system-call gateway), so this is
    # deliberately opaque.
    # TODO: model Linux s390x syscalls (SVC 0, number in r1) as calls.
}

:trap2 "trap2" is E_OP=0x01 & E_OP2=0xFF
{
    # TRAP2 (PoP 10-189): traps depending on control-register bits;
    # not statically analyzable. Opaque by design.
}

:trap4 "trap4" is S_OP=0xB2FF & S_B2 & S_D2
{
    # TRAP4 (PoP 10-189): the second-operand address is not used by the
    # instruction (operands left unconstrained). Otherwise as TRAP2.
}

# ---------------------------------------------------------------------------
# Privileged PSW / system-mask instructions. Implemented with simple,
# honest register semantics; serialization, addressing/protection checks,
# and PSW-validity specification checks are NOT modeled (marked
# TODO(privileged)). These never appear in problem-state (user) code.
# ---------------------------------------------------------------------------

:lpsw "lpsw " SI_D1 "(" SI_B1 ")" is SI_OP=0x82 & SI_I2 & SI_B1 & SI_D1
{
    # TODO(privileged): see header above.
    # PoP 10-56: the doubleword at the EA forms a 16-byte PSW. Bits 8-15
    # of the instruction are reserved (left unconstrained here).
    #   dw bits 0-11, 13-32 -> PSW bits 0-11, 13-32
    #   ~dw bit 12          -> PSW bit 12
    #   PSW bits 33-96      -> 0
    #   dw bits 33-63       -> PSW bits 97-127
    # (The condition code comes along inside the new PSW via the
    # overlapping 'cc' register.)
    local ea:8;
    local dw:8;
    local hi:8;
    local lo:8;
    ea_D12(ea, SI_B1, zero, SI_D1);
    dw = *(ea);
    hi = (dw & (0xFFF00000 << 32)) | ((~dw) & (0x80000 << 32)) | (dw & ((0x7FFFF << 32) | 0x80000000));
    lo = dw & 0x7FFFFFFF;
    psw = (zext(hi) << 64) | zext(lo);
}

:lpswe "lpswe " S_D2 "(" S_B2 ")" is S_OP=0xB2B2 & S_B2 & S_D2
{
    # TODO(privileged): see header above.
    # PoP 10-57: the quadword at the EA replaces the full 16-byte PSW.
    local ea:8;
    ea_D12(ea, S_B2, zero, S_D2);
    psw = *(ea);
}

:ssm "ssm " SI_D1 "(" SI_B1 ")" is SI_OP=0x80 & SI_I2 & SI_B1 & SI_D1
{
    # TODO(privileged): the PSW-validity specification check (PoP 10-145)
    # is not modeled. Bits 8-15 of the instruction are reserved.
    # PoP 10-145: PSW bits 0-7 := byte at second-operand address.
    local ea:8;
    local b:1;
    ea_D12(ea, SI_B1, zero, SI_D1);
    b = *(ea);
    pswm = (pswm & ((0xFFFFFF << 32) | 0xFFFFFFFF)) | (zext(b) << 56);
}

:stnsm "stnsm " SI_D1 "(" SI_B1 ")," SI_I2 is SI_OP=0xAC & SI_I2 & SI_B1 & SI_D1
{
    local ea:8;
    ea_D12(ea, SI_B1, zero, SI_D1);
    # Simplified: system-mask store. Full PSW interaction omitted for compilation.
    *:1 ea = 0;
}

:stosm "stosm " SI_D1 "(" SI_B1 ")," SI_I2 is SI_OP=0xAD & SI_I2 & SI_B1 & SI_D1
{
    local ea:8;
    ea_D12(ea, SI_B1, zero, SI_D1);
    # Simplified: system-mask store. Full PSW interaction omitted for compilation.
    *:1 ea = 0;
}

:diagnose "diag " RSa_R1 "," RSa_R3 "," RSa_D2 "(" RSa_B2 ")" is RSa_OP=0x83 & RSa_R1 & RSa_R3 & RSa_B2 & RSa_D2
{
    # DIAGNOSE (PoP 10-24): model-dependent function. Bits 8-31 "may be
    # used as in the SI or RS formats, or in some other way"; displayed
    # RS-style to match common tooling (Capstone/LLVM do the same).
    # Semantics deliberately not modeled.
}

:ex "ex " RXa_R1 "," RXa_D2 "(" RXa_X2 "," RXa_B2 ")" is RXa_OP=0x44 & RXa_R1 & RXa_X2 & RXa_B2 & RXa_D2
{
    # TODO: EXECUTE runs the target instruction with bits 56-63 of RXa_R1
    # ORed into its second byte (PoP 7-294). Fully dynamic; deliberately
    # not modeled. Do NOT treat the target as a branch.
}
