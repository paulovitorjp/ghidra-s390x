:br_ret "br " RRb_R2 is RRb_OP=0x07 & RRb_M1=0xF & RRb_R2 & RRb_R2n=14
{
    # br %r14: the s390x return idiom. r14 is the link register declared
    # as <returnaddress> in s390x.cspec, so emit an explicit return and
    # the decompiler recognizes function returns (ARM "bx lr" and MIPS
    # "jr ra" precedent). NOT a blanket return: computed jumps such as
    # br %r1 (switch tables) stay indirect gotos in :br below.
    return [RRb_R2];
}

:br "br " RRb_R2 is RRb_OP=0x07 & RRb_M1=0xF & RRb_R2 & RRb_R2n != 0 & RRb_R2n != 14
{
    # BCR mask=15: unconditional branch to the address in R2 (PoP 7-41,
    # programming note 3). The condition is on the mask FIELD (=15), not
    # on the register value — the old "if (RRb_R2 != 0)" p-code tested
    # the register contents, which is wrong.
    goto RRb_R2;
}

:br_nop "br " RRb_R2 is RRb_OP=0x07 & RRb_M1=0xF & RRb_R2 & RRb_R2n=0
{
    # R2 field = 0: BCR is a no-operation (PoP 7-41, note 3). Falls through.
}

:bcr "bcr " RRb_M1 "," RRb_R2 is RRb_OP=0x07 & RRb_M1 & RRb_R2 & RRb_R2n
{
    # BCR mask=M1: branch to the address in R2 iff the mask bit for the
    # current condition code is 1 (mask bit for CC=i is 8>>i, PoP 7-47) AND
    # the R2 field is nonzero (R2=0 is an architectural no-op, PoP 7-41
    # note 3). RRb_R2n is the numeric shadow of the R2 field, so the != 0
    # test is on the field value, not the register contents. The 'cc'
    # register holds the condition code as a plain 0-3 value.
    local _b_m:1;
    local _b_ccval:1;
    local _b_bit:1;
    local _b_r2n:1;
    _b_m = RRb_M1;
    _b_ccval = cc;
    _b_bit = 8 >> _b_ccval;
    _b_r2n = RRb_R2n;
    if (((_b_m & _b_bit) != 0) && (_b_r2n != 0)) goto RRb_R2;
}

# ---------------------------------------------------------------------------
# BRANCH RELATIVE ON CONDITION family (RIc token, opcode 0xA7, OP2=0x4;
# PoP 7-47). Extended mnemonics are the PoP Appendix J recommended set.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# PC-relative target subtables for BRC/BRCL.
# Each computes the absolute target address (inst_start + 2*sign_extend(RI))
# at decode time, so branches can emit a direct CBRANCH/BRANCH (not BRANCHIND)
# to a constant address. The operand is created from the display (print-state
# SYMBOLSTRING) and linked to the subtable via the pattern (selfDefine).
# Display shows the absolute target (Capstone-compatible).
# ---------------------------------------------------------------------------
RIc_TargetLoc: tgt is RIc_RI2 [ tgt = inst_start + RIc_RI2 * 2; ] { export *[const]:8 tgt; }
RIc_Target: RIc_TargetLoc is RIc_TargetLoc { export *:8 RIc_TargetLoc; }
RILc_TargetLoc: tgt is RILc_RI2 [ tgt = inst_start + RILc_RI2 * 2; ] { export *[const]:8 tgt; }
RILc_Target: RILc_TargetLoc is RILc_TargetLoc { export *:8 RILc_TargetLoc; }
RIb_TargetLoc: tgt is RIb_RI2 [ tgt = inst_start + RIb_RI2 * 2; ] { export *[const]:8 tgt; }
RIb_Target: RIb_TargetLoc is RIb_TargetLoc { export *:8 RIb_TargetLoc; }
RILb_TargetLoc: tgt is RILb_RI2 [ tgt = inst_start + RILb_RI2 * 2; ] { export *[const]:8 tgt; }
RILb_Target: RILb_TargetLoc is RILb_TargetLoc { export *:8 RILb_TargetLoc; }

:jnop "jnop " RIc_RI2 is RIc_OP=0xA7 & RIc_M1=0x0 & RIc_OP2=0x4 & RIc_RI2
{
    # BRC with mask 0 never branches; falls through. (PoP J-1.)
}

:jo "jo " RIc_Target is RIc_OP=0xA7 & RIc_M1=0x1 & RIc_OP2=0x4 & RIc_Target
{
    local _b_m:1;
    local _b_ccval:1;
    local _b_bit:1;
    _b_m = 0x1;
    _b_ccval = cc;
    _b_bit = 8 >> _b_ccval;
    if ((_b_m & _b_bit) != 0) goto RIc_Target;
}

:jh "jh " RIc_Target is RIc_OP=0xA7 & RIc_M1=0x2 & RIc_OP2=0x4 & RIc_Target
{
    local _b_m:1;
    local _b_ccval:1;
    local _b_bit:1;
    _b_m = 0x2;
    _b_ccval = cc;
    _b_bit = 8 >> _b_ccval;
    if ((_b_m & _b_bit) != 0) goto RIc_Target;
}

# Masks 3/5/6/9/10/12 have no PoP Appendix J extended mnemonic; the
# composite-condition spellings below are the LLVM/Capstone set (verified
# against Capstone 5.0 for all 16 masks), which the differential harness
# uses as its oracle.
:jnle "jnle " RIc_Target is RIc_OP=0xA7 & RIc_M1=0x3 & RIc_OP2=0x4 & RIc_Target
{
    local _b_m:1;
    local _b_ccval:1;
    local _b_bit:1;
    _b_m = 0x3;
    _b_ccval = cc;
    _b_bit = 8 >> _b_ccval;
