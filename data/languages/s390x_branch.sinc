# All 16 BRC masks now have disjoint mask-specific constructors above; no
# generic :brc fallback remains (it would be unreachable).

# ---------------------------------------------------------------------------
# BRANCH RELATIVE ON CONDITION LONG family (RILc token, opcode 0xC0,
# OPCD=0x4; PoP 7-47). Extended mnemonics are the PoP Appendix J set.
# NOTE: in the PoP set the "L" infix means LONG (JLE = "jump long on
# equal", mask 8), not "less". Masks 3/5/6/9/10/12 have no recommended
# extended mnemonic and fall back to the base :brcl constructor.
# ---------------------------------------------------------------------------

:jlnop "jlnop " RILc_RI2 is RILc_OP=0xC0 & RILc_M1=0x0 & RILc_OPCD=0x4 & RILc_RI2
{
    # BRCL with mask 0 never branches; falls through. (PoP J-1.)
}

:jlo "jlo " RILc_Target is RILc_OP=0xC0 & RILc_M1=0x1 & RILc_OPCD=0x4 & RILc_Target
{
    local _b_m:1;
    local _b_ccval:1;
    local _b_bit:1;
    _b_m = 0x1;
    _b_ccval = cc;
    _b_bit = 8 >> _b_ccval;
    if ((_b_m & _b_bit) != 0) goto RILc_Target;
}

