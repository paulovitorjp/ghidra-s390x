# ============================================================================
# CONVERT FROM FIXED to extended BFP: CXFBR/CXGBR (base, byte2=0) and
# CXFBRA/CXGBRA (M3/M4 displayed). R1 is an extended pair; only the
# high-order 64 bits are modeled. CC unchanged.
# ============================================================================

:CXFBR "CXFBR " RRElg_R1 "," RRElg_R2 is RRElg_OP=0xB396 & RRElg_IGN=0 & RRElg_R1 & RRElg_R2
{
    # CONVERT FROM FIXED (32-bit -> extended BFP).
    # TODO: low-order 64 bits of the pair (zero) not modeled.
    local src:8;
    src = (RRElg_R2 << 32) s>> 32;
    RRElg_R1 = int2float(src);
}

:CXFBRA "CXFBRA " RRFlg_R1 "," RRFlg_M3 "," RRFlg_R2 "," RRFlg_M4
    is RRFlg_OP=0xB396 & RRFlg_M3 & RRFlg_M4 & RRFlg_R1 & RRFlg_R2
{
    # CONVERT FROM FIXED (32-bit -> extended BFP), M3/M4 displayed.
    # TODO: low-order 64 bits of the pair (zero) not modeled.
    local src:8;
    src = (RRFlg_R2 << 32) s>> 32;
    RRFlg_R1 = int2float(src);
}

:CXGBR "CXGBR " RRElg_R1 "," RRElg_R2 is RRElg_OP=0xB3A6 & RRElg_IGN=0 & RRElg_R1 & RRElg_R2
{
    # CONVERT FROM FIXED (64-bit -> extended BFP).
    # TODO: low-order 64 bits of the pair (zero) not modeled.
    RRElg_R1 = int2float(RRElg_R2);
}

:CXGBRA "CXGBRA " RRFlg_R1 "," RRFlg_M3 "," RRFlg_R2 "," RRFlg_M4
    is RRFlg_OP=0xB3A6 & RRFlg_M3 & RRFlg_M4 & RRFlg_R1 & RRFlg_R2
{
    # CONVERT FROM FIXED (64-bit -> extended BFP), M3/M4 displayed.
    # TODO: low-order 64 bits of the pair (zero) not modeled.
    RRFlg_R1 = int2float(RRFlg_R2);
}

