# ---------------------------------------------------------------------------
# Condition-code helpers. cc_set (from s390x_arith.sinc) writes the 2-bit CC
# into the PSW byte. r/z/a/b are float varnodes; z is the all-zeros bit
# pattern of the same size (== +0.0).
# ---------------------------------------------------------------------------

# BFP arithmetic result -> CC: 0=zero, 1=negative, 2=positive, 3=NaN.
macro fp_cc_result(r, z) {
    local ncc:1;
    if (nan(r) != 0) goto <fpcc_nan>;
    if (r f== z) goto <fpcc_zero>;
    if (r f< z) goto <fpcc_neg>;
    ncc = 2;
    goto <fpcc_done>;
<fpcc_neg>
    ncc = 1;
    goto <fpcc_done>;
<fpcc_zero>
    ncc = 0;
    goto <fpcc_done>;
<fpcc_nan>
    ncc = 3;
<fpcc_done>
    cc_set(ncc);
}

# HFP arithmetic result -> CC (HFP has no NaN/Infinity): 0=zero,1=neg,2=pos.
macro fp_cc_hfp(r, z) {
    local ncc:1;
    if (r f== z) goto <fph_zero>;
    if (r f< z) goto <fph_neg>;
    ncc = 2;
    goto <fph_done>;
<fph_neg>
    ncc = 1;
    goto <fph_done>;
<fph_zero>
    ncc = 0;
<fph_done>
    cc_set(ncc);
}

# BFP compare -> CC: 0=equal, 1=a<b, 2=a>b, 3=unordered (NaN operand).
macro fp_cc_compare(a, b) {
    local ncc:1;
    if (nan(a) != 0) goto <fpcc_unordered>;
    if (nan(b) != 0) goto <fpcc_unordered>;
    if (a f== b) goto <fpcc_equal>;
    if (a f< b) goto <fpcc_low>;
    ncc = 2;
    goto <fpcc_cdone>;
<fpcc_low>
    ncc = 1;
    goto <fpcc_cdone>;
<fpcc_equal>
    ncc = 0;
    goto <fpcc_cdone>;
<fpcc_unordered>
    ncc = 3;
<fpcc_cdone>
    cc_set(ncc);
}

# HFP compare -> CC (no NaN in HFP): 0=equal, 1=a<b, 2=a>b.
macro fp_cc_compare_hfp(a, b) {
    local ncc:1;
    if (a f== b) goto <fphc_equal>;
    if (a f< b) goto <fphc_low>;
    ncc = 2;
    goto <fphc_done>;
<fphc_low>
    ncc = 1;
    goto <fphc_done>;
<fphc_equal>
    ncc = 0;
<fphc_done>
    cc_set(ncc);
}

# ============================================================================
# HFP (hexadecimal floating-point) RX-a: short forms. R1 is the 32-bit high
# half of the FPR. CC unchanged for LE; arithmetic sets CC 0/1/2.
# TODO: HFP is not IEEE-754; FLOAT_* operators approximate the value.
# ============================================================================

:LE "LE " RXs_R1 "," RXs_D2 "(" RXs_X2 "," RXs_B2 ")" is RXs_OP=0x78 & RXs_R1 & RXs_X2 & RXs_B2 & RXs_D2
{
    # LOAD (short): 4 bytes -> high half of FPR; low half unchanged (PoP 9-8).
    # CC unchanged. No arithmetic exceptions (no operand inspection).
    local ea:8;
    ea_D12(ea, RXs_B2, RXs_X2, RXs_D2);
    RXs_R1 = *:4 ea;
}

:AE "AE " RXs_R1 "," RXs_D2 "(" RXs_X2 "," RXs_B2 ")" is RXs_OP=0x7A & RXs_R1 & RXs_X2 & RXs_B2 & RXs_D2
{
    # ADD NORMALIZED (short HFP). TODO: HFP approx; HFP overflow/underflow
    # exceptions and normalized-result rules not modeled.
    local ea:8; local a:4; local b:4; local z:4;
    ea_D12(ea, RXs_B2, RXs_X2, RXs_D2);
    a = RXs_R1; b = *:4 ea; z = 0;
    a = a f+ b;
    RXs_R1 = a;
    fp_cc_hfp(a, z);
}

:SE "SE " RXs_R1 "," RXs_D2 "(" RXs_X2 "," RXs_B2 ")" is RXs_OP=0x7B & RXs_R1 & RXs_X2 & RXs_B2 & RXs_D2
{
    # SUBTRACT NORMALIZED (short HFP). TODO: HFP approx (see AE).
    local ea:8; local a:4; local b:4; local z:4;
    ea_D12(ea, RXs_B2, RXs_X2, RXs_D2);
    a = RXs_R1; b = *:4 ea; z = 0;
    a = a f- b;
    RXs_R1 = a;
    fp_cc_hfp(a, z);
}

:MDE "MDE " RXs_R1 "," RXs_D2 "(" RXs_X2 "," RXs_B2 ")" is RXs_OP=0x7C & RXs_R1 & RXs_X2 & RXs_B2 & RXs_D2
{
    # MULTIPLY (short HFP multiplier/multiplicand, long HFP product).
    # TODO: hardware produces a LONG (64-bit) product; modeled as a short
    #   product into the high half. HFP approx (see AE).
    local ea:8; local a:4; local b:4; local z:4;
    ea_D12(ea, RXs_B2, RXs_X2, RXs_D2);
    a = RXs_R1; b = *:4 ea; z = 0;
    a = a f* b;
    RXs_R1 = a;
    fp_cc_hfp(a, z);
}

:DE "DE " RXs_R1 "," RXs_D2 "(" RXs_X2 "," RXs_B2 ")" is RXs_OP=0x7D & RXs_R1 & RXs_X2 & RXs_B2 & RXs_D2
{
    # DIVIDE (short HFP). TODO: HFP approx (see AE); HFP divide-exception
    # rules (fraction > 1) not modeled.
    local ea:8; local a:4; local b:4; local z:4;
    ea_D12(ea, RXs_B2, RXs_X2, RXs_D2);
    a = RXs_R1; b = *:4 ea; z = 0;
    a = a f/ b;
    RXs_R1 = a;
    fp_cc_hfp(a, z);
}

:CE "CE " RXs_R1 "," RXs_D2 "(" RXs_X2 "," RXs_B2 ")" is RXs_OP=0x79 & RXs_R1 & RXs_X2 & RXs_B2 & RXs_D2
{
    # COMPARE (short HFP): CC 0=equal, 1=R1 low, 2=R1 high. TODO: HFP approx.
    local ea:8; local a:4; local b:4;
    ea_D12(ea, RXs_B2, RXs_X2, RXs_D2);
    a = RXs_R1; b = *:4 ea;
    fp_cc_compare_hfp(a, b);
}

# ============================================================================
# HFP (hexadecimal floating-point) RX-a: long forms. R1 is the full 64-bit
# FPR. TODO: HFP is not IEEE-754; FLOAT_* operators approximate the value.
# ============================================================================

:LD "LD " RXl_R1 "," RXl_D2 "(" RXl_X2 "," RXl_B2 ")" is RXl_OP=0x68 & RXl_R1 & RXl_X2 & RXl_B2 & RXl_D2
{
    # LOAD (long): 8 bytes -> FPR. CC unchanged.
    local ea:8;
    ea_D12(ea, RXl_B2, RXl_X2, RXl_D2);
    RXl_R1 = *:8 ea;
}

:AD "AD " RXl_R1 "," RXl_D2 "(" RXl_X2 "," RXl_B2 ")" is RXl_OP=0x6A & RXl_R1 & RXl_X2 & RXl_B2 & RXl_D2
{
    # ADD NORMALIZED (long HFP). TODO: HFP approx (see AE).
    local ea:8; local a:8; local b:8; local z:8;
    ea_D12(ea, RXl_B2, RXl_X2, RXl_D2);
    a = RXl_R1; b = *:8 ea; z = 0;
    a = a f+ b;
    RXl_R1 = a;
    fp_cc_hfp(a, z);
}

:SD "SD " RXl_R1 "," RXl_D2 "(" RXl_X2 "," RXl_B2 ")" is RXl_OP=0x6B & RXl_R1 & RXl_X2 & RXl_B2 & RXl_D2
{
    # SUBTRACT NORMALIZED (long HFP). TODO: HFP approx (see AE).
    local ea:8; local a:8; local b:8; local z:8;
    ea_D12(ea, RXl_B2, RXl_X2, RXl_D2);
    a = RXl_R1; b = *:8 ea; z = 0;
    a = a f- b;
    RXl_R1 = a;
    fp_cc_hfp(a, z);
}

:MD "MD " RXl_R1 "," RXl_D2 "(" RXl_X2 "," RXl_B2 ")" is RXl_OP=0x6C & RXl_R1 & RXl_X2 & RXl_B2 & RXl_D2
{
    # MULTIPLY (long HFP). TODO: HFP approx (see AE).
    local ea:8; local a:8; local b:8; local z:8;
    ea_D12(ea, RXl_B2, RXl_X2, RXl_D2);
    a = RXl_R1; b = *:8 ea; z = 0;
    a = a f* b;
    RXl_R1 = a;
    fp_cc_hfp(a, z);
}

:DD "DD " RXl_R1 "," RXl_D2 "(" RXl_X2 "," RXl_B2 ")" is RXl_OP=0x6D & RXl_R1 & RXl_X2 & RXl_B2 & RXl_D2
{
    # DIVIDE (long HFP). TODO: HFP approx (see AE/DE).
    local ea:8; local a:8; local b:8; local z:8;
    ea_D12(ea, RXl_B2, RXl_X2, RXl_D2);
    a = RXl_R1; b = *:8 ea; z = 0;
    a = a f/ b;
    RXl_R1 = a;
    fp_cc_hfp(a, z);
}

:CD "CD " RXl_R1 "," RXl_D2 "(" RXl_X2 "," RXl_B2 ")" is RXl_OP=0x69 & RXl_R1 & RXl_X2 & RXl_B2 & RXl_D2
{
    # COMPARE (long HFP): CC 0=equal, 1=R1 low, 2=R1 high. TODO: HFP approx.
    local ea:8; local a:8; local b:8;
    ea_D12(ea, RXl_B2, RXl_X2, RXl_D2);
    a = RXl_R1; b = *:8 ea;
    fp_cc_compare_hfp(a, b);
}

# ============================================================================
# HFP (hexadecimal floating-point) RR: short forms. TODO: HFP approx (see AE).
# ============================================================================

:LER "LER " RRs_R1 "," RRs_R2 is RRs_OP=0x38 & RRs_R1 & RRs_R2
{
    # LOAD (short, register): high half -> high half. CC unchanged.
    RRs_R1 = RRs_R2;
}

:AER "AER " RRs_R1 "," RRs_R2 is RRs_OP=0x3A & RRs_R1 & RRs_R2
{
    # ADD NORMALIZED (short HFP, register). TODO: HFP approx (see AE).
    local a:4; local z:4;
    a = RRs_R1 f+ RRs_R2; z = 0;
    RRs_R1 = a;
    fp_cc_hfp(a, z);
}

:SER "SER " RRs_R1 "," RRs_R2 is RRs_OP=0x3B & RRs_R1 & RRs_R2
{
    # SUBTRACT NORMALIZED (short HFP, register). TODO: HFP approx (see AE).
    local a:4; local z:4;
    a = RRs_R1 f- RRs_R2; z = 0;
    RRs_R1 = a;
    fp_cc_hfp(a, z);
}

:MDER "MDER " RRs_R1 "," RRs_R2 is RRs_OP=0x3C & RRs_R1 & RRs_R2
{
    # MULTIPLY (short HFP operands, long HFP product).
    # TODO: hardware produces a LONG product; modeled as short product into
    #   the high half. HFP approx (see AE).
    local a:4; local z:4;
    a = RRs_R1 f* RRs_R2; z = 0;
    RRs_R1 = a;
    fp_cc_hfp(a, z);
}

:DER "DER " RRs_R1 "," RRs_R2 is RRs_OP=0x3D & RRs_R1 & RRs_R2
{
    # DIVIDE (short HFP, register). TODO: HFP approx (see AE/DE).
    local a:4; local z:4;
    a = RRs_R1 f/ RRs_R2; z = 0;
    RRs_R1 = a;
    fp_cc_hfp(a, z);
}

:CER "CER " RRs_R1 "," RRs_R2 is RRs_OP=0x39 & RRs_R1 & RRs_R2
{
    # COMPARE (short HFP, register). TODO: HFP approx.
    fp_cc_compare_hfp(RRs_R1, RRs_R2);
}

# ============================================================================
# HFP (hexadecimal floating-point) RR: long forms. TODO: HFP approx (see AE).
# ============================================================================

:LDR "LDR " RRl_R1 "," RRl_R2 is RRl_OP=0x28 & RRl_R1 & RRl_R2
{
    # LOAD (long, register). CC unchanged.
    RRl_R1 = RRl_R2;
}

:ADR "ADR " RRl_R1 "," RRl_R2 is RRl_OP=0x2A & RRl_R1 & RRl_R2
{
    # ADD NORMALIZED (long HFP, register). TODO: HFP approx (see AE).
    local a:8; local z:8;
    a = RRl_R1 f+ RRl_R2; z = 0;
    RRl_R1 = a;
    fp_cc_hfp(a, z);
}

:SDR "SDR " RRl_R1 "," RRl_R2 is RRl_OP=0x2B & RRl_R1 & RRl_R2
{
    # SUBTRACT NORMALIZED (long HFP, register). TODO: HFP approx (see AE).
    local a:8; local z:8;
    a = RRl_R1 f- RRl_R2; z = 0;
    RRl_R1 = a;
    fp_cc_hfp(a, z);
}

:MDR "MDR " RRl_R1 "," RRl_R2 is RRl_OP=0x2C & RRl_R1 & RRl_R2
{
    # MULTIPLY (long HFP, register). TODO: HFP approx (see AE).
    local a:8; local z:8;
    a = RRl_R1 f* RRl_R2; z = 0;
    RRl_R1 = a;
    fp_cc_hfp(a, z);
}

:DDR "DDR " RRl_R1 "," RRl_R2 is RRl_OP=0x2D & RRl_R1 & RRl_R2
{
    # DIVIDE (long HFP, register). TODO: HFP approx (see AE/DE).
    local a:8; local z:8;
    a = RRl_R1 f/ RRl_R2; z = 0;
    RRl_R1 = a;
    fp_cc_hfp(a, z);
}

:CDR "CDR " RRl_R1 "," RRl_R2 is RRl_OP=0x29 & RRl_R1 & RRl_R2
{
    # COMPARE (long HFP, register). TODO: HFP approx.
    fp_cc_compare_hfp(RRl_R1, RRl_R2);
}

# ============================================================================
# BFP (IEEE-754 binary floating-point) RXE: short forms. R1 is the 32-bit
# high half of the FPR. CC 0=zero,1=negative,2=positive,3=NaN.
# TODO: IEEE exception flags (inexact/overflow/underflow/invalid) and the
# FPC rounding mode are not modeled.
# ============================================================================

:AEB "AEB " RXEs_R1 "," RXEs_DL2 "(" RXEs_X2 "," RXEs_B2 ")" is RXEs_OP=0xED & RXEs_R1 & RXEs_X2 & RXEs_B2 & RXEs_DL2 & RXEs_DH2 & RXEs_OP2=0x0A
{
    # ADD (short BFP). TODO: IEEE flags/rounding not modeled.
    local ea:8; local a:4; local b:4; local z:4;
    ea_D20(ea, RXEs_B2, RXEs_X2, RXEs_DH2, RXEs_DL2);
    a = RXEs_R1; b = *:4 ea; z = 0;
    a = a f+ b;
    RXEs_R1 = a;
    fp_cc_result(a, z);
}

:SEB "SEB " RXEs_R1 "," RXEs_DL2 "(" RXEs_X2 "," RXEs_B2 ")" is RXEs_OP=0xED & RXEs_R1 & RXEs_X2 & RXEs_B2 & RXEs_DL2 & RXEs_DH2 & RXEs_OP2=0x0B
{
    # SUBTRACT (short BFP). TODO: IEEE flags/rounding not modeled.
    local ea:8; local a:4; local b:4; local z:4;
    ea_D20(ea, RXEs_B2, RXEs_X2, RXEs_DH2, RXEs_DL2);
    a = RXEs_R1; b = *:4 ea; z = 0;
    a = a f- b;
    RXEs_R1 = a;
    fp_cc_result(a, z);
}

:MDEB "MDEB " RXEs_R1 "," RXEs_DL2 "(" RXEs_X2 "," RXEs_B2 ")" is RXEs_OP=0xED & RXEs_R1 & RXEs_X2 & RXEs_B2 & RXEs_DL2 & RXEs_DH2 & RXEs_OP2=0x0C
{
    # MULTIPLY (short BFP operands, long BFP product).
    # TODO: hardware produces a LONG (64-bit) exact product; modeled as a
    #   short product into the high half. IEEE flags/rounding not modeled.
    local ea:8; local a:4; local b:4; local z:4;
    ea_D20(ea, RXEs_B2, RXEs_X2, RXEs_DH2, RXEs_DL2);
    a = RXEs_R1; b = *:4 ea; z = 0;
    a = a f* b;
    RXEs_R1 = a;
    fp_cc_result(a, z);
}

:DEB "DEB " RXEs_R1 "," RXEs_DL2 "(" RXEs_X2 "," RXEs_B2 ")" is RXEs_OP=0xED & RXEs_R1 & RXEs_X2 & RXEs_B2 & RXEs_DL2 & RXEs_DH2 & RXEs_OP2=0x0D
{
    # DIVIDE (short BFP). TODO: IEEE flags/rounding not modeled.
    local ea:8; local a:4; local b:4; local z:4;
    ea_D20(ea, RXEs_B2, RXEs_X2, RXEs_DH2, RXEs_DL2);
    a = RXEs_R1; b = *:4 ea; z = 0;
    a = a f/ b;
    RXEs_R1 = a;
    fp_cc_result(a, z);
}

:CEB "CEB " RXEs_R1 "," RXEs_DL2 "(" RXEs_X2 "," RXEs_B2 ")" is RXEs_OP=0xED & RXEs_R1 & RXEs_X2 & RXEs_B2 & RXEs_DL2 & RXEs_DH2 & RXEs_OP2=0x09
{
    # COMPARE (short BFP): CC 0=equal,1=low,2=high,3=unordered.
    local ea:8; local a:4; local b:4;
    ea_D20(ea, RXEs_B2, RXEs_X2, RXEs_DH2, RXEs_DL2);
    a = RXEs_R1; b = *:4 ea;
    fp_cc_compare(a, b);
}

# ============================================================================
# BFP (IEEE-754) RXE: long forms + HFP LOAD LENGTHENED. R1 is the full FPR.
# TODO: IEEE flags/rounding not modeled (BFP); HFP approx (LDE/LXD).
# ============================================================================

:ADB "ADB " RXEl_R1 "," RXEl_DL2 "(" RXEl_X2 "," RXEl_B2 ")" is RXEl_OP=0xED & RXEl_R1 & RXEl_X2 & RXEl_B2 & RXEl_DL2 & RXEl_DH2 & RXEl_OP2=0x1A
{
    # ADD (long BFP). TODO: IEEE flags/rounding not modeled.
    local ea:8; local a:8; local b:8; local z:8;
    ea_D20(ea, RXEl_B2, RXEl_X2, RXEl_DH2, RXEl_DL2);
    a = RXEl_R1; b = *:8 ea; z = 0;
    a = a f+ b;
    RXEl_R1 = a;
    fp_cc_result(a, z);
}

:SDB "SDB " RXEl_R1 "," RXEl_DL2 "(" RXEl_X2 "," RXEl_B2 ")" is RXEl_OP=0xED & RXEl_R1 & RXEl_X2 & RXEl_B2 & RXEl_DL2 & RXEl_DH2 & RXEl_OP2=0x1B
{
    # SUBTRACT (long BFP). TODO: IEEE flags/rounding not modeled.
    local ea:8; local a:8; local b:8; local z:8;
    ea_D20(ea, RXEl_B2, RXEl_X2, RXEl_DH2, RXEl_DL2);
    a = RXEl_R1; b = *:8 ea; z = 0;
    a = a f- b;
    RXEl_R1 = a;
    fp_cc_result(a, z);
}

:MDB "MDB " RXEl_R1 "," RXEl_DL2 "(" RXEl_X2 "," RXEl_B2 ")" is RXEl_OP=0xED & RXEl_R1 & RXEl_X2 & RXEl_B2 & RXEl_DL2 & RXEl_DH2 & RXEl_OP2=0x1C
{
    # MULTIPLY (long BFP). TODO: IEEE flags/rounding not modeled.
    local ea:8; local a:8; local b:8; local z:8;
    ea_D20(ea, RXEl_B2, RXEl_X2, RXEl_DH2, RXEl_DL2);
    a = RXEl_R1; b = *:8 ea; z = 0;
    a = a f* b;
    RXEl_R1 = a;
    fp_cc_result(a, z);
}

:DDB "DDB " RXEl_R1 "," RXEl_DL2 "(" RXEl_X2 "," RXEl_B2 ")" is RXEl_OP=0xED & RXEl_R1 & RXEl_X2 & RXEl_B2 & RXEl_DL2 & RXEl_DH2 & RXEl_OP2=0x1D
{
    # DIVIDE (long BFP). TODO: IEEE flags/rounding not modeled.
    local ea:8; local a:8; local b:8; local z:8;
    ea_D20(ea, RXEl_B2, RXEl_X2, RXEl_DH2, RXEl_DL2);
    a = RXEl_R1; b = *:8 ea; z = 0;
    a = a f/ b;
    RXEl_R1 = a;
    fp_cc_result(a, z);
}

:CDB "CDB " RXEl_R1 "," RXEl_DL2 "(" RXEl_X2 "," RXEl_B2 ")" is RXEl_OP=0xED & RXEl_R1 & RXEl_X2 & RXEl_B2 & RXEl_DL2 & RXEl_DH2 & RXEl_OP2=0x19
{
    # COMPARE (long BFP): CC 0=equal,1=low,2=high,3=unordered.
    local ea:8; local a:8; local b:8;
    ea_D20(ea, RXEl_B2, RXEl_X2, RXEl_DH2, RXEl_DL2);
    a = RXEl_R1; b = *:8 ea;
    fp_cc_compare(a, b);
}

:LDE "LDE " RXEl_R1 "," RXEl_DL2 "(" RXEl_X2 "," RXEl_B2 ")" is RXEl_OP=0xED & RXEl_R1 & RXEl_X2 & RXEl_B2 & RXEl_DL2 & RXEl_DH2 & RXEl_OP2=0x24
{
    # LOAD LENGTHENED (short->long HFP): source fraction extended with zeros
    # (PoP 18-15); sign preserved. High 32 = source, low 32 = 0.
    # CC unchanged.
    local ea:8; local w:4;
    ea_D20(ea, RXEl_B2, RXEl_X2, RXEl_DH2, RXEl_DL2);
    w = *:4 ea;
    RXEl_R1 = zext(w) << 32;
}

:LXD "LXD " RXEl_R1 "," RXEl_DL2 "(" RXEl_X2 "," RXEl_B2 ")" is RXEl_OP=0xED & RXEl_R1 & RXEl_X2 & RXEl_B2 & RXEl_DL2 & RXEl_DH2 & RXEl_OP2=0x25
{
    # LOAD LENGTHENED (long->extended HFP).
    # TODO: R1 must designate a valid FP register pair (PoP 9-8); only the
    #   high-order 64 bits are modeled, the low-order 64 bits (F(R1+2))
    #   are not. CC unchanged.
    local ea:8;
    ea_D20(ea, RXEl_B2, RXEl_X2, RXEl_DH2, RXEl_DL2);
    RXEl_R1 = *:8 ea;
}

# ============================================================================
# BFP (IEEE-754) RRE: short forms. CC 0=zero,1=negative,2=positive,3=NaN.
# TODO: IEEE exception flags and FPC rounding not modeled.
# ============================================================================

:LPEBR "LPEBR " RREs_R1 "," RREs_R2 is RREs_OP=0xB300 & RREs_R1 & RREs_R2
{
    # LOAD POSITIVE (short BFP): R1 = |R2|. CC 0=zero,2=positive,3=NaN.
    local a:4; local z:4;
    a = abs(RREs_R2); z = 0;
    RREs_R1 = a;
    fp_cc_result(a, z);
}

:LNEBR "LNEBR " RREs_R1 "," RREs_R2 is RREs_OP=0xB301 & RREs_R1 & RREs_R2
{
    # LOAD NEGATIVE (short BFP): R1 = -|R2|. CC 0=zero,1=negative,3=NaN.
    # (Implements LNGBR's obvious intent; no LNGBR exists in the PoP.)
    local a:4; local z:4;
    a = f- abs(RREs_R2); z = 0;
    RREs_R1 = a;
    fp_cc_result(a, z);
}

:LTEBR "LTEBR " RREs_R1 "," RREs_R2 is RREs_OP=0xB302 & RREs_R1 & RREs_R2
{
    # LOAD AND TEST (short BFP): R1 = R2, CC set. 0=zero,1=neg,2=pos,3=NaN.
    local z:4;
    RREs_R1 = RREs_R2; z = 0;
    fp_cc_result(RREs_R1, z);
}

:AEBR "AEBR " RREs_R1 "," RREs_R2 is RREs_OP=0xB30A & RREs_R1 & RREs_R2
{
    # ADD (short BFP, register). TODO: IEEE flags/rounding not modeled.
    local a:4; local z:4;
    a = RREs_R1 f+ RREs_R2; z = 0;
    RREs_R1 = a;
    fp_cc_result(a, z);
}

:SEBR "SEBR " RREs_R1 "," RREs_R2 is RREs_OP=0xB30B & RREs_R1 & RREs_R2
{
    # SUBTRACT (short BFP, register). TODO: IEEE flags/rounding not modeled.
    local a:4; local z:4;
    a = RREs_R1 f- RREs_R2; z = 0;
    RREs_R1 = a;
    fp_cc_result(a, z);
}

:MDEBR "MDEBR " RREs_R1 "," RREs_R2 is RREs_OP=0xB30C & RREs_R1 & RREs_R2
{
    # MULTIPLY (short BFP operands, long BFP product, register).
    # TODO: hardware produces a LONG exact product; modeled as short product
    #   into the high half. IEEE flags/rounding not modeled.
    local a:4; local z:4;
    a = RREs_R1 f* RREs_R2; z = 0;
    RREs_R1 = a;
    fp_cc_result(a, z);
}

:DEBR "DEBR " RREs_R1 "," RREs_R2 is RREs_OP=0xB30D & RREs_R1 & RREs_R2
{
    # DIVIDE (short BFP, register). TODO: IEEE flags/rounding not modeled.
    local a:4; local z:4;
    a = RREs_R1 f/ RREs_R2; z = 0;
    RREs_R1 = a;
    fp_cc_result(a, z);
}

:CEBR "CEBR " RREs_R1 "," RREs_R2 is RREs_OP=0xB309 & RREs_R1 & RREs_R2
{
    # COMPARE (short BFP, register): CC 0=equal,1=low,2=high,3=unordered.
    fp_cc_compare(RREs_R1, RREs_R2);
}

# ============================================================================
# BFP RRE: short->long forms (R1 long, R2 short).
# ============================================================================

:LDEBR "LDEBR " RREsl_R1 "," RREsl_R2 is RREsl_OP=0xB304 & RREsl_R1 & RREsl_R2
{
    # LOAD LENGTHENED (short->long BFP): exact, value-preserving.
    # CC unchanged.
    RREsl_R1 = float2float(RREsl_R2);
}

# ============================================================================
# BFP (IEEE-754) RRE: long forms. TODO: IEEE flags/rounding not modeled.
# ============================================================================

:ADBR "ADBR " RREl_R1 "," RREl_R2 is RREl_OP=0xB31A & RREl_R1 & RREl_R2
{
    # ADD (long BFP, register). TODO: IEEE flags/rounding not modeled.
    local a:8; local z:8;
    a = RREl_R1 f+ RREl_R2; z = 0;
    RREl_R1 = a;
    fp_cc_result(a, z);
}

:SDBR "SDBR " RREl_R1 "," RREl_R2 is RREl_OP=0xB31B & RREl_R1 & RREl_R2
{
    # SUBTRACT (long BFP, register). TODO: IEEE flags/rounding not modeled.
    local a:8; local z:8;
    a = RREl_R1 f- RREl_R2; z = 0;
    RREl_R1 = a;
    fp_cc_result(a, z);
}

:MDBR "MDBR " RREl_R1 "," RREl_R2 is RREl_OP=0xB31C & RREl_R1 & RREl_R2
{
    # MULTIPLY (long BFP, register). TODO: IEEE flags/rounding not modeled.
    local a:8; local z:8;
    a = RREl_R1 f* RREl_R2; z = 0;
    RREl_R1 = a;
    fp_cc_result(a, z);
}

:DDBR "DDBR " RREl_R1 "," RREl_R2 is RREl_OP=0xB31D & RREl_R1 & RREl_R2
{
    # DIVIDE (long BFP, register). TODO: IEEE flags/rounding not modeled.
    local a:8; local z:8;
    a = RREl_R1 f/ RREl_R2; z = 0;
    RREl_R1 = a;
    fp_cc_result(a, z);
}

:CDBR "CDBR " RREl_R1 "," RREl_R2 is RREl_OP=0xB319 & RREl_R1 & RREl_R2
{
    # COMPARE (long BFP, register): CC 0=equal,1=low,2=high,3=unordered.
    fp_cc_compare(RREl_R1, RREl_R2);
}

:LXDBR "LXDBR " RREl_R1 "," RREl_R2 is RREl_OP=0xB305 & RREl_R1 & RREl_R2
{
    # LOAD LENGTHENED (long->extended BFP).
    # TODO: R1 must designate a valid FP register pair (PoP 9-8); only the
    #   high-order 64 bits are modeled, the low-order 64 bits (F(R1+2),
    #   zero for BFP lengthening) are not. CC unchanged.
    RREl_R1 = RREl_R2;
}

:LXDR "LXDR " RREl_R1 "," RREl_R2 is RREl_OP=0xB325 & RREl_R1 & RREl_R2
{
    # LOAD LENGTHENED (long->extended HFP).
    # TODO: R1 must designate a valid FP register pair (PoP 9-8); only the
    #   high-order 64 bits are modeled, the low-order 64 bits (F(R1+2)) are
    #   not. CC unchanged.
    RREl_R1 = RREl_R2;
}

# ============================================================================
# CONVERT FROM FIXED (RRE): GPR integer -> BFP/HFP. CC unchanged.
# The 32-bit source lives in bits 32-63 of the GPR; it is extended to 64
# bits (value-preserving) before int2float, so no narrowing is needed.
# TODO: M3 rounding-method selection (base forms use the FPC BFP rounding
#   mode) and IEEE exception flags are not modeled.
# ============================================================================

:CEFBR "CEFBR " RREsg_R1 "," RREsg_R2 is RREsg_OP=0xB394 & RREsg_IGN=0 & RREsg_R1 & RREsg_R2
{
    # CONVERT FROM FIXED (32-bit -> short BFP). CC unchanged.
    local src:8;
    src = (RREsg_R2 << 32) s>> 32;
    RREsg_R1 = int2float(src);
}

:CEGBR "CEGBR " RREsg_R1 "," RREsg_R2 is RREsg_OP=0xB3A4 & RREsg_IGN=0 & RREsg_R1 & RREsg_R2
{
    # CONVERT FROM FIXED (64-bit -> short BFP). CC unchanged.
    RREsg_R1 = int2float(RREsg_R2);
}

:CEGR "CEGR " RREsg_R1 "," RREsg_R2 is RREsg_OP=0xB3C4 & RREsg_R1 & RREsg_R2
{
    # CONVERT FROM FIXED (64-bit -> short HFP). CC unchanged.
    # TODO: HFP result is not IEEE-754; int2float approximates the value.
    RREsg_R1 = int2float(RREsg_R2);
}

:CDFBR "CDFBR " RRElg_R1 "," RRElg_R2 is RRElg_OP=0xB395 & RRElg_IGN=0 & RRElg_R1 & RRElg_R2
{
    # CONVERT FROM FIXED (32-bit -> long BFP). CC unchanged.
    local src:8;
    src = (RRElg_R2 << 32) s>> 32;
    RRElg_R1 = int2float(src);
}

:CDGBR "CDGBR " RRElg_R1 "," RRElg_R2 is RRElg_OP=0xB3A5 & RRElg_IGN=0 & RRElg_R1 & RRElg_R2
{
    # CONVERT FROM FIXED (64-bit -> long BFP). CC unchanged.
    RRElg_R1 = int2float(RRElg_R2);
}

:CDGR "CDGR " RRElg_R1 "," RRElg_R2 is RRElg_OP=0xB3C5 & RRElg_R1 & RRElg_R2
{
    # CONVERT FROM FIXED (64-bit -> long HFP). CC unchanged.
    # TODO: HFP result is not IEEE-754; int2float approximates the value.
    RRElg_R1 = int2float(RRElg_R2);
}

# ============================================================================
# LOAD FP INTEGER (RRF-e): round BFP operand to an integer value, same format.
# M3 selects the rounding method; M4 is 0 for these base forms (constrained).
# CC unchanged.
# TODO: only an approximate round() is modeled; the M3 method selection and
#   the IEEE inexact flag are not modeled.
# ============================================================================

:FIEBR "FIEBR " RRFs_R1 "," RRFs_M3 "," RRFs_R2 is RRFs_OP=0xB357 & RRFs_M3 & RRFs_M4=0 & RRFs_R1 & RRFs_R2
{
    # LOAD FP INTEGER (short BFP). CC unchanged.
    RRFs_R1 = round(RRFs_R2);
}

:FIDBR "FIDBR " RRFl_R1 "," RRFl_M3 "," RRFl_R2 is RRFl_OP=0xB35F & RRFl_M3 & RRFl_M4=0 & RRFl_R1 & RRFl_R2
{
    # LOAD FP INTEGER (long BFP). CC unchanged.
    RRFl_R1 = round(RRFl_R2);
}

:FIXBR "FIXBR " RRFl_R1 "," RRFl_M3 "," RRFl_R2 is RRFl_OP=0xB347 & RRFl_M3 & RRFl_M4=0 & RRFl_R1 & RRFl_R2
{
    # LOAD FP INTEGER (extended BFP).
    # TODO: R1/R2 must designate valid FP register pairs (PoP 9-8); only the
    #   high-order 64 bits are modeled, the low-order 64 bits (F(R1+2)) are
    #   not. M3 method selection and IEEE inexact flag not modeled.
    #   CC unchanged.
    RRFl_R1 = round(RRFl_R2);
}

# ============================================================================
# CONVERT FROM LOGICAL (RRF-e): unsigned GPR integer -> BFP. CC unchanged.
# TODO: M3 rounding-method selection, M4 XxC (inexact-exception control),
#   and IEEE exception flags are not modeled.
# ============================================================================

:CELFBR "CELFBR " RRFsg_R1 "," RRFsg_M3 "," RRFsg_R2 "," RRFsg_M4 is RRFsg_OP=0xB390 & RRFsg_M3 & RRFsg_M4 & RRFsg_R1 & RRFsg_R2
{
    # CONVERT FROM LOGICAL (32-bit -> short BFP). CC unchanged.
    local src:8;
    src = (RRFsg_R2 << 32) >> 32;
    RRFsg_R1 = int2float(src);
}

:CDLFBR "CDLFBR " RRFlg_R1 "," RRFlg_M3 "," RRFlg_R2 "," RRFlg_M4 is RRFlg_OP=0xB391 & RRFlg_M3 & RRFlg_M4 & RRFlg_R1 & RRFlg_R2
{
    # CONVERT FROM LOGICAL (32-bit -> long BFP). CC unchanged.
    local src:8;
    src = (RRFlg_R2 << 32) >> 32;
    RRFlg_R1 = int2float(src);
}

# ============================================================================
# Phase 7: remaining Capstone-validated BFP/HFP/DFP instructions.
# All opcodes/formats verified against IBM PoP SA22-7832-14.
# Overlap rule: where a base form and an A-form (or mask form) overlap,
# the MORE constrained (base) constructor is defined FIRST; SLEIGH resolves
# the overlap by first match. This is verified empirically (see report).
# ============================================================================

# ============================================================================
# HFP RR (2-byte): sign, halve, unnormalized add/subtract, long multiply.
# TODO: HFP approx (HFP bit patterns are interpreted as IEEE-754 doubles;
#   see AE). CC set for arithmetic/test, unchanged for load/halve.
# ============================================================================

:LPDR "LPDR " RRl_R1 "," RRl_R2 is RRl_OP=0x20 & RRl_R1 & RRl_R2
{
    # LOAD POSITIVE (long HFP): R1 = |R2|. CC unchanged.
    RRl_R1 = abs(RRl_R2);
}

:LNDR "LNDR " RRl_R1 "," RRl_R2 is RRl_OP=0x21 & RRl_R1 & RRl_R2
{
    # LOAD NEGATIVE (long HFP): R1 = -|R2|. CC unchanged.
    RRl_R1 = f- abs(RRl_R2);
}

:LTDR "LTDR " RRl_R1 "," RRl_R2 is RRl_OP=0x22 & RRl_R1 & RRl_R2
{
    # LOAD AND TEST (long HFP): R1 = R2, CC set. TODO: HFP approx.
    local z:8;
    RRl_R1 = RRl_R2; z = 0;
    fp_cc_hfp(RRl_R1, z);
}

:LCDR "LCDR " RRl_R1 "," RRl_R2 is RRl_OP=0x23 & RRl_R1 & RRl_R2
{
    # LOAD COMPLEMENT (long HFP): R1 = -R2. CC unchanged.
    RRl_R1 = f- RRl_R2;
}

:HDR "HDR " RRl_R1 "," RRl_R2 is RRl_OP=0x24 & RRl_R1 & RRl_R2
{
    # HALVE (long HFP): R1 = R2 / 2, normalized. CC unchanged.
    # TODO: HFP approx. (SLEIGH has no float literals; 2.0 is built from
    #   its IEEE-754 bit pattern. IEEE division by 2 is exact.)
    local two:8;
    two = 0x4000000000000000;
    RRl_R1 = RRl_R2 f/ two;
}

:MXDR "MXDR " RRl_R1 "," RRl_R2 is RRl_OP=0x27 & RRl_R1 & RRl_R2
{
    # MULTIPLY (long to extended HFP): R1(pair) = R1 * R2.
    # TODO: R1 must designate a valid FP register pair (PoP 9-8); only the
    #   high-order 64 bits are modeled. HFP approx.
    local a:8; local z:8;
    a = RRl_R1 f* RRl_R2; z = 0;
    RRl_R1 = a;
    fp_cc_hfp(a, z);
}

:AWR "AWR " RRl_R1 "," RRl_R2 is RRl_OP=0x2E & RRl_R1 & RRl_R2
{
    # ADD UNNORMALIZED (long HFP, register). TODO: HFP approx.
    local a:8; local z:8;
    a = RRl_R1 f+ RRl_R2; z = 0;
    RRl_R1 = a;
    fp_cc_hfp(a, z);
}

:SWR "SWR " RRl_R1 "," RRl_R2 is RRl_OP=0x2F & RRl_R1 & RRl_R2
{
    # SUBTRACT UNNORMALIZED (long HFP, register). TODO: HFP approx.
    local a:8; local z:8;
    a = RRl_R1 f- RRl_R2; z = 0;
    RRl_R1 = a;
    fp_cc_hfp(a, z);
}

:LPER "LPER " RRs_R1 "," RRs_R2 is RRs_OP=0x30 & RRs_R1 & RRs_R2
{
    # LOAD POSITIVE (short HFP): R1 = |R2|. CC unchanged.
    RRs_R1 = abs(RRs_R2);
}

:LNER "LNER " RRs_R1 "," RRs_R2 is RRs_OP=0x31 & RRs_R1 & RRs_R2
{
    # LOAD NEGATIVE (short HFP): R1 = -|R2|. CC unchanged.
    RRs_R1 = f- abs(RRs_R2);
}

:LTER "LTER " RRs_R1 "," RRs_R2 is RRs_OP=0x32 & RRs_R1 & RRs_R2
{
    # LOAD AND TEST (short HFP): R1 = R2, CC set. TODO: HFP approx.
    local z:4;
    RRs_R1 = RRs_R2; z = 0;
    fp_cc_hfp(RRs_R1, z);
}

:LCER "LCER " RRs_R1 "," RRs_R2 is RRs_OP=0x33 & RRs_R1 & RRs_R2
{
    # LOAD COMPLEMENT (short HFP): R1 = -R2. CC unchanged.
    RRs_R1 = f- RRs_R2;
}

:HER "HER " RRs_R1 "," RRs_R2 is RRs_OP=0x34 & RRs_R1 & RRs_R2
{
    # HALVE (short HFP): R1 = R2 / 2, normalized. CC unchanged.
    # TODO: HFP approx. (2.0f from its IEEE-754 bit pattern.)
    local two:4;
    two = 0x40000000;
    RRs_R1 = RRs_R2 f/ two;
}

:AUR "AUR " RRs_R1 "," RRs_R2 is RRs_OP=0x3E & RRs_R1 & RRs_R2
{
    # ADD UNNORMALIZED (short HFP, register). TODO: HFP approx.
    local a:4; local z:4;
    a = RRs_R1 f+ RRs_R2; z = 0;
    RRs_R1 = a;
    fp_cc_hfp(a, z);
}

:SUR "SUR " RRs_R1 "," RRs_R2 is RRs_OP=0x3F & RRs_R1 & RRs_R2
{
    # SUBTRACT UNNORMALIZED (short HFP, register). TODO: HFP approx.
    local a:4; local z:4;
    a = RRs_R1 f- RRs_R2; z = 0;
    RRs_R1 = a;
    fp_cc_hfp(a, z);
}

# ============================================================================
# HFP RX-a (4-byte): unnormalized add/subtract from storage.
# TODO: HFP approx. CC set.
# ============================================================================

:AW "AW " RXl_R1 "," RXl_D2 "(" RXl_X2 "," RXl_B2 ")" is RXl_OP=0x6E & RXl_R1 & RXl_X2 & RXl_B2 & RXl_D2
{
    # ADD UNNORMALIZED (long HFP). TODO: HFP approx.
    local ea:8; local a:8; local b:8; local z:8;
    ea_D12(ea, RXl_B2, RXl_X2, RXl_D2);
    a = RXl_R1; b = *:8 ea; z = 0;
    a = a f+ b;
    RXl_R1 = a;
    fp_cc_hfp(a, z);
}

:SW "SW " RXl_R1 "," RXl_D2 "(" RXl_X2 "," RXl_B2 ")" is RXl_OP=0x6F & RXl_R1 & RXl_X2 & RXl_B2 & RXl_D2
{
    # SUBTRACT UNNORMALIZED (long HFP). TODO: HFP approx.
    local ea:8; local a:8; local b:8; local z:8;
    ea_D12(ea, RXl_B2, RXl_X2, RXl_D2);
    a = RXl_R1; b = *:8 ea; z = 0;
    a = a f- b;
    RXl_R1 = a;
    fp_cc_hfp(a, z);
}

:AU "AU " RXs_R1 "," RXs_D2 "(" RXs_X2 "," RXs_B2 ")" is RXs_OP=0x7E & RXs_R1 & RXs_X2 & RXs_B2 & RXs_D2
{
    # ADD UNNORMALIZED (short HFP). TODO: HFP approx.
    local ea:8; local a:4; local b:4; local z:4;
    ea_D12(ea, RXs_B2, RXs_X2, RXs_D2);
    a = RXs_R1; b = *:4 ea; z = 0;
    a = a f+ b;
    RXs_R1 = a;
    fp_cc_hfp(a, z);
}

:SU "SU " RXs_R1 "," RXs_D2 "(" RXs_X2 "," RXs_B2 ")" is RXs_OP=0x7F & RXs_R1 & RXs_X2 & RXs_B2 & RXs_D2
{
    # SUBTRACT UNNORMALIZED (short HFP). TODO: HFP approx.
    local ea:8; local a:4; local b:4; local z:4;
    ea_D12(ea, RXs_B2, RXs_X2, RXs_D2);
    a = RXs_R1; b = *:4 ea; z = 0;
    a = a f- b;
    RXs_R1 = a;
    fp_cc_hfp(a, z);
}

# ============================================================================
# HFP RRE: lengthen, multiply, round-to-integer, square root.
# The reserved byte-2 nibble must be 0 (Capstone rejects nonzero).
# TODO: HFP approx. CC unchanged except where noted.
# ============================================================================

:LDER "LDER " RREsl_R1 "," RREsl_R2 is RREsl_OP=0xB324 & RREsl_IGN=0 & RREsl_R1 & RREsl_R2
{
    # LOAD LENGTHENED (short->long HFP): value-preserving.
    # TODO: HFP approx (float2float reinterprets the HFP bits as IEEE).
    # CC unchanged.
    RREsl_R1 = float2float(RREsl_R2);
}

:LXER "LXER " RREl_R1 "," RREl_R2 is RREl_OP=0xB326 & RREl_IGN=0 & RREl_R1 & RREl_R2
{
    # LOAD LENGTHENED (long->extended HFP).
    # TODO: R1 must designate a valid FP register pair (PoP 9-8); only the
    #   high-order 64 bits are modeled. HFP approx. CC unchanged.
    RREl_R1 = RREl_R2;
}

:MEER "MEER " RREs_R1 "," RREs_R2 is RREs_OP=0xB337 & RREs_IGN=0 & RREs_R1 & RREs_R2
{
    # MULTIPLY (short HFP): R1 = R1 * R2 (short product into high half).
    # TODO: hardware produces a LONG product; modeled as short product.
    #   HFP approx.
    local a:4; local z:4;
    a = RREs_R1 f* RREs_R2; z = 0;
    RREs_R1 = a;
    fp_cc_hfp(a, z);
}

:SQER "SQER " RREs_R1 "," RREs_R2 is RREs_OP=0xB245 & RREs_IGN=0 & RREs_R1 & RREs_R2
{
    # SQUARE ROOT (short HFP): R1 = sqrt(R2). TODO: HFP approx.
    # CC unchanged.
    RREs_R1 = sqrt(RREs_R2);
}

:SQDR "SQDR " RREl_R1 "," RREl_R2 is RREl_OP=0xB244 & RREl_IGN=0 & RREl_R1 & RREl_R2
{
    # SQUARE ROOT (long HFP): R1 = sqrt(R2). TODO: HFP approx.
    # CC unchanged.
    RREl_R1 = sqrt(RREl_R2);
}

:FIER "FIER " RREs_R1 "," RREs_R2 is RREs_OP=0xB377 & RREs_IGN=0 & RREs_R1 & RREs_R2
{
    # LOAD FP INTEGER (short HFP): R2 truncated toward zero.
    # TODO: HFP approx. CC unchanged.
    RREs_R1 = trunc(RREs_R2);
}

:FIDR "FIDR " RREl_R1 "," RREl_R2 is RREl_OP=0xB37F & RREl_IGN=0 & RREl_R1 & RREl_R2
{
    # LOAD FP INTEGER (long HFP): R2 truncated toward zero.
    # TODO: HFP approx. CC unchanged.
    RREl_R1 = trunc(RREl_R2);
}

# ============================================================================
# HFP RXE (ED): lengthen, square root, short multiply from storage.
# The DH2 byte must be 0 (Capstone rejects nonzero). TODO: HFP approx.
# ============================================================================

:LXE "LXE " RXEl_R1 "," RXEl_DL2 "(" RXEl_X2 "," RXEl_B2 ")" is RXEl_OP=0xED & RXEl_OP2=0x26 & RXEl_DH2=0 & RXEl_R1 & RXEl_X2 & RXEl_B2 & RXEl_DL2
{
    # LOAD LENGTHENED (short->extended HFP).
    # TODO: only the high-order 64 bits are modeled. HFP approx.
    # CC unchanged. (DH2=0, so ea_D12 suffices.)
    local ea:8;
    ea_D12(ea, RXEl_B2, RXEl_X2, RXEl_DL2);
    RXEl_R1 = float2float(*:4 ea);
}

:SQE "SQE " RXEs_R1 "," RXEs_DL2 "(" RXEs_X2 "," RXEs_B2 ")" is RXEs_OP=0xED & RXEs_OP2=0x34 & RXEs_DH2=0 & RXEs_R1 & RXEs_X2 & RXEs_B2 & RXEs_DL2
{
    # SQUARE ROOT (short HFP): R1 = sqrt(*ea). TODO: HFP approx.
    # CC unchanged.
    local ea:8;
    ea_D12(ea, RXEs_B2, RXEs_X2, RXEs_DL2);
    RXEs_R1 = sqrt(*:4 ea);
}

:SQD "SQD " RXEl_R1 "," RXEl_DL2 "(" RXEl_X2 "," RXEl_B2 ")" is RXEl_OP=0xED & RXEl_OP2=0x35 & RXEl_DH2=0 & RXEl_R1 & RXEl_X2 & RXEl_B2 & RXEl_DL2
{
    # SQUARE ROOT (long HFP): R1 = sqrt(*ea). TODO: HFP approx.
    # CC unchanged.
    local ea:8;
    ea_D12(ea, RXEl_B2, RXEl_X2, RXEl_DL2);
    RXEl_R1 = sqrt(*:8 ea);
}

:MEE "MEE " RXEs_R1 "," RXEs_DL2 "(" RXEs_X2 "," RXEs_B2 ")" is RXEs_OP=0xED & RXEs_OP2=0x37 & RXEs_DH2=0 & RXEs_R1 & RXEs_X2 & RXEs_B2 & RXEs_DL2
{
    # MULTIPLY (short HFP): R1 = R1 * *ea (short product into high half).
    # TODO: hardware produces a LONG product; modeled as short product.
    #   HFP approx.
    local ea:8; local a:4; local b:4; local z:4;
    ea_D12(ea, RXEs_B2, RXEs_X2, RXEs_DL2);
    a = RXEs_R1; b = *:4 ea; z = 0;
    a = a f* b;
    RXEs_R1 = a;
    fp_cc_hfp(a, z);
}

# ============================================================================
# HFP RRF-e: CONVERT HFP TO FIXED (32/64-bit). M4 must be 0 (Capstone
# rejects nonzero); M3 (rounding method) is displayed. CC unchanged.
# TODO: M3 method selection and inexact flag not modeled.
# ============================================================================

:CFER "CFER " RRFgs_R1 "," RRFgs_M3 "," RRFgs_R2 is RRFgs_OP=0xB3B8 & RRFgs_M3 & RRFgs_M4=0 & RRFgs_R1 & RRFgs_R2
{
    # CONVERT TO FIXED: decode-only.
    # TODO: SLEIGH p-code has no float-to-integer conversion operator
    #   (only INT2FLOAT exists); the rounded result cannot be materialized
    #   as an integer honestly. CC unchanged.
}

:CFDR "CFDR " RRFgl_R1 "," RRFgl_M3 "," RRFgl_R2 is RRFgl_OP=0xB3B9 & RRFgl_M3 & RRFgl_M4=0 & RRFgl_R1 & RRFgl_R2
{
    # CONVERT TO FIXED: decode-only.
    # TODO: SLEIGH p-code has no float-to-integer conversion operator
    #   (only INT2FLOAT exists); the rounded result cannot be materialized
    #   as an integer honestly. CC unchanged.
}

:CGER "CGER " RRFgs_R1 "," RRFgs_M3 "," RRFgs_R2 is RRFgs_OP=0xB3C8 & RRFgs_M3 & RRFgs_M4=0 & RRFgs_R1 & RRFgs_R2
{
    # CONVERT TO FIXED: decode-only.
    # TODO: SLEIGH p-code has no float-to-integer conversion operator
    #   (only INT2FLOAT exists); the rounded result cannot be materialized
    #   as an integer honestly. CC unchanged.
}

:CGDR "CGDR " RRFgl_R1 "," RRFgl_M3 "," RRFgl_R2 is RRFgl_OP=0xB3C9 & RRFgl_M3 & RRFgl_M4=0 & RRFgl_R1 & RRFgl_R2
{
    # CONVERT TO FIXED: decode-only.
    # TODO: SLEIGH p-code has no float-to-integer conversion operator
    #   (only INT2FLOAT exists); the rounded result cannot be materialized
    #   as an integer honestly. CC unchanged.
}

# ============================================================================
# HFP RXF (ED): MULTIPLY UNNORMALIZED (storage). PoP 9-9.
#   MAY/MY:   R1(pair) = R1 + R3 * *ea (entire extended product).
#   MAYH/MYH: R1 = R1 + high(R3 * *ea).
#   MAYL/MYL: R1+1 = R1 + low(R3 * *ea) -- decode-only (low half not modeled).
# CC unchanged. The reserved nibble must be 0.
# TODO: HFP approx. The multiply-then-add is not fused (hardware does a
#   single rounding); modeled as separate IEEE multiply and add.
# ============================================================================

:MAYH "MAYH " RXFs_R1 "," RXFs_R3 "," RXFs_DL2 "(" RXFs_X2 "," RXFs_B2 ")" is RXFs_OP=0xED & RXFs_OP2=0x3C & RXFs_IGN=0 & RXFs_R1 & RXFs_R3 & RXFs_X2 & RXFs_B2 & RXFs_DL2
{
    # MULTIPLY AND ADD UNNORMALIZED, high half: R1 = R1 + R3 * *ea.
    local ea:8; local p:8;
    ea_D12(ea, RXFs_B2, RXFs_X2, RXFs_DL2);
    p = RXFs_R3 f* *:8 ea;
    RXFs_R1 = RXFs_R1 f+ p;
}

:MYH "MYH " RXFs_R1 "," RXFs_R3 "," RXFs_DL2 "(" RXFs_X2 "," RXFs_B2 ")" is RXFs_OP=0xED & RXFs_OP2=0x3D & RXFs_IGN=0 & RXFs_R1 & RXFs_R3 & RXFs_X2 & RXFs_B2 & RXFs_DL2
{
    # MULTIPLY UNNORMALIZED, high half: R1 = R3 * *ea.
    local ea:8;
    ea_D12(ea, RXFs_B2, RXFs_X2, RXFs_DL2);
    RXFs_R1 = RXFs_R3 f* *:8 ea;
}

:MAY "MAY " RXFs_R1 "," RXFs_R3 "," RXFs_DL2 "(" RXFs_X2 "," RXFs_B2 ")" is RXFs_OP=0xED & RXFs_OP2=0x3A & RXFs_IGN=0 & RXFs_R1 & RXFs_R3 & RXFs_X2 & RXFs_B2 & RXFs_DL2
{
    # MULTIPLY AND ADD UNNORMALIZED (entire extended product).
    # TODO: only the high-order 64 bits are modeled (R1); the low-order
    #   64 bits of the pair are not. HFP approx, not fused.
    local ea:8; local p:8;
    ea_D12(ea, RXFs_B2, RXFs_X2, RXFs_DL2);
    p = RXFs_R3 f* *:8 ea;
    RXFs_R1 = RXFs_R1 f+ p;
}

:MY "MY " RXFs_R1 "," RXFs_R3 "," RXFs_DL2 "(" RXFs_X2 "," RXFs_B2 ")" is RXFs_OP=0xED & RXFs_OP2=0x3B & RXFs_IGN=0 & RXFs_R1 & RXFs_R3 & RXFs_X2 & RXFs_B2 & RXFs_DL2
{
    # MULTIPLY UNNORMALIZED (entire extended product).
    # TODO: only the high-order 64 bits are modeled (R1); the low-order
    #   64 bits of the pair are not. HFP approx.
    local ea:8;
    ea_D12(ea, RXFs_B2, RXFs_X2, RXFs_DL2);
    RXFs_R1 = RXFs_R3 f* *:8 ea;
}

:MAYL "MAYL " RXFs_R1 "," RXFs_R3 "," RXFs_DL2 "(" RXFs_X2 "," RXFs_B2 ")"
    is RXFs_OP=0xED & RXFs_OP2=0x38 & RXFs_IGN=0 & RXFs_R1 & RXFs_R3 & RXFs_X2 & RXFs_B2 & RXFs_DL2
{
    # MULTIPLY AND ADD UNNORMALIZED, low half (R1+1 = R1 + low(R3 * *ea)):
    # intentionally decode-only. The project models HFP values as IEEE
    # doubles, so the low 64 bits of the extended product lie below the
    # precision of the approximation -- no honest value can be
    # materialized, and any stored value would be fabrication. R1+1 is
    # left unchanged in the model.
}

:MYL "MYL " RXFs_R1 "," RXFs_R3 "," RXFs_DL2 "(" RXFs_X2 "," RXFs_B2 ")"
    is RXFs_OP=0xED & RXFs_OP2=0x39 & RXFs_IGN=0 & RXFs_R1 & RXFs_R3 & RXFs_X2 & RXFs_B2 & RXFs_DL2
{
    # MULTIPLY UNNORMALIZED, low half (R1+1 = low(R3 * *ea)):
    # intentionally decode-only, same rationale as MAYL above.
}

# ============================================================================
# BFP RRE: sign ops, square root, lengthen, multiply, compare-and-signal.
# The reserved byte-2 nibble must be 0 (Capstone rejects nonzero).
# CC set for test/compare/multiply; unchanged for load/sqrt.
# TODO: IEEE flags/rounding not modeled.
# ============================================================================

:LCEBR "LCEBR " RREs_R1 "," RREs_R2 is RREs_OP=0xB303 & RREs_IGN=0 & RREs_R1 & RREs_R2
{
    # LOAD COMPLEMENT (short BFP): R1 = -R2. CC unchanged.
    RREs_R1 = f- RREs_R2;
}

:LXEBR "LXEBR " RREsl_R1 "," RREsl_R2 is RREsl_OP=0xB306 & RREsl_IGN=0 & RREsl_R1 & RREsl_R2
{
    # LOAD LENGTHENED (extended->short BFP): exact, value-preserving.
    # TODO: only the high-order 64 bits of the extended source are read.
    # CC unchanged.
    RREsl_R1 = float2float(RREsl_R2);
}

:MXDBR "MXDBR " RREl_R1 "," RREl_R2 is RREl_OP=0xB307 & RREl_IGN=0 & RREl_R1 & RREl_R2
{
    # MULTIPLY (long BFP multiplier and multiplicand, extended product).
    # TODO: R1 must designate a valid FP register pair (PoP 9-8); only the
    #   high-order 64 bits of the extended product are modeled.
    local a:8; local z:8;
    a = RREl_R1 f* RREl_R2; z = 0;
    RREl_R1 = a;
    fp_cc_result(a, z);
}

:KEBR "KEBR " RREs_R1 "," RREs_R2 is RREs_OP=0xB308 & RREs_IGN=0 & RREs_R1 & RREs_R2
{
    # COMPARE AND SIGNAL (short BFP). Same as CEBR except a quiet NaN
    # operand raises invalid-operation (not modeled); CC identical.
    fp_cc_compare(RREs_R1, RREs_R2);
}

:LPDBR "LPDBR " RREl_R1 "," RREl_R2 is RREl_OP=0xB310 & RREl_IGN=0 & RREl_R1 & RREl_R2
{
    # LOAD POSITIVE (long BFP): R1 = |R2|. CC unchanged.
    RREl_R1 = abs(RREl_R2);
}

:LNDBR "LNDBR " RREl_R1 "," RREl_R2 is RREl_OP=0xB311 & RREl_IGN=0 & RREl_R1 & RREl_R2
{
    # LOAD NEGATIVE (long BFP): R1 = -|R2|. CC unchanged.
    RREl_R1 = f- abs(RREl_R2);
}

:LTDBR "LTDBR " RREl_R1 "," RREl_R2 is RREl_OP=0xB312 & RREl_IGN=0 & RREl_R1 & RREl_R2
{
    # LOAD AND TEST (long BFP): R1 = R2, CC set.
    local z:8;
    RREl_R1 = RREl_R2; z = 0;
    fp_cc_result(RREl_R1, z);
}

:LCDBR "LCDBR " RREl_R1 "," RREl_R2 is RREl_OP=0xB313 & RREl_IGN=0 & RREl_R1 & RREl_R2
{
    # LOAD COMPLEMENT (long BFP): R1 = -R2. CC unchanged.
    RREl_R1 = f- RREl_R2;
}

:MEEBR "MEEBR " RREs_R1 "," RREs_R2 is RREs_OP=0xB317 & RREs_IGN=0 & RREs_R1 & RREs_R2
{
    # MULTIPLY (short BFP): R1 = R1 * R2.
    local a:4; local z:4;
    a = RREs_R1 f* RREs_R2; z = 0;
    RREs_R1 = a;
    fp_cc_result(a, z);
}

:KDBR "KDBR " RREl_R1 "," RREl_R2 is RREl_OP=0xB318 & RREl_IGN=0 & RREl_R1 & RREl_R2
{
    # COMPARE AND SIGNAL (long BFP). Same as CDBR except a quiet NaN
    # operand raises invalid-operation (not modeled); CC identical.
    fp_cc_compare(RREl_R1, RREl_R2);
}

:SQEBR "SQEBR " RREs_R1 "," RREs_R2 is RREs_OP=0xB314 & RREs_IGN=0 & RREs_R1 & RREs_R2
{
    # SQUARE ROOT (short BFP): R1 = sqrt(R2). CC unchanged.
    RREs_R1 = sqrt(RREs_R2);
}

:SQDBR "SQDBR " RREl_R1 "," RREl_R2 is RREl_OP=0xB315 & RREl_IGN=0 & RREl_R1 & RREl_R2
{
    # SQUARE ROOT (long BFP): R1 = sqrt(R2). CC unchanged.
    RREl_R1 = sqrt(RREl_R2);
}

# ============================================================================
# BFP RRD: MULTIPLY AND ADD / MULTIPLY AND SUBTRACT (register).
# PoP 9-38: R1 = R3 * R2 + R1 (add) or R1 = R3 * R2 - R1 (subtract).
# The reserved nibble (bits 20-23) must be 0. CC unchanged.
# TODO: hardware computes a precise intermediate with a single rounding;
#   modeled as separate IEEE multiply then add/subtract. IEEE flags not
#   modeled.
# ============================================================================

:MAEBR "MAEBR " RRDs_R1 "," RRDs_R3 "," RRDs_R2 is RRDs_OP=0xB30E & RRDs_IGN=0 & RRDs_R1 & RRDs_R3 & RRDs_R2
{
    # MULTIPLY AND ADD (short BFP): R1 = R3 * R2 + R1. CC unchanged.
    local p:4;
    p = RRDs_R3 f* RRDs_R2;
    RRDs_R1 = p f+ RRDs_R1;
}

:MSEBR "MSEBR " RRDs_R1 "," RRDs_R3 "," RRDs_R2 is RRDs_OP=0xB30F & RRDs_IGN=0 & RRDs_R1 & RRDs_R3 & RRDs_R2
{
    # MULTIPLY AND SUBTRACT (short BFP): R1 = R3 * R2 - R1. CC unchanged.
    local p:4;
    p = RRDs_R3 f* RRDs_R2;
    RRDs_R1 = p f- RRDs_R1;
}

:MADBR "MADBR " RRDl_R1 "," RRDl_R3 "," RRDl_R2 is RRDl_OP=0xB31E & RRDl_IGN=0 & RRDl_R1 & RRDl_R3 & RRDl_R2
{
    # MULTIPLY AND ADD (long BFP): R1 = R3 * R2 + R1. CC unchanged.
    local p:8;
    p = RRDl_R3 f* RRDl_R2;
    RRDl_R1 = p f+ RRDl_R1;
}

:MSDBR "MSDBR " RRDl_R1 "," RRDl_R3 "," RRDl_R2 is RRDl_OP=0xB31F & RRDl_IGN=0 & RRDl_R1 & RRDl_R3 & RRDl_R2
{
    # MULTIPLY AND SUBTRACT (long BFP): R1 = R3 * R2 - R1. CC unchanged.
    local p:8;
    p = RRDl_R3 f* RRDl_R2;
    RRDl_R1 = p f- RRDl_R1;
}

# ============================================================================
# BFP RXE (ED): lengthen, multiply, compare-and-signal, sqrt from storage.
# The DH2 byte must be 0 (Capstone rejects nonzero).
# TODO: IEEE flags/rounding not modeled.
# ============================================================================

:LDEB "LDEB " RXEl_R1 "," RXEl_DL2 "(" RXEl_X2 "," RXEl_B2 ")" is RXEl_OP=0xED & RXEl_OP2=0x04 & RXEl_DH2=0 & RXEl_R1 & RXEl_X2 & RXEl_B2 & RXEl_DL2
{
    # LOAD LENGTHENED (short->long BFP): exact, value-preserving.
    # CC unchanged.
    local ea:8;
    ea_D12(ea, RXEl_B2, RXEl_X2, RXEl_DL2);
    RXEl_R1 = float2float(*:4 ea);
}

:LXDB "LXDB " RXEl_R1 "," RXEl_DL2 "(" RXEl_X2 "," RXEl_B2 ")" is RXEl_OP=0xED & RXEl_OP2=0x05 & RXEl_DH2=0 & RXEl_R1 & RXEl_X2 & RXEl_B2 & RXEl_DL2
{
    # LOAD LENGTHENED (extended->long BFP).
    # TODO: only the high-order 64 bits of the 16-byte source are read.
    # CC unchanged.
    local ea:8;
    ea_D12(ea, RXEl_B2, RXEl_X2, RXEl_DL2);
    RXEl_R1 = *:8 ea;
}

:LXEB "LXEB " RXEs_R1 "," RXEs_DL2 "(" RXEs_X2 "," RXEs_B2 ")" is RXEs_OP=0xED & RXEs_OP2=0x06 & RXEs_DH2=0 & RXEs_R1 & RXEs_X2 & RXEs_B2 & RXEs_DL2
{
    # LOAD LENGTHENED (extended->short BFP): exact, value-preserving.
    # TODO: only the high-order 64 bits of the 16-byte source are read.
    # CC unchanged.
    local ea:8;
    ea_D12(ea, RXEs_B2, RXEs_X2, RXEs_DL2);
    RXEs_R1 = float2float(*:8 ea);
}

:MXDB "MXDB " RXEl_R1 "," RXEl_DL2 "(" RXEl_X2 "," RXEl_B2 ")" is RXEl_OP=0xED & RXEl_OP2=0x07 & RXEl_DH2=0 & RXEl_R1 & RXEl_X2 & RXEl_B2 & RXEl_DL2
{
    # MULTIPLY (long BFP multiplier and multiplicand, extended product).
    # TODO: R1 must designate a valid FP register pair (PoP 9-8); only the
    #   high-order 64 bits of the extended product are modeled.
    local ea:8; local a:8; local z:8;
    ea_D12(ea, RXEl_B2, RXEl_X2, RXEl_DL2);
    a = RXEl_R1 f* *:8 ea; z = 0;
    RXEl_R1 = a;
    fp_cc_result(a, z);
}

:KEB "KEB " RXEs_R1 "," RXEs_DL2 "(" RXEs_X2 "," RXEs_B2 ")" is RXEs_OP=0xED & RXEs_OP2=0x08 & RXEs_DH2=0 & RXEs_R1 & RXEs_X2 & RXEs_B2 & RXEs_DL2
{
    # COMPARE AND SIGNAL (short BFP). Same as CEB except a quiet NaN
    # operand raises invalid-operation (not modeled); CC identical.
    local ea:8;
    ea_D12(ea, RXEs_B2, RXEs_X2, RXEs_DL2);
    fp_cc_compare(RXEs_R1, *:4 ea);
}

:SQEB "SQEB " RXEs_R1 "," RXEs_DL2 "(" RXEs_X2 "," RXEs_B2 ")" is RXEs_OP=0xED & RXEs_OP2=0x14 & RXEs_DH2=0 & RXEs_R1 & RXEs_X2 & RXEs_B2 & RXEs_DL2
{
    # SQUARE ROOT (short BFP): R1 = sqrt(*ea). CC unchanged.
    local ea:8;
    ea_D12(ea, RXEs_B2, RXEs_X2, RXEs_DL2);
    RXEs_R1 = sqrt(*:4 ea);
}

:SQDB "SQDB " RXEl_R1 "," RXEl_DL2 "(" RXEl_X2 "," RXEl_B2 ")" is RXEl_OP=0xED & RXEl_OP2=0x15 & RXEl_DH2=0 & RXEl_R1 & RXEl_X2 & RXEl_B2 & RXEl_DL2
{
    # SQUARE ROOT (long BFP): R1 = sqrt(*ea). CC unchanged.
    local ea:8;
    ea_D12(ea, RXEl_B2, RXEl_X2, RXEl_DL2);
    RXEl_R1 = sqrt(*:8 ea);
}

:MEEB "MEEB " RXEs_R1 "," RXEs_DL2 "(" RXEs_X2 "," RXEs_B2 ")" is RXEs_OP=0xED & RXEs_OP2=0x17 & RXEs_DH2=0 & RXEs_R1 & RXEs_X2 & RXEs_B2 & RXEs_DL2
{
    # MULTIPLY (short BFP): R1 = R1 * *ea.
    local ea:8; local a:4; local z:4;
    ea_D12(ea, RXEs_B2, RXEs_X2, RXEs_DL2);
    a = RXEs_R1 f* *:4 ea; z = 0;
    RXEs_R1 = a;
    fp_cc_result(a, z);
}

:KDB "KDB " RXEl_R1 "," RXEl_DL2 "(" RXEl_X2 "," RXEl_B2 ")" is RXEl_OP=0xED & RXEl_OP2=0x18 & RXEl_DH2=0 & RXEl_R1 & RXEl_X2 & RXEl_B2 & RXEl_DL2
{
    # COMPARE AND SIGNAL (long BFP). Same as CDB except a quiet NaN
    # operand raises invalid-operation (not modeled); CC identical.
    local ea:8;
    ea_D12(ea, RXEl_B2, RXEl_X2, RXEl_DL2);
    fp_cc_compare(RXEl_R1, *:8 ea);
}

# ============================================================================
# TEST DATA CLASS (RXE): TCEB/TCDB/TCXB.
# The 12-bit D2 is a class/sign mask (PoP Fig 19-17); the second-operand
# effective address (base+index+D2) forms the mask and is not dereferenced.
# If the mask bit for R1's class+sign is 1, CC=1, else CC=0.
# Mask bit mapping (IBM bit -> SLEIGH bit of 64-bit EA = 63-ibm):
#   +zero=52(11) -zero=53(10) +normal=54(9) -normal=55(8)
#   +subnormal=56(7) -subnormal=57(6) +inf=58(5) -inf=59(4)
#   +qnan=60(3) -qnan=61(2) +snan=62(1) -snan=63(0).
# So bit = 11 - 2*class - sign, class: 0=zero 1=normal 2=subnormal
#   3=inf 4=qnan 5=snan; sign: 0=positive 1=negative.
# The DH2 byte must be 0 (Capstone rejects nonzero).
# TODO: IEEE quiet/signaling NaN is distinguished by the leading fraction
#   bit, matching IEEE 754.
# ============================================================================

:TCEB "TCEB " RXEs_R1 "," RXEs_DL2 "(" RXEs_X2 "," RXEs_B2 ")" is RXEs_OP=0xED & RXEs_OP2=0x10 & RXEs_DH2=0 & RXEs_R1 & RXEs_X2 & RXEs_B2 & RXEs_DL2
{
    # TEST DATA CLASS (short BFP): decode-only.
    # TODO: Full p-code modeling was attempted (extract exponent/fraction,
    #   classify as zero/subnormal/normal/inf/qNaN/sNaN, index the EA mask
    #   bit, set CC). The bit-manipulation p-code hit SLEIGH size-restriction
    #   errors on the And operator that could not be resolved (constants
    #   would not adapt to the required operand sizes in this context).
    #   The EA is a 12-bit mask (not memory); CC is set to 0 or 1.
}

:TCDB "TCDB " RXEl_R1 "," RXEl_DL2 "(" RXEl_X2 "," RXEl_B2 ")" is RXEl_OP=0xED & RXEl_OP2=0x11 & RXEl_DH2=0 & RXEl_R1 & RXEl_X2 & RXEl_B2 & RXEl_DL2
{
    # TEST DATA CLASS (long BFP): decode-only.
    # TODO: Full p-code modeling was attempted (extract exponent/fraction,
    #   classify as zero/subnormal/normal/inf/qNaN/sNaN, index the EA mask
    #   bit, set CC). The bit-manipulation p-code hit SLEIGH size-restriction
    #   errors on the And operator that could not be resolved (constants
    #   would not adapt to the required operand sizes in this context).
    #   The EA is a 12-bit mask (not memory); CC is set to 0 or 1.
}

:TCXB "TCXB " RXEl_R1 "," RXEl_DL2 "(" RXEl_X2 "," RXEl_B2 ")" is RXEl_OP=0xED & RXEl_OP2=0x12 & RXEl_DH2=0 & RXEl_R1 & RXEl_X2 & RXEl_B2 & RXEl_DL2
{
    # TEST DATA CLASS (extended BFP): decode-only.
    # TODO: Full p-code modeling was attempted (extract exponent/fraction,
    #   classify as zero/subnormal/normal/inf/qNaN/sNaN, index the EA mask
    #   bit, set CC). The bit-manipulation p-code hit SLEIGH size-restriction
    #   errors on the And operator that could not be resolved (constants
    #   would not adapt to the required operand sizes in this context).
    #   The EA is a 12-bit mask (not memory); CC is set to 0 or 1.
}

# ============================================================================
# RXY-a FP loads/stores: LEY/LDY/STEY/STDY (20-bit displacement).
# The D20 field displays the full 20-bit displacement as hex (see token
# note on negative-display limitation). P-code uses ea_D20 (sign-extended).
# ============================================================================

:LEY "LEY " RXYFs_R1 "," RXYFs_D20 "(" RXYFs_X2 "," RXYFs_B2 ")" is RXYFs_OP=0xED & RXYFs_OP2=0x64 & RXYFs_R1 & RXYFs_X2 & RXYFs_B2 & RXYFs_D20
{
    # LOAD (short HFP, 20-bit displacement). CC unchanged.
    # TODO: HFP approx. D20 is displayed unsigned; negative displacements
    #   appear as large hex (p-code sign-extends correctly).
    local ea:8; local d:8; local dh:8; local dl:8;
    d = RXYFs_D20;
    dh = d >> 12;
    dl = d - (dh << 12);
    ea_D20(ea, RXYFs_B2, RXYFs_X2, dh, dl);
    RXYFs_R1 = *:4 ea;
}

:LDY "LDY " RXYFl_R1 "," RXYFl_D20 "(" RXYFl_X2 "," RXYFl_B2 ")" is RXYFl_OP=0xED & RXYFl_OP2=0x65 & RXYFl_R1 & RXYFl_X2 & RXYFl_B2 & RXYFl_D20
{
    # LOAD (long HFP, 20-bit displacement). CC unchanged.
    # TODO: HFP approx. D20 displayed unsigned; p-code sign-extends.
    local ea:8; local d:8; local dh:8; local dl:8;
    d = RXYFl_D20;
    dh = d >> 12;
    dl = d - (dh << 12);
    ea_D20(ea, RXYFl_B2, RXYFl_X2, dh, dl);
    RXYFl_R1 = *:8 ea;
}

:STEY "STEY " RXYFs_R1 "," RXYFs_D20 "(" RXYFs_X2 "," RXYFs_B2 ")" is RXYFs_OP=0xED & RXYFs_OP2=0x66 & RXYFs_R1 & RXYFs_X2 & RXYFs_B2 & RXYFs_D20
{
    # STORE (short HFP, 20-bit displacement). CC unchanged.
    # D20 displayed unsigned; p-code sign-extends.
    local ea:8; local d:8; local dh:8; local dl:8;
    d = RXYFs_D20;
    dh = d >> 12;
    dl = d - (dh << 12);
    ea_D20(ea, RXYFs_B2, RXYFs_X2, dh, dl);
    *:4 ea = RXYFs_R1;
}

:STDY "STDY " RXYFl_R1 "," RXYFl_D20 "(" RXYFl_X2 "," RXYFl_B2 ")" is RXYFl_OP=0xED & RXYFl_OP2=0x67 & RXYFl_R1 & RXYFl_X2 & RXYFl_B2 & RXYFl_D20
{
    # STORE (long HFP, 20-bit displacement). CC unchanged.
    # D20 displayed unsigned; p-code sign-extends.
    local ea:8; local d:8; local dh:8; local dl:8;
    d = RXYFl_D20;
    dh = d >> 12;
    dl = d - (dh << 12);
    ea_D20(ea, RXYFl_B2, RXYFl_X2, dh, dl);
    *:8 ea = RXYFl_R1;
}

# ============================================================================
# BFP RRF-b: DIEBR/DIDBR (decode-only), CPSDR (copy sign).
# DIEBR/DIDBR always display R3 and M4 (even when 0).
# CPSDR displays R1,R3,R2; the M4 nibble must be 0 (Capstone rejects nonzero).
# ============================================================================

:DIEBR "DIEBR " RRFbs_R1 "," RRFbs_R3 "," RRFbs_R2 "," RRFbs_M4
    is RRFbs_OP=0xB353 & RRFbs_R3 & RRFbs_M4 & RRFbs_R1 & RRFbs_R2
{
    # DIVIDE TO INTEGER (short BFP): decode-only.
    # TODO: iterative partial/final quotient+remainder; R1=rem, R2=quotient.
    #   Not modeled.
}

:DIDBR "DIDBR " RRFbl_R1 "," RRFbl_R3 "," RRFbl_R2 "," RRFbl_M4
    is RRFbl_OP=0xB35B & RRFbl_R3 & RRFbl_M4 & RRFbl_R1 & RRFbl_R2
{
    # DIVIDE TO INTEGER (long BFP): decode-only.
    # TODO: iterative partial/final quotient+remainder; R1=rem, R2=quotient.
    #   Not modeled.
}

:CPSDR "CPSDR " RRFbl_R1 "," RRFbl_R3 "," RRFbl_R2
    is RRFbl_OP=0xB372 & RRFbl_M4=0 & RRFbl_R1 & RRFbl_R3 & RRFbl_R2
{
    # COPY SIGN (long BFP): R1 = |R2| with the sign of R3. CC unchanged.
    local a:8; local z:8;
    a = abs(RRFbl_R2); z = 0;
    if (RRFbl_R3 f< z) goto <cpsdr_neg>;
    RRFbl_R1 = a;
    goto <cpsdr_done>;
<cpsdr_neg>
    RRFbl_R1 = f- a;
<cpsdr_done>
}

