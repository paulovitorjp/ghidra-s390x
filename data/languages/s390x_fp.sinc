# ============================================================================
# LOAD ROUNDED (long->short BFP): LEDBR (base, byte2=0) and LEDBRA.
# ============================================================================

:LEDBR "LEDBR " RREls_R1 "," RREls_R2 is RREls_OP=0xB344 & RREls_IGN=0 & RREls_R1 & RREls_R2
{
    # LOAD ROUNDED (long->short BFP): R1 = round(R2). CC unchanged.
    # TODO: rounding mode is per current BFP mode; modeled as round().
    local r:8;
    r = round(RREls_R2);
    RREls_R1 = float2float(r);
}

:LEDBRA "LEDBRA " RRFsl_R1 "," RRFsl_M3 "," RRFsl_R2 "," RRFsl_M4
    is RRFsl_OP=0xB344 & RRFsl_M3 & RRFsl_M4 & RRFsl_R1 & RRFsl_R2
{
    # LOAD ROUNDED (long->short BFP), M3/M4 displayed. CC unchanged.
    # TODO: M3 method selection not modeled; modeled as round().
    local r:8;
    r = round(RRFsl_R2);
    RRFsl_R1 = float2float(r);
}

# ============================================================================
# Phase 7b: Additional confirmed instructions (2026-09-17).
# ============================================================================

# HFP RRE sign operations (long).
:LPDFR "LPDFR " RREl_R1 "," RREl_R2 is RREl_OP=0xB370 & RREl_IGN=0 & RREl_R1 & RREl_R2
{
    # LOAD POSITIVE (long HFP). TODO: HFP approx.
    RREl_R1 = abs(RREl_R2);
}

:LNDFR "LNDFR " RREl_R1 "," RREl_R2 is RREl_OP=0xB371 & RREl_IGN=0 & RREl_R1 & RREl_R2
{
    # LOAD NEGATIVE (long HFP). TODO: HFP approx.
    RREl_R1 = -abs(RREl_R2);
}

:LCDFR "LCDFR " RREl_R1 "," RREl_R2 is RREl_OP=0xB373 & RREl_IGN=0 & RREl_R1 & RREl_R2
{
    # LOAD COMPLEMENT (long HFP). TODO: HFP approx.
    RREl_R1 = -RREl_R2;
}

# Load FPR from GR / Load GR from FPR. These move the 64-bit pattern
# unchanged between a GPR and a full FPR (PoP 9-28/9-29); the RREfg/RREgf
# tokens attach R1/R2 to the correct register files.
:LDGR "LDGR " RREfg_R1 "," RREfg_R2 is RREfg_OP=0xB3C1 & RREfg_IGN=0 & RREfg_R1 & RREfg_R2
{
    # LOAD FPR FROM GR (PoP 9-28): FPR R1 = GPR R2 (bit pattern).
    RREfg_R1 = RREfg_R2;
}

:LGDR "LGDR " RREgf_R1 "," RREgf_R2 is RREgf_OP=0xB3CD & RREgf_IGN=0 & RREgf_R1 & RREgf_R2
{
    # LOAD GR FROM FPR (PoP 9-29): GPR R1 = FPR R2 (bit pattern).
    RREgf_R1 = RREgf_R2;
}

# FPC operations. SFPC/EFPC use general registers (PoP 9-30/9-47), hence
# the RREg token (R1 -> GPR), not the FPR-attached RREl.
:SFPC "SFPC " RREg_R1 is RREg_OP=0xB384 & RREg_IGN=0 & RREg_R1
{
    # SET FPC (PoP 9-47): FPC = bits 32-63 of GPR R1. The
    # specification-exception checks on unsupported FPC bit positions are
    # not modeled (no exception mechanism in this spec).
    fpc = RREg_R1:4;
}

:EFPC "EFPC " RREg_R1 is RREg_OP=0xB38C & RREg_IGN=0 & RREg_R1
{
    # EXTRACT FPC (PoP 9-30): bits 32-63 of GPR R1 = FPC; bits 0-31 unchanged.
    local f:8;
    f = zext(fpc);
    RREg_R1 = (RREg_R1 & 0xffffffff00000000) | f;
}

# BFP to HFP conversion (RRE).
:THDER "THDER " RREsl_R1 "," RREsl_R2 is RREsl_OP=0xB358 & RREsl_IGN=0 & RREsl_R1 & RREsl_R2
{
    # CONVERT BFP TO HFP (short to long). TODO: HFP approx.
    # R2 is short BFP (fNh), R1 is long HFP (fN).
    RREsl_R1 = float2float(RREsl_R2);
}

:THDR "THDR " RREl_R1 "," RREl_R2 is RREl_OP=0xB359 & RREl_IGN=0 & RREl_R1 & RREl_R2
{
    # CONVERT BFP TO HFP (long). TODO: HFP approx.
    RREl_R1 = RREl_R2;
}

# BFP RXF multiply-add/subtract from storage.
:MAEB "MAEB " RXFss_R1 "," RXFss_R3 "," RXFss_DL2 "(" RXFss_X2 "," RXFss_B2 ")" is RXFss_OP=0xED & RXFss_OP2=0x0E & RXFss_IGN=0 & RXFss_R1 & RXFss_R3 & RXFss_X2 & RXFss_B2 & RXFss_DL2
{
    # MULTIPLY AND ADD (short BFP): R1 = R3 * MEM[EA] + old_R1.
    # TODO: multiply-then-add, not fused. CC unchanged.
    local ea:8; local b:4; local old:4;
    ea_D12(ea, RXFss_B2, RXFss_X2, RXFss_DL2);
    b = *:4 ea;
    old = RXFss_R1;
    RXFss_R1 = RXFss_R3 * b + old;
}

:MSEB "MSEB " RXFss_R1 "," RXFss_R3 "," RXFss_DL2 "(" RXFss_X2 "," RXFss_B2 ")" is RXFss_OP=0xED & RXFss_OP2=0x0F & RXFss_IGN=0 & RXFss_R1 & RXFss_R3 & RXFss_X2 & RXFss_B2 & RXFss_DL2
{
    # MULTIPLY AND SUBTRACT (short BFP): R1 = R3 * MEM[EA] - old_R1. CC unchanged.
    local ea:8; local b:4; local old:4;
    ea_D12(ea, RXFss_B2, RXFss_X2, RXFss_DL2);
    b = *:4 ea;
    old = RXFss_R1;
    RXFss_R1 = RXFss_R3 * b - old;
}

:MADB "MADB " RXFl_R1 "," RXFl_R3 "," RXFl_DL2 "(" RXFl_X2 "," RXFl_B2 ")" is RXFl_OP=0xED & RXFl_OP2=0x1E & RXFl_IGN=0 & RXFl_R1 & RXFl_R3 & RXFl_X2 & RXFl_B2 & RXFl_DL2
{
    # MULTIPLY AND ADD (long BFP): R1 = R3 * MEM[EA] + old_R1. CC unchanged.
    local ea:8; local b:8; local old:8;
    ea_D12(ea, RXFl_B2, RXFl_X2, RXFl_DL2);
    b = *:8 ea;
    old = RXFl_R1;
    RXFl_R1 = RXFl_R3 * b + old;
}

:MSDB "MSDB " RXFl_R1 "," RXFl_R3 "," RXFl_DL2 "(" RXFl_X2 "," RXFl_B2 ")" is RXFl_OP=0xED & RXFl_OP2=0x1F & RXFl_IGN=0 & RXFl_R1 & RXFl_R3 & RXFl_X2 & RXFl_B2 & RXFl_DL2
{
    # MULTIPLY AND SUBTRACT (long BFP): R1 = R3 * MEM[EA] - old_R1. CC unchanged.
    local ea:8; local b:8; local old:8;
    ea_D12(ea, RXFl_B2, RXFl_X2, RXFl_DL2);
    b = *:8 ea;
    old = RXFl_R1;
    RXFl_R1 = RXFl_R3 * b - old;
}
