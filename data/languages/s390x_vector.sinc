# --- Vector integer p-code ---
# Vector registers are 128-bit (16-byte) varnodes.

# Element-wise vector integer add/subtract: d = a +/- b computed
# independently per esz-byte element, modulo 2**(8*esz).
# esz, sub are 8-byte varnodes: esz in {1,2,4,8}, sub 0=add / 1=sub.
macro velem_op(d, a, b, esz, sub) {
    local n:8; local i:8;
    local ebits:8; local sh8:8;
    local sh:16; local m:16; local one:16;
    local ea:16; local eb:16; local er:16; local acc:16;
    n = 16 / esz;
    ebits = esz << 3;
    one = 1;
    sh = zext(ebits);
    m = (one << sh) - one;
    acc = 0;
    i = 0;
    <velem_loop>
    sh8 = i * esz;
    sh8 = sh8 << 3;
    sh = zext(sh8);
    ea = (a >> sh) & m;
    eb = (b >> sh) & m;
    er = ea + eb;
    if (sub == 0) goto <velem_have>;
    er = ea - eb;
    <velem_have>
    er = er & m;
    acc = acc | (er << sh);
    i = i + 1;
    if (i != n) goto <velem_loop>;
    d = acc;
}

# VECTOR GENERATE BYTE MASK: byte i of d is all-ones iff bit i of w
# (the zero-extended 16-bit I2 immediate) is one, else all-zeros.
# Bit/byte numbering: (w >> i) & 1 tests the bit of value 2^i, which is
# architectural bit (15-i); placing 0xFF at shift 8*i targets
# architectural byte (15-i).  Thus architectural bit k maps to
# architectural byte k (bit 0 = 0x8000 -> leftmost byte), as PoP requires.
# M3 is ignored (not an operand here).
macro vgbm16(d, w) {
    local i:8; local bit:8;
    local sh8:8; local sh:16; local by:16; local acc:16;
    acc = 0;
    i = 0;
    <vgbm_loop>
    bit = (w >> i) & 1;
    sh8 = i << 3;
    sh = zext(sh8);
    by = 0;
    if (bit == 0) goto <vgbm_have>;
    by = 0xff;
    <vgbm_have>
    acc = acc | (by << sh);
    i = i + 1;
    if (i != 16) goto <vgbm_loop>;
    d = acc;
}

# --- Vector constructors ---
:vl "vl " VVRX_V1a "," VVRX_D2 "(" VVRX_X2 "," VVRX_B2 ")" is VVRX_OP=0xE7 & VVRX_OP2=0x06 & VVRX_M3=0x0 & VVRX_V1X=0 & VVRX_V1a & VVRX_D2 & VVRX_X2 & VVRX_B2
{
    local ea:8;
    ea_D12(ea, VVRX_B2, VVRX_X2, VVRX_D2);
    VVRX_V1a = *:16 ea;
}

:vl "vl " VVRX_V1b "," VVRX_D2 "(" VVRX_X2 "," VVRX_B2 ")" is VVRX_OP=0xE7 & VVRX_OP2=0x06 & VVRX_M3=0x0 & VVRX_V1X=1 & VVRX_V1b & VVRX_D2 & VVRX_X2 & VVRX_B2
{
    local ea:8;
    ea_D12(ea, VVRX_B2, VVRX_X2, VVRX_D2);
    VVRX_V1b = *:16 ea;
}

:vst "vst " VVRX_V1a "," VVRX_D2 "(" VVRX_X2 "," VVRX_B2 ")" is VVRX_OP=0xE7 & VVRX_OP2=0x0E & VVRX_M3=0x0 & VVRX_V1X=0 & VVRX_V1a & VVRX_D2 & VVRX_X2 & VVRX_B2
{
    local ea:8;
    ea_D12(ea, VVRX_B2, VVRX_X2, VVRX_D2);
    *:16 ea = VVRX_V1a;
}

:vst "vst " VVRX_V1b "," VVRX_D2 "(" VVRX_X2 "," VVRX_B2 ")" is VVRX_OP=0xE7 & VVRX_OP2=0x0E & VVRX_M3=0x0 & VVRX_V1X=1 & VVRX_V1b & VVRX_D2 & VVRX_X2 & VVRX_B2
{
    local ea:8;
    ea_D12(ea, VVRX_B2, VVRX_X2, VVRX_D2);
    *:16 ea = VVRX_V1b;
}

:vlr "vlr " VVRRa_V1a "," VVRRa_V2a is VVRRa_OP=0xE7 & VVRRa_OP2=0x56 & VVRRa_V1X=0 & VVRRa_V2X=0 & VVRRa_V1a & VVRRa_V2a
{
    VVRRa_V1a = VVRRa_V2a;
}

:vlr "vlr " VVRRa_V1a "," VVRRa_V2b is VVRRa_OP=0xE7 & VVRRa_OP2=0x56 & VVRRa_V1X=0 & VVRRa_V2X=1 & VVRRa_V1a & VVRRa_V2b
{
    VVRRa_V1a = VVRRa_V2b;
}

:vlr "vlr " VVRRa_V1b "," VVRRa_V2a is VVRRa_OP=0xE7 & VVRRa_OP2=0x56 & VVRRa_V1X=1 & VVRRa_V2X=0 & VVRRa_V1b & VVRRa_V2a
{
    VVRRa_V1b = VVRRa_V2a;
}

:vlr "vlr " VVRRa_V1b "," VVRRa_V2b is VVRRa_OP=0xE7 & VVRRa_OP2=0x56 & VVRRa_V1X=1 & VVRRa_V2X=1 & VVRRa_V1b & VVRRa_V2b
{
    VVRRa_V1b = VVRRa_V2b;
}

:vab "vab " VVRRc_V1a "," VVRRc_V2a "," VVRRc_V3a is VVRRc_OP=0xE7 & VVRRc_OP2=0xF3 & VVRRc_M3=0x0 & VVRRc_V1X=0 & VVRRc_V2X=0 & VVRRc_V3X=0 & VVRRc_V1a & VVRRc_V2a & VVRRc_V3a
{
    # Element-wise add, 1-byte elements (PoP VA/VS).
    local esz:8; local sub:8;
    esz = 1; sub = 0;
    velem_op(VVRRc_V1a, VVRRc_V2a, VVRRc_V3a, esz, sub);
}

