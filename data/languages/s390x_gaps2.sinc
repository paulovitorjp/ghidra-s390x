# --------------------------------------------------------------------------
# LAM — LOAD ACCESS MULTIPLE (PoP 7-303).
# --------------------------------------------------------------------------
:lam_0_0 "lam " "a0" "," "a0" "," RSa_D2 "(" RSa_B2 ")" is RSa_OP=0x9A & RSa_R1=0 & RSa_R3=0 & RSa_B2 & RSa_D2
{
    # PoP 7-303: load access registers a0 from consecutive words starting at the second-operand address.
    local ea:8;
    ea_D12(ea, RSa_B2, zero, RSa_D2);
    a0 = *:4 ea;
    ea = ea + 4;
}

:lam_0_1 "lam " "a0" "," "a1" "," RSa_D2 "(" RSa_B2 ")" is RSa_OP=0x9A & RSa_R1=0 & RSa_R3=1 & RSa_B2 & RSa_D2
