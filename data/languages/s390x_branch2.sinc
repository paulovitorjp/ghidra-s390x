# s390x_branch2.sinc — Branch / loop-control constructors, part 2 (Phase 2b)
#
# Covers the remaining branch-on-count and branch-on-index instructions:
#   BC family (RX, 16 mask forms incl. extended mnemonics), BCT, BCTG,
#   BCTR, BCTGR, BRCT, BRCTG,
#   BXH, BXLE, BXHG, BXLEG, BRXH, BRXLE, BRXHG, BRXLG.
#
# This file is textually included into s390x.slaspec at merge time AFTER
# s390x_branch.sinc (it reuses that file's rel_RI16 macro) and shares the
# define-section tokens, registers, attachments, and macros of
# s390x.slaspec; the extra tokens it needs are defined here.
#
# References: IBM z/Architecture Principles of Operation SA22-7832-14
# (15th ed., Apr 2025). EVERY opcode below was verified against the PoP
# instruction figures (sections 7-41..7-48, App. A opcode tables) and
# cross-checked byte-for-byte against Capstone 5.0.7 (CS_ARCH_SYSZ).
#
# Conventions: see CONVENTIONS.md. Constructor names are lowercase;
# every constructor carries an explicit [...] display section in HLASM
# operand order. All bit ranges below use SLEIGH LSB=0 numbering
# (PoP MSB=0 ranges converted per CONVENTIONS.md).
#
# IMPORTANT ASSUMPTIONS (for the merge/sleighc phase to confirm):
#  1. BC's 16 mask forms are each fully constrained (M1 = 0..F), so the
#     patterns are mutually exclusive; no most-specific-wins subtlety.
#  2. BCTR/BCTGR suppress the branch when the *R2 field* is zero (PoP
#     7-41, note 4) -- not when the register's value is zero. A pair of
#     constructors keyed on a numeric shadow of the R2 field models this
#     exactly. (A "!= 0" constraint cannot share a field with an operand
#     use of that field, hence the RRd_R2n/RREd_R2n shadow fields.)
#  3. BXH/BXLE/BXHG/BXLEG/BRXH/BRXLE/BRXHG/BRXLG: an even R3 field
#     designates a register PAIR (increment in r[R3], compare value in
#     r[R3+1]); an odd R3 supplies both (PoP 7-41). The RSd_R3c (etc.)
#     second view of the R3 field, attached to r(R3|1), models both
#     cases exactly in a single constructor. Two fields may share one
#     bit range in a token definition; verified with the built compiler.
#  4. Relative-branch targets display as the raw signed halfword offset
#     (e.g. `brct r1,4`); the true absolute target lives in the pcode
#     (goto), which is what Ghidra's analysis consumes. The diff
#     harness needs pcrel entries for brct/brctg/brxh/brxle/brxhg/brxlg.
#  5. Base/index fields with value 0 attach to the 'zero' pseudo-
#     register (Phase 1 convention). Cosmetic only; pcode is correct.
#  6. 20-bit displacements display the low 12 bits only (existing RSY
#     convention, e.g. SLLK); full value is used in the pcode EA.
#  7. This SLEIGH build rejects `if (cond) goto [computed];` (syntax
#     error) even though bare `goto [computed];` is fine. All
#     conditional computed branches are therefore written in the
#     `if (negated-cond) goto <label>; goto [target]; <label>` shape
#     used by s390x_branch.sinc.

# ---------------------------------------------------------------------------
# Extra tokens
# ---------------------------------------------------------------------------

# RRd: RR-format variant for BRANCH ON COUNT (BCTR). Adds RRd_R2n, a
# numeric (unattached) shadow of the R2 field for the R2-field-zero
# branch-suppression split (see assumption 2).
define token RRd(16)
    RRd_OP  = (8,15)
    RRd_R1  = (4,7)
    RRd_R2  = (0,3)
    RRd_R2n = (0,3)
;
attach variables [ RRd_R1 ] [ r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 ];
attach variables [ RRd_R2 ] [ r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 ];
# RRd_R2n intentionally unattached: numeric field for pattern constraints.

# RREd: RRE-format variant for BRANCH ON COUNT (BCTGR). Same shadow
# trick as RRd. PoP RRE: OP(0-15) IGN(16-23) R1(24-27) R2(28-31).
define token RREd(32)
    RREd_OP  = (16,31)
    RREd_IGN = (8,15)
    RREd_R1  = (4,7)
    RREd_R2  = (0,3)
    RREd_R2n = (0,3)
;
attach variables [ RREd_R1 ] [ r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 ];
attach variables [ RREd_R2 ] [ r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 ];
# RREd_R2n intentionally unattached: numeric field for pattern constraints.

# RSd: RS-format variant for BRANCH ON INDEX HIGH / LOW OR EQUAL
# (BXH/BXLE). Adds RSd_R3c, a second view of the R3 field attached to
# r(R3|1) -- the compare-value register per the even/odd pair rule
# (PoP 7-41; see assumption 3).
define token RSd(32)
    RSd_OP  = (24,31)
    RSd_R1  = (20,23)
    RSd_R3  = (16,19)
    RSd_R3c = (16,19)
    RSd_B2  = (12,15)
    RSd_D2  = (0,11)
;
attach variables [ RSd_R1 ] [ r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 ];
attach variables [ RSd_R3 ] [ r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 ];
attach variables [ RSd_R3c ] [ r1 r1 r3 r3 r5 r5 r7 r7 r9 r9 r11 r11 r13 r13 r15 r15 ];
attach variables [ RSd_B2 ] [ zero r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 ];

# RSYd: RSY-format variant for BXHG/BXLEG. Same R3c trick as RSd.
# PoP RSY: OP(0-7) R1(8-11) R3(12-15) B2(16-19) DL2(20-31) DH2(32-39)
# OP2(40-47).
define token RSYd(48)
    RSYd_OP  = (40,47)
    RSYd_R1  = (36,39)
    RSYd_R3  = (32,35)
    RSYd_R3c = (32,35)
    RSYd_B2  = (28,31)
    RSYd_DL2 = (16,27)
    RSYd_DH2 = (8,15)
    RSYd_OP2 = (0,7)
;
attach variables [ RSYd_R1 ] [ r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 ];
attach variables [ RSYd_R3 ] [ r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 ];
attach variables [ RSYd_R3c ] [ r1 r1 r3 r3 r5 r5 r7 r7 r9 r9 r11 r11 r13 r13 r15 r15 ];
attach variables [ RSYd_B2 ] [ zero r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 ];

# RSId: RSI-format variant for BRANCH RELATIVE ON INDEX HIGH / LOW OR
# EQUAL (BRXH/BRXLE). Same R3c trick. PoP RSI: OP(0-7) R1(8-11)
# R3(12-15) I2(16-31, signed halfword count).
define token RSId(32)
    RSId_OP  = (24,31)
    RSId_R1  = (20,23)
    RSId_R3  = (16,19)
    RSId_R3c = (16,19)
    RSId_I2  = (0,15) signed
;
attach variables [ RSId_R1 ] [ r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 ];
attach variables [ RSId_R3 ] [ r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 ];
attach variables [ RSId_R3c ] [ r1 r1 r3 r3 r5 r5 r7 r7 r9 r9 r11 r11 r13 r13 r15 r15 ];

# RIEd: RIEe-format variant for BRXHG/BRXLG. Same R3c trick.
# PoP RIEe: 'EC'(0-7) R1(8-11) R3(12-15) RI2(16-31, signed halfword
# count) IGN(32-39) OP2(40-47).
define token RIEd(48)
    RIEd_OP  = (40,47)
    RIEd_R1  = (36,39)
    RIEd_R3  = (32,35)
    RIEd_R3c = (32,35)
    RIEd_RI2 = (16,31) signed
    RIEd_IGN = (8,15)
    RIEd_OP2 = (0,7)
;
attach variables [ RIEd_R1 ] [ r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 ];
attach variables [ RIEd_R3 ] [ r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 ];
attach variables [ RIEd_R3c ] [ r1 r1 r3 r3 r5 r5 r7 r7 r9 r9 r11 r11 r13 r13 r15 r15 ];

# ---------------------------------------------------------------------------
# BRANCH ON CONDITION, RX format (BC + extended mnemonics)
# PoP 7-44. Opcode 0x47, token RXb (M1/X2/B2/D2). The M1 mask selects
# which of the 4 condition-code states branch: bit 3 (val 8)->CC0,
# bit 2 (val 4)->CC1, bit 1 (val 2)->CC2, bit 0 (val 1)->CC3.
# Extended mnemonics per PoP Fig. 7-1. Capstone prints `bc` with the
# mask operand for M1=0, `b` for M1=15.
# ---------------------------------------------------------------------------

:bc "bc 0," RXb_D2 "(" RXb_X2 "," RXb_B2 ")" is RXb_OP=0x47 & RXb_M1=0x0 & RXb_X2 & RXb_B2 & RXb_D2
{
    # Mask 0 never branches; falls through. (PoP J-1.)
}

:bo "bo " RXb_D2 "(" RXb_X2 "," RXb_B2 ")" is RXb_OP=0x47 & RXb_M1=0x1 & RXb_X2 & RXb_B2 & RXb_D2
{
    local ea:8;
    local _b_m:1;
    local _b_ccval:1;
    local _b_bit:1;
    ea_D12(ea, RXb_B2, RXb_X2, RXb_D2);
    _b_m = 0x1;
    _b_ccval = cc;
    _b_bit = 8 >> _b_ccval;
    if ((_b_m & _b_bit) == 0) goto <br2_skip_1>;
    goto [ea];
    <br2_skip_1>
}

:bh "bh " RXb_D2 "(" RXb_X2 "," RXb_B2 ")" is RXb_OP=0x47 & RXb_M1=0x2 & RXb_X2 & RXb_B2 & RXb_D2
{
    local ea:8;
    local _b_m:1;
    local _b_ccval:1;
    local _b_bit:1;
    ea_D12(ea, RXb_B2, RXb_X2, RXb_D2);
    _b_m = 0x2;
    _b_ccval = cc;
    _b_bit = 8 >> _b_ccval;
    if ((_b_m & _b_bit) == 0) goto <br2_skip_2>;
    goto [ea];
    <br2_skip_2>
}

:bnle "bnle " RXb_D2 "(" RXb_X2 "," RXb_B2 ")" is RXb_OP=0x47 & RXb_M1=0x3 & RXb_X2 & RXb_B2 & RXb_D2
{
    local ea:8;
    local _b_m:1;
    local _b_ccval:1;
