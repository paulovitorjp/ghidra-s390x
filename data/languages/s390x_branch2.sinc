{
    local ea:8;
    ea_D12(ea, RXb_B2, RXb_X2, RXb_D2);
    goto [ea];
}

# ---------------------------------------------------------------------------
# BRANCH ON COUNT, RX format (BCT) — 32-bit count
# PoP 7-41. Opcode 0x46, token RXa. Subtract 1 from bits 32-63 of R1,
# ignoring overflow; branch to the RX effective address iff the 32-bit
# result is nonzero. Condition code unchanged.
# ---------------------------------------------------------------------------

:bct "bct " RXa_R1 "," RXa_D2 "(" RXa_X2 "," RXa_B2 ")" is RXa_OP=0x46 & RXa_R1 & RXa_X2 & RXa_B2 & RXa_D2
{
    local ea:8;
    local cnt:8;
    ea_D12(ea, RXa_B2, RXa_X2, RXa_D2);
    cnt = (RXa_R1 - 1) & 0xffffffff;
    RXa_R1 = (RXa_R1 & (0xFFFFFFFF << 32)) | cnt;
    if (cnt == 0) goto <bct_skip>;
    goto [ea];
    <bct_skip>
}

# ---------------------------------------------------------------------------
# BRANCH ON COUNT, RXY format (BCTG) — 64-bit count
# PoP 7-41. Opcode 0xE3/0x46, token RXYc (new token; no constructors
# existed yet). Full 64-bit subtract-1; branch iff result nonzero.
# ---------------------------------------------------------------------------

:bctg "bctg " RXYc_R1 "," RXYc_DXL2 "(" RXYc_X2 "," RXYc_B2 ")" is RXYc_OP=0xE3 & RXYc_OP2=0x46 & RXYc_R1 & RXYc_X2 & RXYc_B2 & RXYc_DXL2 & RXYc_DXH2
{
    local ea:8;
    ea_D20(ea, RXYc_B2, RXYc_X2, RXYc_DXH2, RXYc_DXL2);
    RXYc_R1 = RXYc_R1 - 1;
    if (RXYc_R1 == 0) goto <bctg_skip>;
    goto [ea];
    <bctg_skip>
}

# ---------------------------------------------------------------------------
# BRANCH ON COUNT, RR format (BCTR) — 32-bit count
# PoP 7-41. Opcode 0x06. The decrement ALWAYS happens (no R1=0
# exception); the branch is suppressed only when the *R2 field* is zero
# (note 4). The branch address (from R2) is generated before R1 changes.
# Two constructors: :bctr for R2 field != 0, :bctr_nobr for R2 field = 0.
# ---------------------------------------------------------------------------

:bctr "bctr " RRd_R1 "," RRd_R2 is RRd_OP=0x06 & RRd_R1 & RRd_R2 & RRd_R2n != 0
{
    # RRd_R2n is the numeric shadow of the R2 field; R2 field != 0 here.
    local cnt:8;
    cnt = (RRd_R1 - 1) & 0xffffffff;
    RRd_R1 = (RRd_R1 & (0xFFFFFFFF << 32)) | cnt;
    if (cnt == 0) goto <bctr_skip>;
    goto RRd_R2;
    <bctr_skip>
}

:bctr_nobr "bctr " RRd_R1 "," RRd_R2 is RRd_OP=0x06 & RRd_R1 & RRd_R2 & RRd_R2n=0
{
    # R2 field = 0: count without branching (PoP 7-41, note 4).
    local cnt:8;
    cnt = (RRd_R1 - 1) & 0xffffffff;
    RRd_R1 = (RRd_R1 & (0xFFFFFFFF << 32)) | cnt;
}

# ---------------------------------------------------------------------------
# BRANCH ON COUNT, RRE format (BCTGR) — 64-bit count
# PoP 7-41. Opcode 0xB9/0x46. Same R2-field-zero split as BCTR.
# ---------------------------------------------------------------------------

:bctgr "bctgr " RREd_R1 "," RREd_R2 is RREd_OP=0xB946 & RREd_IGN & RREd_R1 & RREd_R2 & RREd_R2n != 0
{
    # R2 field != 0: decrement, branch to R2 iff result nonzero.
    RREd_R1 = RREd_R1 - 1;
    if (RREd_R1 == 0) goto <bctgr_skip>;
    goto RREd_R2;
    <bctgr_skip>
}

:bctgr_nobr "bctgr " RREd_R1 "," RREd_R2 is RREd_OP=0xB946 & RREd_IGN & RREd_R1 & RREd_R2 & RREd_R2n=0
{
    # R2 field = 0: count without branching (PoP 7-41, note 4).
    RREd_R1 = RREd_R1 - 1;
}

# ---------------------------------------------------------------------------
# BRANCH RELATIVE ON COUNT (BRCT, 32-bit) — RI format, opcode 0xA7 ext 6
# BRANCH RELATIVE ON COUNT (BRCTG, 64-bit) — RI format, opcode 0xA7 ext 7
# PoP 7-41. Same counting rule as BCT/BCTG; the target is
# inst_addr + 2*RI2 (signed halfword count), computed by rel_RI16.
# (JCT/JCTG are not distinct PoP instructions; Capstone decodes A7/6-7
# as BRCT/BRCTG, so no aliases are provided.)
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# PC-relative target subtables for BRCT/BRCTG (RIb), BRXH/BRXLE (RSId),
# BRXHG/BRXLG (RIEd). Each computes inst_start + 2*sign_extend(imm) at decode
# time for a direct CBRANCH to a constant address. Display shows the absolute
# target (Capstone-compatible).
# ---------------------------------------------------------------------------
RSId_TargetLoc: tgt is RSId_I2 [ tgt = inst_start + RSId_I2 * 2; ] { export *[const]:8 tgt; }
RSId_Target: RSId_TargetLoc is RSId_TargetLoc { export *:8 RSId_TargetLoc; }
RIEd_TargetLoc: tgt is RIEd_RI2 [ tgt = inst_start + RIEd_RI2 * 2; ] { export *[const]:8 tgt; }
RIEd_Target: RIEd_TargetLoc is RIEd_TargetLoc { export *:8 RIEd_TargetLoc; }

:brct "brct " RIb_R1 "," RIb_Target is RIb_OP=0xA7 & RIb_OP2=0x6 & RIb_R1 & RIb_Target
{
    local cnt:8;
    cnt = (RIb_R1 - 1) & 0xffffffff;
    RIb_R1 = (RIb_R1 & (0xFFFFFFFF << 32)) | cnt;
    if (cnt != 0) goto RIb_Target;
}

:brctg "brctg " RIb_R1 "," RIb_Target is RIb_OP=0xA7 & RIb_OP2=0x7 & RIb_R1 & RIb_Target
{
    RIb_R1 = RIb_R1 - 1;
    if (RIb_R1 != 0) goto RIb_Target;
}

# ---------------------------------------------------------------------------
# BRANCH ON INDEX HIGH (BXH) / LOW OR EQUAL (BXLE) — RS format, 32-bit
# PoP 7-41. Opcodes 0x86/0x87. Signed 32-bit: sum = R1 + increment;
# BXH branches iff sum > compare value, BXLE iff sum <= compare value.
# The sum is ALWAYS stored back to R1; the branch target EA is generated
# before the update; CC unchanged. RSd_R3 is the increment register
# (r[R3]); RSd_R3c is the compare register (r[R3|1]) -- for odd R3 both
# are the same register, for even R3 they are the r[R3]/r[R3+1] pair.
# The original compare value is used even if it aliases R1 (read into
# a local before the write-back).
# ---------------------------------------------------------------------------

:bxh "bxh " RSd_R1 "," RSd_R3 "," RSd_D2 "(" RSd_B2 ")" is RSd_OP=0x86 & RSd_R1 & RSd_R3 & RSd_R3c & RSd_B2 & RSd_D2
{
    local ea:8;
    local inc:8;
    local cmp:8;
    local sum:8;
    ea_D12(ea, RSd_B2, zero, RSd_D2);
    inc = RSd_R3 & 0xffffffff;
    cmp = RSd_R3c & 0xffffffff;
    sum = ((RSd_R1 & 0xffffffff) + inc) & 0xffffffff;
    RSd_R1 = (RSd_R1 & (0xFFFFFFFF << 32)) | sum;
    if (sum s<= cmp) goto <bxh_skip>;
    goto [ea];
    <bxh_skip>
}

:bxle "bxle " RSd_R1 "," RSd_R3 "," RSd_D2 "(" RSd_B2 ")" is RSd_OP=0x87 & RSd_R1 & RSd_R3 & RSd_R3c & RSd_B2 & RSd_D2
{
    local ea:8;
    local inc:8;
    local cmp:8;
    local sum:8;
    ea_D12(ea, RSd_B2, zero, RSd_D2);
    inc = RSd_R3 & 0xffffffff;
    cmp = RSd_R3c & 0xffffffff;
    sum = ((RSd_R1 & 0xffffffff) + inc) & 0xffffffff;
    RSd_R1 = (RSd_R1 & (0xFFFFFFFF << 32)) | sum;
    if (sum s> cmp) goto <bxle_skip>;
    goto [ea];
    <bxle_skip>
}

# ---------------------------------------------------------------------------
# BRANCH ON INDEX HIGH (BXHG) / LOW OR EQUAL (BXLEG) — RSY format, 64-bit
# PoP 7-41. Opcodes 0xEB/0x44 and 0xEB/0x45. Same as BXH/BXLE but signed
# 64-bit operands and a 20-bit displacement EA.
# ---------------------------------------------------------------------------

:bxhg "bxhg " RSYd_R1 "," RSYd_R3 "," RSYd_DL2 "(" RSYd_B2 ")" is RSYd_OP=0xEB & RSYd_OP2=0x44 & RSYd_R1 & RSYd_R3 & RSYd_R3c & RSYd_B2 & RSYd_DL2 & RSYd_DH2
{
    local ea:8;
    local inc:8;
    local cmp:8;
    ea_D20(ea, RSYd_B2, zero, RSYd_DH2, RSYd_DL2);
    inc = RSYd_R3;
    cmp = RSYd_R3c;
    RSYd_R1 = RSYd_R1 + inc;
    if (RSYd_R1 s<= cmp) goto <bxhg_skip>;
    goto [ea];
    <bxhg_skip>
}

:bxleg "bxleg " RSYd_R1 "," RSYd_R3 "," RSYd_DL2 "(" RSYd_B2 ")" is RSYd_OP=0xEB & RSYd_OP2=0x45 & RSYd_R1 & RSYd_R3 & RSYd_R3c & RSYd_B2 & RSYd_DL2 & RSYd_DH2
{
    local ea:8;
    local inc:8;
    local cmp:8;
    ea_D20(ea, RSYd_B2, zero, RSYd_DH2, RSYd_DL2);
    inc = RSYd_R3;
    cmp = RSYd_R3c;
    RSYd_R1 = RSYd_R1 + inc;
    if (RSYd_R1 s> cmp) goto <bxleg_skip>;
    goto [ea];
    <bxleg_skip>
}

# ---------------------------------------------------------------------------
# BRANCH RELATIVE ON INDEX HIGH (BRXH) / LOW OR EQUAL (BRXLE) — RSI, 32-bit
# PoP 7-48. Opcodes 0x84/0x85. Same index semantics as BXH/BXLE; the
# target is inst_addr + 2*I2 (signed halfword count) via rel_RI16.
# ---------------------------------------------------------------------------

:brxh "brxh " RSId_R1 "," RSId_R3 "," RSId_Target is RSId_OP=0x84 & RSId_R1 & RSId_R3 & RSId_R3c & RSId_Target
{
    local inc:8;
    local cmp:8;
    local sum:8;
    inc = RSId_R3 & 0xffffffff;
    cmp = RSId_R3c & 0xffffffff;
    sum = ((RSId_R1 & 0xffffffff) + inc) & 0xffffffff;
    RSId_R1 = (RSId_R1 & (0xFFFFFFFF << 32)) | sum;
    if (sum s> cmp) goto RSId_Target;
}

:brxle "brxle " RSId_R1 "," RSId_R3 "," RSId_Target is RSId_OP=0x85 & RSId_R1 & RSId_R3 & RSId_R3c & RSId_Target
{
    local inc:8;
    local cmp:8;
    local sum:8;
    inc = RSId_R3 & 0xffffffff;
    cmp = RSId_R3c & 0xffffffff;
    sum = ((RSId_R1 & 0xffffffff) + inc) & 0xffffffff;
    RSId_R1 = (RSId_R1 & (0xFFFFFFFF << 32)) | sum;
    if (sum s<= cmp) goto RSId_Target;
}

# ---------------------------------------------------------------------------
# BRANCH RELATIVE ON INDEX HIGH (BRXHG) / LOW OR EQUAL (BRXLG) — RIEe, 64
# PoP 7-48. Opcodes 0xEC/0x44 and 0xEC/0x45. Same index semantics as
# BXHG/BXLEG; the target is inst_addr + 2*RI2 via rel_RI16.
# ---------------------------------------------------------------------------

:brxhg "brxhg " RIEd_R1 "," RIEd_R3 "," RIEd_Target is RIEd_OP=0xEC & RIEd_OP2=0x44 & RIEd_R1 & RIEd_R3 & RIEd_R3c & RIEd_Target & RIEd_IGN
{
    local inc:8;
    local cmp:8;
    inc = RIEd_R3;
    cmp = RIEd_R3c;
    RIEd_R1 = RIEd_R1 + inc;
    if (RIEd_R1 s> cmp) goto RIEd_Target;
}

:brxlg "brxlg " RIEd_R1 "," RIEd_R3 "," RIEd_Target is RIEd_OP=0xEC & RIEd_OP2=0x45 & RIEd_R1 & RIEd_R3 & RIEd_R3c & RIEd_Target & RIEd_IGN
{
    local inc:8;
    local cmp:8;
    inc = RIEd_R3;
    cmp = RIEd_R3c;
    RIEd_R1 = RIEd_R1 + inc;
    if (RIEd_R1 s<= cmp) goto RIEd_Target;
}

# ---------------------------------------------------------------------------
# Omissions (verified 2026-09-17 against PoP SA22-7832-14 and Capstone):
#  - JCT/JCTG/JCTH ("branch relative on count, 32/64/H"): NOT distinct
#    PoP instructions. The A7 extension slots 6/7 are BRCT/BRCTG;
#    Capstone decodes them as brct/brctg. No aliases provided.
#  - No other branch-on-count / branch-on-index forms exist in the PoP
#    (opcode tables App. A: 06, 46, 47, 84, 85, 86, 87, A7/6, A7/7,
#    B946, E3/46, EB/44, EB/45, EC/44, EC/45 are all covered above).
# ---------------------------------------------------------------------------
