# TROT: TRANSLATE ONE TO TWO (PoP 7-476). RRF-c format, M3=0 only:
# one-byte argument characters, two-byte function codes, 512-byte table
# at GR1 (treated as doubleword-aligned: ETF2-installed behavior; without
# ETF2 the table is 4K-aligned per PoP). R1/R1+1 = 64-bit destination
# address and second-operand length (argument bytes); R2 = 64-bit
# second-operand address. Function code at table + 2*argument, compared
# against GR0 bits 48-63 (M3=0, so the comparison is performed): equal ->
# CC=1 with nothing stored and no register update for the matching
# character, else the 2-byte code is stored at the destination (2 bytes
# per argument byte). Updates mirror TRTO with the destination advanced
# by 2 per argument byte. CC=3 approximated as run-to-completion. Odd R1:
# specification exception, modeled as a no-op. R1/R2 overlap: results
# unpredictable per PoP.
:TROT "TROT " RRFcn_R1 "," RRFcn_R2 is RRFcn_OP=0xB992 & RRFcn_M3=0 & RRFcn_R1 & RRFcn_R2 & RRFcn_R1N & RRFcn_R2N
{
    # TRANSLATE ONE TO TWO (PoP 7-476): 1-byte 2nd-operand chars select
    # 2-byte function chars from table at GR1.
    local r1v:8; local r2v:8;
    local da:8; local slen:8;
    local sa:8;
    local tbl:8;
    local i:8; local nch:8; local b:1; local fc:2; local tst:2;
    r1v = RRFcn_R1N; r2v = RRFcn_R2N;
    if ((r1v & 1) != 0) goto <trot_wend>;
    if (r1v == 0) goto <trot_r0>;
    if (r1v == 2) goto <trot_r2>;
    if (r1v == 4) goto <trot_r4>;
    if (r1v == 6) goto <trot_r6>;
    if (r1v == 8) goto <trot_r8>;
    if (r1v == 10) goto <trot_r10>;
    if (r1v == 12) goto <trot_r12>;
    goto <trot_r14>;
<trot_r0>
    da = r0; slen = r1;
    goto <trot_sa>;
<trot_r2>
    da = r2; slen = r3;
    goto <trot_sa>;
<trot_r4>
    da = r4; slen = r5;
    goto <trot_sa>;
<trot_r6>
    da = r6; slen = r7;
    goto <trot_sa>;
<trot_r8>
    da = r8; slen = r9;
    goto <trot_sa>;
<trot_r10>
    da = r10; slen = r11;
    goto <trot_sa>;
<trot_r12>
    da = r12; slen = r13;
    goto <trot_sa>;
<trot_r14>
    da = r14; slen = r15;
    goto <trot_sa>;
<trot_sa>
    if (r2v == 0) goto <trot_s0>;
    if (r2v == 1) goto <trot_s1>;
    if (r2v == 2) goto <trot_s2>;
    if (r2v == 3) goto <trot_s3>;
    if (r2v == 4) goto <trot_s4>;
    if (r2v == 5) goto <trot_s5>;
    if (r2v == 6) goto <trot_s6>;
    if (r2v == 7) goto <trot_s7>;
    if (r2v == 8) goto <trot_s8>;
    if (r2v == 9) goto <trot_s9>;
    if (r2v == 10) goto <trot_s10>;
    if (r2v == 11) goto <trot_s11>;
    if (r2v == 12) goto <trot_s12>;
    if (r2v == 13) goto <trot_s13>;
    if (r2v == 14) goto <trot_s14>;
    if (r2v == 15) goto <trot_s15>;
    goto <trot_sdone>;
<trot_s0>
    sa = r0;
    goto <trot_sdone>;
<trot_s1>
    sa = r1;
    goto <trot_sdone>;
<trot_s2>
    sa = r2;
    goto <trot_sdone>;
<trot_s3>
    sa = r3;
    goto <trot_sdone>;
<trot_s4>
    sa = r4;
    goto <trot_sdone>;
<trot_s5>
    sa = r5;
    goto <trot_sdone>;
<trot_s6>
    sa = r6;
    goto <trot_sdone>;
<trot_s7>
    sa = r7;
    goto <trot_sdone>;
<trot_s8>
    sa = r8;
    goto <trot_sdone>;
<trot_s9>
    sa = r9;
    goto <trot_sdone>;
<trot_s10>
    sa = r10;
    goto <trot_sdone>;
<trot_s11>
    sa = r11;
    goto <trot_sdone>;
<trot_s12>
    sa = r12;
    goto <trot_sdone>;
<trot_s13>
    sa = r13;
    goto <trot_sdone>;
<trot_s14>
    sa = r14;
    goto <trot_sdone>;
<trot_s15>
    sa = r15;
    goto <trot_sdone>;
<trot_sdone>
    tbl = r1 & 0xfffffffffffffff8;
    tst = r0:2;
    nch = slen;
    i = 0;
    cc = 0;
<trot_loop>
    if (i == nch) goto <trot_exh>;
    b = *:1 sa;
    fc = *:2 (tbl + (zext(b) << 1));
    if (fc == tst) goto <trot_match>;
    *:2 da = fc;
    sa = sa + 1; da = da + 2; i = i + 1;
    goto <trot_loop>;
<trot_match>
    # matching character: not stored, registers not advanced past it
    cc = 1;
    goto <trot_done>;
<trot_exh>
    cc = 0;
<trot_done>
    slen = slen - i * 1;
    # write back R2 source address, then R1 pair (dest addr, remaining len)
    if (r2v == 0) goto <trot_w2r0>;
    if (r2v == 1) goto <trot_w2r1>;
    if (r2v == 2) goto <trot_w2r2>;
    if (r2v == 3) goto <trot_w2r3>;
    if (r2v == 4) goto <trot_w2r4>;
    if (r2v == 5) goto <trot_w2r5>;
    if (r2v == 6) goto <trot_w2r6>;
    if (r2v == 7) goto <trot_w2r7>;
    if (r2v == 8) goto <trot_w2r8>;
    if (r2v == 9) goto <trot_w2r9>;
    if (r2v == 10) goto <trot_w2r10>;
    if (r2v == 11) goto <trot_w2r11>;
    if (r2v == 12) goto <trot_w2r12>;
    if (r2v == 13) goto <trot_w2r13>;
    if (r2v == 14) goto <trot_w2r14>;
    if (r2v == 15) goto <trot_w2r15>;
    goto <trot_w2done>;
<trot_w2r0>
    r0 = sa;
    goto <trot_w2done>;
<trot_w2r1>
    r1 = sa;
    goto <trot_w2done>;
<trot_w2r2>
    r2 = sa;
    goto <trot_w2done>;
<trot_w2r3>
    r3 = sa;
    goto <trot_w2done>;
<trot_w2r4>
    r4 = sa;
    goto <trot_w2done>;
<trot_w2r5>
    r5 = sa;
    goto <trot_w2done>;
<trot_w2r6>
    r6 = sa;
    goto <trot_w2done>;
<trot_w2r7>
    r7 = sa;
    goto <trot_w2done>;
<trot_w2r8>
    r8 = sa;
    goto <trot_w2done>;
<trot_w2r9>
    r9 = sa;
    goto <trot_w2done>;
<trot_w2r10>
    r10 = sa;
    goto <trot_w2done>;
<trot_w2r11>
    r11 = sa;
    goto <trot_w2done>;
<trot_w2r12>
    r12 = sa;
    goto <trot_w2done>;
<trot_w2r13>
    r13 = sa;
    goto <trot_w2done>;
<trot_w2r14>
    r14 = sa;
    goto <trot_w2done>;
<trot_w2r15>
    r15 = sa;
    goto <trot_w2done>;
<trot_w2done>
    if ((r1v & 1) != 0) goto <trot_wend>;
    if (r1v == 0) goto <trot_w0>;
    if (r1v == 2) goto <trot_w2>;
    if (r1v == 4) goto <trot_w4>;
    if (r1v == 6) goto <trot_w6>;
    if (r1v == 8) goto <trot_w8>;
    if (r1v == 10) goto <trot_w10>;
    if (r1v == 12) goto <trot_w12>;
    if (r1v == 14) goto <trot_w14>;
    goto <trot_wend>;
<trot_w0>
    r0 = da; r1 = slen;
    goto <trot_wend>;
<trot_w2>
    r2 = da; r3 = slen;
    goto <trot_wend>;
<trot_w4>
    r4 = da; r5 = slen;
    goto <trot_wend>;
<trot_w6>
    r6 = da; r7 = slen;
    goto <trot_wend>;
<trot_w8>
    r8 = da; r9 = slen;
    goto <trot_wend>;
<trot_w10>
    r10 = da; r11 = slen;
    goto <trot_wend>;
<trot_w12>
    r12 = da; r13 = slen;
    goto <trot_wend>;
<trot_w14>
    r14 = da; r15 = slen;
    goto <trot_wend>;
<trot_wend>
}

# TROO: TRANSLATE ONE TO ONE (PoP 7-476). RRF-c format, M3=0 only:
# one-byte argument characters, one-byte function codes, 256-byte table
# at GR1 (treated as doubleword-aligned: ETF2-installed behavior; without
# ETF2 the table is 4K-aligned per PoP). R1/R1+1 = 64-bit destination
# address and second-operand length (argument bytes); R2 = 64-bit
# second-operand address. Each selected function code is compared against
# the test character in GR0 bits 56-63 (M3=0, so the comparison is
# performed): equal -> CC=1 with nothing stored and no register update
# for the matching character; else the code is stored at the destination.
# CC=0 when the operand is exhausted. Updates: R1/R1+1 and R2 advanced
# past the processed bytes. CC=3 (CPU-determined partial completion)
# approximated as run-to-completion. Odd R1: specification exception,
# modeled as a no-op. R1/R2 overlap: results unpredictable per PoP.
:TROO "TROO " RRFcn_R1 "," RRFcn_R2 is RRFcn_OP=0xB993 & RRFcn_M3=0 & RRFcn_R1 & RRFcn_R2 & RRFcn_R1N & RRFcn_R2N
{
    # TRANSLATE ONE TO ONE (PoP 7-476): 1-byte 2nd-operand chars select
    # 1-byte function chars from table at GR1.
    local r1v:8; local r2v:8;
    local da:8; local slen:8;
    local sa:8;
    local tbl:8;
    local i:8; local b:1; local fc:1; local tst:1;
    r1v = RRFcn_R1N; r2v = RRFcn_R2N;
    # odd R1: specification exception, modeled as a no-op
    if ((r1v & 1) != 0) goto <troo_wend>;
    if (r1v == 0) goto <troo_r0>;
    if (r1v == 2) goto <troo_r2>;
    if (r1v == 4) goto <troo_r4>;
    if (r1v == 6) goto <troo_r6>;
    if (r1v == 8) goto <troo_r8>;
    if (r1v == 10) goto <troo_r10>;
    if (r1v == 12) goto <troo_r12>;
    goto <troo_r14>;
<troo_r0>
    da = r0; slen = r1;
    goto <troo_sa>;
<troo_r2>
    da = r2; slen = r3;
    goto <troo_sa>;
<troo_r4>
    da = r4; slen = r5;
    goto <troo_sa>;
<troo_r6>
    da = r6; slen = r7;
    goto <troo_sa>;
<troo_r8>
    da = r8; slen = r9;
    goto <troo_sa>;
<troo_r10>
    da = r10; slen = r11;
    goto <troo_sa>;
<troo_r12>
    da = r12; slen = r13;
    goto <troo_sa>;
<troo_r14>
    da = r14; slen = r15;
    goto <troo_sa>;
<troo_sa>
    if (r2v == 0) goto <troo_s0>;
    if (r2v == 1) goto <troo_s1>;
    if (r2v == 2) goto <troo_s2>;
    if (r2v == 3) goto <troo_s3>;
    if (r2v == 4) goto <troo_s4>;
    if (r2v == 5) goto <troo_s5>;
    if (r2v == 6) goto <troo_s6>;
    if (r2v == 7) goto <troo_s7>;
    if (r2v == 8) goto <troo_s8>;
    if (r2v == 9) goto <troo_s9>;
    if (r2v == 10) goto <troo_s10>;
    if (r2v == 11) goto <troo_s11>;
    if (r2v == 12) goto <troo_s12>;
    if (r2v == 13) goto <troo_s13>;
    if (r2v == 14) goto <troo_s14>;
    goto <troo_s15>;
<troo_s0>
    sa = r0;
    goto <troo_sdone>;
<troo_s1>
    sa = r1;
    goto <troo_sdone>;
<troo_s2>
    sa = r2;
    goto <troo_sdone>;
<troo_s3>
    sa = r3;
    goto <troo_sdone>;
<troo_s4>
    sa = r4;
    goto <troo_sdone>;
<troo_s5>
    sa = r5;
    goto <troo_sdone>;
<troo_s6>
    sa = r6;
    goto <troo_sdone>;
<troo_s7>
    sa = r7;
    goto <troo_sdone>;
<troo_s8>
    sa = r8;
    goto <troo_sdone>;
<troo_s9>
    sa = r9;
    goto <troo_sdone>;
<troo_s10>
    sa = r10;
    goto <troo_sdone>;
<troo_s11>
    sa = r11;
    goto <troo_sdone>;
<troo_s12>
    sa = r12;
    goto <troo_sdone>;
<troo_s13>
    sa = r13;
    goto <troo_sdone>;
<troo_s14>
    sa = r14;
    goto <troo_sdone>;
<troo_s15>
    sa = r15;
    goto <troo_sdone>;
<troo_sdone>
    # table treated as doubleword-aligned (ETF2-installed behavior)
    tbl = r1 & 0xfffffffffffffff8;
    tst = r0:1;
    i = 0;
    cc = 0;
<troo_loop>
    if (i == slen) goto <troo_exh>;
    b = *:1 sa;
    fc = *:1 (tbl + zext(b));
    if (fc == tst) goto <troo_match>;
    *:1 da = fc;
    sa = sa + 1; da = da + 1; i = i + 1;
    goto <troo_loop>;
<troo_match>
    # matching character: not stored, registers not advanced past it
    cc = 1;
    goto <troo_done>;
<troo_exh>
    cc = 0;
<troo_done>
    slen = slen - i;
    # write back R2 source address, then R1 pair (dest addr, remaining len)
    if (r2v == 0) goto <troo_w2r0>;
    if (r2v == 1) goto <troo_w2r1>;
    if (r2v == 2) goto <troo_w2r2>;
    if (r2v == 3) goto <troo_w2r3>;
    if (r2v == 4) goto <troo_w2r4>;
    if (r2v == 5) goto <troo_w2r5>;
    if (r2v == 6) goto <troo_w2r6>;
    if (r2v == 7) goto <troo_w2r7>;
    if (r2v == 8) goto <troo_w2r8>;
    if (r2v == 9) goto <troo_w2r9>;
    if (r2v == 10) goto <troo_w2r10>;
    if (r2v == 11) goto <troo_w2r11>;
    if (r2v == 12) goto <troo_w2r12>;
    if (r2v == 13) goto <troo_w2r13>;
    if (r2v == 14) goto <troo_w2r14>;
    goto <troo_w2r15>;
<troo_w2r0>
    r0 = sa;
    goto <troo_w2done>;
<troo_w2r1>
    r1 = sa;
    goto <troo_w2done>;
<troo_w2r2>
    r2 = sa;
    goto <troo_w2done>;
<troo_w2r3>
    r3 = sa;
    goto <troo_w2done>;
<troo_w2r4>
    r4 = sa;
    goto <troo_w2done>;
<troo_w2r5>
    r5 = sa;
    goto <troo_w2done>;
<troo_w2r6>
    r6 = sa;
    goto <troo_w2done>;
<troo_w2r7>
    r7 = sa;
    goto <troo_w2done>;
<troo_w2r8>
    r8 = sa;
    goto <troo_w2done>;
<troo_w2r9>
    r9 = sa;
    goto <troo_w2done>;
<troo_w2r10>
    r10 = sa;
    goto <troo_w2done>;
<troo_w2r11>
    r11 = sa;
    goto <troo_w2done>;
<troo_w2r12>
    r12 = sa;
    goto <troo_w2done>;
<troo_w2r13>
    r13 = sa;
    goto <troo_w2done>;
<troo_w2r14>
    r14 = sa;
    goto <troo_w2done>;
<troo_w2r15>
    r15 = sa;
    goto <troo_w2done>;
<troo_w2done>
    if ((r1v & 1) != 0) goto <troo_wend>;
    if (r1v == 0) goto <troo_w0>;
    if (r1v == 2) goto <troo_w2>;
    if (r1v == 4) goto <troo_w4>;
    if (r1v == 6) goto <troo_w6>;
    if (r1v == 8) goto <troo_w8>;
    if (r1v == 10) goto <troo_w10>;
    if (r1v == 12) goto <troo_w12>;
    goto <troo_w14>;
<troo_w0>
    r0 = da; r1 = slen;
    goto <troo_wend>;
<troo_w2>
    r2 = da; r3 = slen;
    goto <troo_wend>;
<troo_w4>
    r4 = da; r5 = slen;
    goto <troo_wend>;
<troo_w6>
    r6 = da; r7 = slen;
    goto <troo_wend>;
<troo_w8>
    r8 = da; r9 = slen;
    goto <troo_wend>;
<troo_w10>
    r10 = da; r11 = slen;
    goto <troo_wend>;
<troo_w12>
    r12 = da; r13 = slen;
    goto <troo_wend>;
<troo_w14>
    r14 = da; r15 = slen;
    goto <troo_wend>;
<troo_wend>
}

# CLCLE: COMPARE LOGICAL LONG EXTENDED (PoP 7-175). RS-a format.
# R1/R1+1 = 64-bit first-operand address/length (bytes); R3/R3+1 =
# 64-bit second-operand address/length; pad byte = bits 56-63 of D2(B2).
# Bytes compare until inequality or exhaustion; the shorter operand is
# then compared against the pad byte. CC: 0 = equal (including pad), 1 =
# first operand low, 2 = first operand high. Register updates per PoP:
# on inequality at byte i, addresses += i and lengths -= i; when the pad
# decides, the shorter length is set to zero. CC=3 (CPU-determined
# partial completion) is approximated as run-to-completion, as for TRE.
# Odd R1/R3: specification exception, modeled as a no-op. R1=R3: the
# pair is updated once (PoP programming note).
:CLCLE "CLCLE " RSan_R1 "," RSan_R3 "," RSan_D2 "(" RSan_B2 ")" is RSan_OP=0xA9 & RSan_R1 & RSan_R3 & RSan_B2 & RSan_D2 & RSan_R1N & RSan_R3N
{
    local r1v:8; local r3v:8;
    local ad1:8; local n1:8; local ad2:8; local n2:8;
    local ea2:8; local pad:8;
    local i:8; local b1:1; local b2:1;
    r1v = RSan_R1N; r3v = RSan_R3N;
    if ((r1v & 1) != 0) goto <clcle_end>;
    if ((r3v & 1) != 0) goto <clcle_end>;
    # R1 selects the first even/odd address/length pair
    if (r1v != 0) goto <clcle_a_p1>;
    ad1 = r0; n1 = r1;
    goto <clcle_q>;
<clcle_a_p1>
    if (r1v != 2) goto <clcle_a_p2>;
    ad1 = r2; n1 = r3;
    goto <clcle_q>;
<clcle_a_p2>
    if (r1v != 4) goto <clcle_a_p3>;
    ad1 = r4; n1 = r5;
    goto <clcle_q>;
<clcle_a_p3>
    if (r1v != 6) goto <clcle_a_p4>;
    ad1 = r6; n1 = r7;
    goto <clcle_q>;
<clcle_a_p4>
    if (r1v != 8) goto <clcle_a_p5>;
    ad1 = r8; n1 = r9;
    goto <clcle_q>;
<clcle_a_p5>
    if (r1v != 10) goto <clcle_a_p6>;
    ad1 = r10; n1 = r11;
    goto <clcle_q>;
<clcle_a_p6>
    if (r1v != 12) goto <clcle_a_p7>;
    ad1 = r12; n1 = r13;
    goto <clcle_q>;
<clcle_a_p7>
    ad1 = r14; n1 = r15;
<clcle_q>
    # R3 selects the second even/odd address/length pair
    if (r3v != 0) goto <clcle_b_p1>;
    ad2 = r0; n2 = r1;
    goto <clcle_go>;
<clcle_b_p1>
    if (r3v != 2) goto <clcle_b_p2>;
    ad2 = r2; n2 = r3;
    goto <clcle_go>;
<clcle_b_p2>
    if (r3v != 4) goto <clcle_b_p3>;
    ad2 = r4; n2 = r5;
    goto <clcle_go>;
<clcle_b_p3>
    if (r3v != 6) goto <clcle_b_p4>;
    ad2 = r6; n2 = r7;
    goto <clcle_go>;
<clcle_b_p4>
    if (r3v != 8) goto <clcle_b_p5>;
    ad2 = r8; n2 = r9;
    goto <clcle_go>;
<clcle_b_p5>
    if (r3v != 10) goto <clcle_b_p6>;
    ad2 = r10; n2 = r11;
    goto <clcle_go>;
<clcle_b_p6>
    if (r3v != 12) goto <clcle_b_p7>;
    ad2 = r12; n2 = r13;
    goto <clcle_go>;
<clcle_b_p7>
    ad2 = r14; n2 = r15;
<clcle_go>
    ea_D12(ea2, RSan_B2, zero, RSan_D2);
    pad = ea2 & 0xff;
    i = 0;
<clcle_l>
    if (i == n1) goto <clcle_n1d>;
    if (i == n2) goto <clcle_n2d>;
    b1 = *:1 (ad1 + i);
    b2 = *:1 (ad2 + i);
    if (b1 == b2) goto <clcle_eq>;
    if (b1 >= b2) goto <clcle_hi>;
    cc = 1;
    goto <clcle_upd>;
<clcle_hi>
    cc = 2;
    goto <clcle_upd>;
<clcle_eq>
    i = i + 1;
    goto <clcle_l>;
<clcle_n1d>
    # first operand exhausted
    if (n1 == n2) goto <clcle_equal>;
<clcle_p1>
    # compare pad against the second-operand tail
    if (i == n2) goto <clcle_equal>;
    b2 = *:1 (ad2 + i);
    if (zext(b2) == pad) goto <clcle_p1e>;
    if (pad >= zext(b2)) goto <clcle_p1h>;
    cc = 1;
    goto <clcle_upd1>;
<clcle_p1h>
    cc = 2;
    goto <clcle_upd1>;
<clcle_p1e>
    i = i + 1;
    goto <clcle_p1>;
<clcle_n2d>
<clcle_p2>
    # compare the first-operand tail against pad
    if (i == n1) goto <clcle_equal>;
    b1 = *:1 (ad1 + i);
    if (zext(b1) == pad) goto <clcle_p2e>;
    if (zext(b1) >= pad) goto <clcle_p2h>;
    cc = 1;
    goto <clcle_upd2>;
<clcle_p2h>
    cc = 2;
    goto <clcle_upd2>;
<clcle_p2e>
    i = i + 1;
    goto <clcle_p2>;
<clcle_equal>
    cc = 0;
    ad1 = ad1 + n1; n1 = 0;
    ad2 = ad2 + n2; n2 = 0;
    goto <clcle_wb>;
<clcle_upd>
    # inequality at byte i of the common part
    ad1 = ad1 + i; n1 = n1 - i;
    ad2 = ad2 + i; n2 = n2 - i;
    goto <clcle_wb>;
<clcle_upd1>
    # pad vs second-operand tail at index i: first operand fully
    # consumed, its (shorter) length goes to zero
    ad1 = ad1 + n1; n1 = 0;
    ad2 = ad2 + i; n2 = n2 - i;
    goto <clcle_wb>;
<clcle_upd2>
    # first-operand tail vs pad at index i: second operand fully
    # consumed, its (shorter) length goes to zero
    ad1 = ad1 + i; n1 = n1 - i;
    ad2 = ad2 + n2; n2 = 0;
    goto <clcle_wb>;
<clcle_wb>
    # write back; when R1=R3 the pair is updated only once
    if (r1v != 0) goto <clcle_a_w1>;
    r0 = ad1; r1 = n1;
    goto <clcle_wb2>;
<clcle_a_w1>
    if (r1v != 2) goto <clcle_a_w2>;
    r2 = ad1; r3 = n1;
    goto <clcle_wb2>;
<clcle_a_w2>
    if (r1v != 4) goto <clcle_a_w3>;
    r4 = ad1; r5 = n1;
    goto <clcle_wb2>;
<clcle_a_w3>
    if (r1v != 6) goto <clcle_a_w4>;
    r6 = ad1; r7 = n1;
    goto <clcle_wb2>;
<clcle_a_w4>
    if (r1v != 8) goto <clcle_a_w5>;
    r8 = ad1; r9 = n1;
    goto <clcle_wb2>;
<clcle_a_w5>
    if (r1v != 10) goto <clcle_a_w6>;
    r10 = ad1; r11 = n1;
    goto <clcle_wb2>;
<clcle_a_w6>
    if (r1v != 12) goto <clcle_a_w7>;
    r12 = ad1; r13 = n1;
    goto <clcle_wb2>;
<clcle_a_w7>
    r14 = ad1; r15 = n1;
<clcle_wb2>
    if (r1v == r3v) goto <clcle_end>;
    if (r3v != 0) goto <clcle_b_w1>;
    r0 = ad2; r1 = n2;
    goto <clcle_end>;
<clcle_b_w1>
    if (r3v != 2) goto <clcle_b_w2>;
    r2 = ad2; r3 = n2;
    goto <clcle_end>;
<clcle_b_w2>
    if (r3v != 4) goto <clcle_b_w3>;
    r4 = ad2; r5 = n2;
    goto <clcle_end>;
<clcle_b_w3>
    if (r3v != 6) goto <clcle_b_w4>;
    r6 = ad2; r7 = n2;
    goto <clcle_end>;
<clcle_b_w4>
    if (r3v != 8) goto <clcle_b_w5>;
    r8 = ad2; r9 = n2;
    goto <clcle_end>;
<clcle_b_w5>
    if (r3v != 10) goto <clcle_b_w6>;
    r10 = ad2; r11 = n2;
    goto <clcle_end>;
<clcle_b_w6>
    if (r3v != 12) goto <clcle_b_w7>;
    r12 = ad2; r13 = n2;
    goto <clcle_end>;
<clcle_b_w7>
    r14 = ad2; r15 = n2;
<clcle_end>
}

# CLCLU: COMPARE LOGICAL LONG UNICODE (PoP 7-176). RSY-a format.
# R1/R1+1 = 64-bit first-operand address/length (bytes, even); R3/R3+1 =
# 64-bit second-operand address/length (bytes, even); pad = bits 48-63 of
# D2(B2) (two bytes). Two-byte units compare until inequality or
# exhaustion; the shorter operand is then compared against the pad. CC:
# 0 = equal (including pad), 1 = first low, 2 = first high. Register
# updates per PoP: on inequality at unit i (byte offset), addresses +=
# byte offset and lengths -= byte offset; when the pad decides, the
# shorter length is set to zero. CC=3 (CPU-determined partial
# completion) approximated as run-to-completion, as for TRE. Odd R1/R3
# or odd length: specification exception, modeled as a no-op. R1=R3:
# the pair is updated once (PoP programming note).
# Display shows DL2 only (core RSY convention); the harness maps it to
# the full 20-bit displacement when comparing against Capstone.
:CLCLU "CLCLU " RSYan_R1 "," RSYan_R3 "," RSYan_DL2 "(" RSYan_B2 ")" is RSYan_OP=0xEB & RSYan_R1 & RSYan_R3 & RSYan_B2 & RSYan_DL2 & RSYan_DH2 & RSYan_OP2=0x8F & RSYan_R1N & RSYan_R3N
{
    local r1v:8; local r3v:8;
    local ad1:8; local n1:8; local ad2:8; local n2:8;
    local ea2:8; local pad:8;
    local i:8; local w1:2; local w2:2;
    r1v = RSYan_R1N; r3v = RSYan_R3N;
    if ((r1v & 1) != 0) goto <clclu_end>;
    if ((r3v & 1) != 0) goto <clclu_end>;
    # R1 selects the first even/odd address/length pair
    if (r1v != 0) goto <clclu_a_p1>;
    ad1 = r0; n1 = r1;
    goto <clclu_q>;
<clclu_a_p1>
    if (r1v != 2) goto <clclu_a_p2>;
    ad1 = r2; n1 = r3;
    goto <clclu_q>;
<clclu_a_p2>
    if (r1v != 4) goto <clclu_a_p3>;
    ad1 = r4; n1 = r5;
    goto <clclu_q>;
<clclu_a_p3>
    if (r1v != 6) goto <clclu_a_p4>;
    ad1 = r6; n1 = r7;
    goto <clclu_q>;
<clclu_a_p4>
    if (r1v != 8) goto <clclu_a_p5>;
    ad1 = r8; n1 = r9;
    goto <clclu_q>;
<clclu_a_p5>
    if (r1v != 10) goto <clclu_a_p6>;
    ad1 = r10; n1 = r11;
    goto <clclu_q>;
<clclu_a_p6>
    if (r1v != 12) goto <clclu_a_p7>;
    ad1 = r12; n1 = r13;
    goto <clclu_q>;
<clclu_a_p7>
    ad1 = r14; n1 = r15;
<clclu_q>
    # R3 selects the second even/odd address/length pair
    if (r3v != 0) goto <clclu_b_p1>;
    ad2 = r0; n2 = r1;
    goto <clclu_go>;
<clclu_b_p1>
    if (r3v != 2) goto <clclu_b_p2>;
    ad2 = r2; n2 = r3;
    goto <clclu_go>;
<clclu_b_p2>
    if (r3v != 4) goto <clclu_b_p3>;
    ad2 = r4; n2 = r5;
    goto <clclu_go>;
<clclu_b_p3>
    if (r3v != 6) goto <clclu_b_p4>;
    ad2 = r6; n2 = r7;
    goto <clclu_go>;
<clclu_b_p4>
    if (r3v != 8) goto <clclu_b_p5>;
    ad2 = r8; n2 = r9;
    goto <clclu_go>;
<clclu_b_p5>
    if (r3v != 10) goto <clclu_b_p6>;
    ad2 = r10; n2 = r11;
    goto <clclu_go>;
<clclu_b_p6>
    if (r3v != 12) goto <clclu_b_p7>;
    ad2 = r12; n2 = r13;
    goto <clclu_go>;
<clclu_b_p7>
    ad2 = r14; n2 = r15;
<clclu_go>
    if ((n1 & 1) != 0) goto <clclu_end>;
    if ((n2 & 1) != 0) goto <clclu_end>;
    ea_D20(ea2, RSYan_B2, zero, RSYan_DH2, RSYan_DL2);
    pad = ea2 & 0xffff;
    i = 0;
<clclu_l>
    if (i == n1) goto <clclu_n1d>;
    if (i == n2) goto <clclu_n2d>;
    w1 = *:2 (ad1 + i);
    w2 = *:2 (ad2 + i);
    if (w1 == w2) goto <clclu_eq>;
    if (w1 >= w2) goto <clclu_hi>;
    cc = 1;
    goto <clclu_upd>;
<clclu_hi>
    cc = 2;
    goto <clclu_upd>;
<clclu_eq>
    i = i + 2;
    goto <clclu_l>;
<clclu_n1d>
    # first operand exhausted
    if (n1 == n2) goto <clclu_equal>;
<clclu_p1>
    # compare pad against the second-operand tail
    if (i == n2) goto <clclu_equal>;
    w2 = *:2 (ad2 + i);
    if (zext(w2) == pad) goto <clclu_p1e>;
    if (pad >= zext(w2)) goto <clclu_p1h>;
    cc = 1;
    goto <clclu_upd1>;
<clclu_p1h>
    cc = 2;
    goto <clclu_upd1>;
<clclu_p1e>
    i = i + 2;
    goto <clclu_p1>;
<clclu_n2d>
<clclu_p2>
    # compare the first-operand tail against pad
    if (i == n1) goto <clclu_equal>;
    w1 = *:2 (ad1 + i);
    if (zext(w1) == pad) goto <clclu_p2e>;
    if (zext(w1) >= pad) goto <clclu_p2h>;
    cc = 1;
    goto <clclu_upd2>;
<clclu_p2h>
    cc = 2;
    goto <clclu_upd2>;
<clclu_p2e>
    i = i + 2;
    goto <clclu_p2>;
<clclu_equal>
    cc = 0;
    ad1 = ad1 + n1; n1 = 0;
    ad2 = ad2 + n2; n2 = 0;
    goto <clclu_wb>;
<clclu_upd>
    # inequality at byte offset i of the common part
    ad1 = ad1 + i; n1 = n1 - i;
    ad2 = ad2 + i; n2 = n2 - i;
    goto <clclu_wb>;
<clclu_upd1>
    # pad vs second-operand tail at byte offset i: first operand fully
    # consumed, its (shorter) length goes to zero
    ad1 = ad1 + n1; n1 = 0;
    ad2 = ad2 + i; n2 = n2 - i;
    goto <clclu_wb>;
<clclu_upd2>
    # first-operand tail vs pad at byte offset i: second operand fully
    # consumed, its (shorter) length goes to zero
    ad1 = ad1 + i; n1 = n1 - i;
    ad2 = ad2 + n2; n2 = 0;
    goto <clclu_wb>;
<clclu_wb>
    # write back; when R1=R3 the pair is updated only once
    if (r1v != 0) goto <clclu_a_w1>;
    r0 = ad1; r1 = n1;
    goto <clclu_wb2>;
<clclu_a_w1>
    if (r1v != 2) goto <clclu_a_w2>;
    r2 = ad1; r3 = n1;
    goto <clclu_wb2>;
<clclu_a_w2>
    if (r1v != 4) goto <clclu_a_w3>;
    r4 = ad1; r5 = n1;
    goto <clclu_wb2>;
<clclu_a_w3>
    if (r1v != 6) goto <clclu_a_w4>;
    r6 = ad1; r7 = n1;
    goto <clclu_wb2>;
<clclu_a_w4>
    if (r1v != 8) goto <clclu_a_w5>;
    r8 = ad1; r9 = n1;
    goto <clclu_wb2>;
<clclu_a_w5>
    if (r1v != 10) goto <clclu_a_w6>;
    r10 = ad1; r11 = n1;
    goto <clclu_wb2>;
<clclu_a_w6>
    if (r1v != 12) goto <clclu_a_w7>;
    r12 = ad1; r13 = n1;
    goto <clclu_wb2>;
<clclu_a_w7>
    r14 = ad1; r15 = n1;
<clclu_wb2>
    if (r1v == r3v) goto <clclu_end>;
    if (r3v != 0) goto <clclu_b_w1>;
    r0 = ad2; r1 = n2;
    goto <clclu_end>;
<clclu_b_w1>
    if (r3v != 2) goto <clclu_b_w2>;
    r2 = ad2; r3 = n2;
    goto <clclu_end>;
<clclu_b_w2>
    if (r3v != 4) goto <clclu_b_w3>;
    r4 = ad2; r5 = n2;
    goto <clclu_end>;
<clclu_b_w3>
    if (r3v != 6) goto <clclu_b_w4>;
    r6 = ad2; r7 = n2;
    goto <clclu_end>;
<clclu_b_w4>
    if (r3v != 8) goto <clclu_b_w5>;
    r8 = ad2; r9 = n2;
    goto <clclu_end>;
<clclu_b_w5>
    if (r3v != 10) goto <clclu_b_w6>;
    r10 = ad2; r11 = n2;
    goto <clclu_end>;
<clclu_b_w6>
    if (r3v != 12) goto <clclu_b_w7>;
    r12 = ad2; r13 = n2;
    goto <clclu_end>;
<clclu_b_w7>
    r14 = ad2; r15 = n2;
<clclu_end>
}

