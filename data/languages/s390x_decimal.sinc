<trto_w2r13>
    r13 = sa;
    goto <trto_w2done>;
<trto_w2r14>
    r14 = sa;
    goto <trto_w2done>;
<trto_w2r15>
    r15 = sa;
    goto <trto_w2done>;
<trto_w2done>
    if ((r1v & 1) != 0) goto <trto_wend>;
    if (r1v == 0) goto <trto_w0>;
    if (r1v == 2) goto <trto_w2>;
    if (r1v == 4) goto <trto_w4>;
    if (r1v == 6) goto <trto_w6>;
    if (r1v == 8) goto <trto_w8>;
    if (r1v == 10) goto <trto_w10>;
    if (r1v == 12) goto <trto_w12>;
    if (r1v == 14) goto <trto_w14>;
    goto <trto_wend>;
